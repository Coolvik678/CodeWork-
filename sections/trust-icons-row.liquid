<div class="section"><style>
  .trust-icons-row-trust-icons-rowvouert {
    display: block;
    width: 100%;
    background: var(--color-background);
    padding-top: calc(50px * var(--section-spacing-scale, 1));
    padding-bottom: calc(50px * var(--section-spacing-scale, 1));
  }

  .trust-icons-row-container-trust-icons-rowvouert {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .trust-icons-row-grid-trust-icons-rowvouert {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }

  .trust-icons-row-item-trust-icons-rowvouert {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .trust-icons-row-item-trust-icons-rowvouert:hover {
    transform: translateY(-5px);
  }

  .trust-icons-row-wrapper-trust-icons-rowvouert {
    position: relative;
    margin-bottom: 20px;
  }

  .trust-icons-row-circle-trust-icons-rowvouert {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background-color: var(--color-card-background);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .trust-icons-row-item-trust-icons-rowvouert:hover .trust-icons-row-circle-trust-icons-rowvouert svg {
    transform: scale(1.05);
  }

  .trust-icons-row-circle-trust-icons-rowvouert svg {
    width: calc(120px * 0.5);
    height: calc(120px * 0.5);
    color: var(--color-primary);
    transition: transform 0.3s ease;
  }

  
  .trust-icons-row-circle-trust-icons-rowvouert svg {
    stroke: url(#tir-icon-grad-trust-icons-rowvouert);
  }
  

  
    .trust-icons-row-border-trust-icons-rowvouert {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: calc(120px + 16px);
      height: calc(120px + 16px);
      border-radius: 50%;
      border: 2px dashed var(--color-primary);
      z-index: 0;
    }
  

  .trust-icons-row-title-trust-icons-rowvouert {
    font-family: var(--font-heading--family), sans-serif;
    font-size: 18px;
    color: var(--color-foreground);
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .trust-icons-row-description-trust-icons-rowvouert {
    font-family: var(--font-body--family), sans-serif;
    font-size: 14px;
    color: var(--color-foreground);
    margin: 0;
    line-height: 1.5;
  }

  .trust-icons-row-link-trust-icons-rowvouert {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .trust-icons-row-single-trust-icons-rowvouert {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .trust-icons-row-grid-trust-icons-rowvouert {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media screen and (max-width: 749px) {
    .trust-icons-row-grid-trust-icons-rowvouert {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .trust-icons-row-trust-icons-rowvouert {
      padding-top: calc(35px * var(--section-spacing-scale, 1));
      padding-bottom: calc(35px * var(--section-spacing-scale, 1));
    }
  }
</style>

<svg width="0" height="0" style="position:absolute;overflow:hidden" aria-hidden="true">
    <defs>
      <lineargradient id="tir-icon-grad-trust-icons-rowvouert" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#888888"></stop>
        <stop offset="50%" stop-color="#555555"></stop>
        <stop offset="100%" stop-color="#222222"></stop>
      </lineargradient>
    </defs>
  </svg>


<forge-trust-icons-row class="trust-icons-row-trust-icons-rowvouert forge-color-scheme-1" data-section-id="trust-icons-row_vouert">
  <div class="trust-icons-row-container-trust-icons-rowvouert">
    <div class="trust-icons-row-grid-trust-icons-rowvouert" data-animate-group="">
      <div class="trust-icons-row-item-trust-icons-rowvouert trust-icons-row-single-trust-icons-rowvouert" data-animate="fade-up" style="--anim-child-index: 0;">
        

        <div class="trust-icons-row-wrapper-trust-icons-rowvouert">
          
            <div class="trust-icons-row-border-trust-icons-rowvouert"></div>
          
          <div class="trust-icons-row-circle-trust-icons-rowvouert">
            
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6L9 17l-5-5"></path>
              </svg>
            
          </div>
        </div>

        
          <h3 class="trust-icons-row-title-trust-icons-rowvouert" data-trust-icon-title="">Built to Last</h3>
        

        
          <p class="trust-icons-row-description-trust-icons-rowvouert">Stainless steel and solid wood</p>
        

        
      </div>

      <div class="trust-icons-row-item-trust-icons-rowvouert trust-icons-row-single-trust-icons-rowvouert" data-animate="fade-up" style="--anim-child-index: 1;">
        

        <div class="trust-icons-row-wrapper-trust-icons-rowvouert">
          
            <div class="trust-icons-row-border-trust-icons-rowvouert"></div>
          
          <div class="trust-icons-row-circle-trust-icons-rowvouert">
            
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            
          </div>
        </div>

        
          <h3 class="trust-icons-row-title-trust-icons-rowvouert" data-trust-icon-title="">Fast Dispatch</h3>
        

        
          <p class="trust-icons-row-description-trust-icons-rowvouert">Ready for your next ritual</p>
        

        
      </div>

      <div class="trust-icons-row-item-trust-icons-rowvouert trust-icons-row-single-trust-icons-rowvouert" data-animate="fade-up" style="--anim-child-index: 2;">
        

        <div class="trust-icons-row-wrapper-trust-icons-rowvouert">
          
            <div class="trust-icons-row-border-trust-icons-rowvouert"></div>
          
          <div class="trust-icons-row-circle-trust-icons-rowvouert">
            
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            
          </div>
        </div>

        
          <h3 class="trust-icons-row-title-trust-icons-rowvouert" data-trust-icon-title="">Tradition First</h3>
        

        
          <p class="trust-icons-row-description-trust-icons-rowvouert">Modern tools, sacred roots</p>
        

        
      </div>

      <div class="trust-icons-row-item-trust-icons-rowvouert trust-icons-row-single-trust-icons-rowvouert" data-animate="fade-up" style="--anim-child-index: 3;">
        

        <div class="trust-icons-row-wrapper-trust-icons-rowvouert">
          
            <div class="trust-icons-row-border-trust-icons-rowvouert"></div>
          
          <div class="trust-icons-row-circle-trust-icons-rowvouert">
            
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            
          </div>
        </div>

        
          <h3 class="trust-icons-row-title-trust-icons-rowvouert" data-trust-icon-title="">Simple Returns</h3>
        

        
          <p class="trust-icons-row-description-trust-icons-rowvouert">30 day peace of mind</p>
        

        
      </div>
    </div>
  </div>
</forge-trust-icons-row>

<script>
  (function() {
    if (customElements.get('forge-trust-icons-row')) return;

    class TrustIconsRow extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const links = this.querySelectorAll('[data-trust-icon-link]');
        links.forEach(link => {
          if (!link.getAttribute('aria-label')) {
            const title = link.querySelector('[data-trust-icon-title]');
            if (title) {
              link.setAttribute('aria-label', title.textContent.trim());
            }
          }
        });
      }
    }

    customElements.define('forge-trust-icons-row', TrustIconsRow);
  })();
</script>


</div>

