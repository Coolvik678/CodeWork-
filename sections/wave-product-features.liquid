    .wave-product-features-wave-product-features_j4oazj .wave-product-features__subtext p:last-child{ margin-bottom: 0; }
  
    /* =========================================================
       Benefit boxes (FAQ-style)
       ========================================================= */
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__benefits{
