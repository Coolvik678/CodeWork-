</newsletter-signup-newsletter-signup-g88sts>

<script>
  (function() {
    class NewsletterSignupnewslettersignupg88sts extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        if (this.form) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        const emailInput = this.form.querySelector('input[type="email"]');
        if (emailInput && !emailInput.value) {
          event.preventDefault();
        }
      }
    }

    customElements.define('newsletter-signup-newsletter-signup-g88sts', NewsletterSignupnewslettersignupg88sts);
  })();
</script>



