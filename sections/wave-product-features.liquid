      .wave-product-features-wave-product-features_j4oazj .wave-product-features__image-wrapper {
        border-right: none;
      }
    

    /* =========================================================
       Layout
       ========================================================= */
    .wave-product-features-wave-product-features_j4oazj.wave-product-features{
      padding: calc(72px * var(--section-spacing-scale, 1)) 0 calc(72px * var(--section-spacing-scale, 1));
      background: rgb(var(--color-background-rgb));
    }
  
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__container{
      width: 100%;
    }
  
    /* The "card" wrapper (this is where the huge shadow used to feel heavy) */
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__grid{
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: stretch;
  
      background: var(--hp-card-bg);
      border: 1px solid var(--hp-card-border);
      border-radius: var(--hp-radius);
  
      /* Controlled shadow (set to none by default in schema) */
      box-shadow: var(--hp-card-shadow);
  
      overflow: hidden; /* keeps everything clean */
    }
  
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__grid--right .wave-product-features__image-wrapper{ order: 2; }
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__grid--right .wave-product-features__content{ order: 1; }
  
    /* Image side */
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__image-wrapper{
      position: relative;
      width: 100%;
      overflow: hidden;
      border-right: 1px solid rgba(2, 6, 23, 0.06);
    }
  
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__image{
