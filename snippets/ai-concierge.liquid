      }

      // 6. BUNDLE / OFFERS / DISCOUNTS / COMBO / PRICING TIERS
      if (hasAny('bundle', 'combo', 'offer', 'offers', 'deal', 'deals', 'discount', 'discounts', 'coupon', 'promo', 'code', 'buy 2', 'buy 3', 'saving', 'savings', 'best offer', 'best deal', 'cheap')) {
        CONTEXT.lastTopic = 'bundle';
        return {
          text: `🎉 <strong>Exclusive Zenkart Value Bundles:</strong><br><br>
          <strong>🕉️ Wooden Digital Jaap Counter:</strong><br>
          • Buy 1: ₹499<br>
          • Buy 2: <strong>₹899</strong> (🔥 <em>Most Bought &amp; Best Option — Save ₹99</em>)<br>
