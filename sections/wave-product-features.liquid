      border-radius: var(--style-border-radius-global);
  
      padding: 14px 16px;
    }
  
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__benefit-icon{
      flex-shrink: 0;
      width: 22px;
      height: 22px;
      display: grid;
      place-items: center;
      color: var(--hp-blue-1);
    }
  
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__benefit-icon svg{
      width: 100%;
      height: 100%;
