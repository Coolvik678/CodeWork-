<section id="jaap-counter" class="py-24 px-6 border-b border-border-dim max-w-7xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    
    <!-- Details Column (Left) -->
    <div class="order-2 lg:order-1" data-reveal>
      <span class="eyebrow block mb-2">Devotional & Meditation</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-bone mb-4">
        Wooden Digital Mantra Jaap Counter With Compass
      </h2>
      
      <div class="flex items-baseline gap-4 mb-6">
        <span class="text-3xl sm:text-4xl font-bold text-bone">₹499</span>
        <span class="text-lg line-through text-bone-muted/50">₹799</span>
        <span class="text-xs font-semibold text-amber bg-amber/10 px-3 py-1 rounded-full border border-amber/20">Save 38%</span>
      </div>

      <p class="text-sm text-bone-muted leading-relaxed mb-8">
        Handheld electronic counter with silent scroll wheel and built-in prayer direction compass. Features a high-contrast LCD screen, natural wood-grain contour, and sacred silk tassel.
      </p>

      <!-- Glass Specs Table -->
      <div class="card-glass rounded-xl p-5 mb-8 text-xs divide-y divide-border-dim" data-reveal>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Display</span><span class="font-medium text-bone">5-Digit Digital LCD Screen</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Count Range</span><span class="font-medium text-bone">1 to 99,999 Chants (Reset Button)</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Compass</span><span class="font-medium text-bone">Integrated Direction Alignment</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Finish</span><span class="font-medium text-bone">Natural Wood Grain with Sacred Tassel</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Power</span><span class="font-medium text-bone">Pre-Installed Long-Life Battery</span></div>
      </div>

      <button onclick="ZenkartCart.add('jaap-counter', 'Wooden Digital Jaap Counter With Compass', 499)" class="w-full bg-amber hover:bg-amber-lit text-black font-semibold text-sm py-4 rounded-full transition-all duration-200 hover:-translate-y-0.5 shadow-xl flex items-center justify-center gap-2">
        <span>Order Jaap Counter — ₹499</span>
      </button>
      <p class="text-[11px] text-center text-bone-muted mt-3">Free Express Shipping • Cash on Delivery available at checkout</p>
    </div>

    <!-- Dramatic Visual Stage (Right) -->
    <div class="order-1 lg:order-2 card-glass card-glow rounded-2xl p-8 lg:p-12 text-center relative overflow-hidden flex flex-col justify-between min-h-[500px]" data-reveal>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber/20 via-transparent to-transparent pointer-events-none"></div>
      
      <div class="flex justify-between items-center w-full relative z-10">
        <span class="text-[11px] uppercase tracking-widest font-semibold text-amber">Devotional Craft</span>
        <span class="bg-amber/15 text-amber border border-amber/30 text-[11px] font-bold px-3 py-1 rounded-full uppercase">Save 38%</span>
      </div>
      
      <div class="my-auto py-8 relative z-10 flex flex-col items-center">
        <div class="relative w-full h-72 md:h-96 rounded-xl overflow-hidden border border-border-dim group bg-ink mb-6">
          <img 
            src="{{ 'jaap-counter.jpg' | asset_url }}" 
            alt="Wooden Digital Mantra Jaap Counter With Compass" 
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            loading="lazy">
          <div class="absolute inset-0 bg-gradient-to-t from-ink-card via-transparent to-transparent opacity-60"></div>
        </div>
        <h3 class="text-2xl font-serif font-bold text-bone">Wooden Digital Mantra Jaap Counter</h3>
        <p class="text-xs text-bone-muted mt-2">Silent Scroll Roller • Direction Compass • Handcrafted Finish</p>
      </div>

      <div class="text-[11px] text-bone-muted/60 tracking-widest uppercase relative z-10">
        Model: ZK-JC-05 • Domestic Certified
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product: Jaap Counter",
  "settings": []
}
{% endschema %}
