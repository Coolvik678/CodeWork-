<!-- snippets/ai-concierge.liquid -->
<div id="zenkart-ai-wrapper" class="fixed bottom-6 right-6 z-40 select-none font-sans">
  <!-- Floating Launcher Button -->
  <button 
    id="zenkart-ai-launcher" 
    type="button" 
    onclick="toggleZenkartAiChat()" 
    class="flex items-center gap-2.5 bg-[#121212]/90 hover:bg-[#1f1f1f] border border-white/20 hover:border-white/50 text-white px-4 py-3 rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.6)] backdrop-blur-md transition-all duration-300 hover:scale-105 group">
    <span class="relative flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
    </span>
    <span class="text-xs font-semibold tracking-wide flex items-center gap-1.5">
      <span class="text-white/80">✨</span>
      <span>Zenkart AI Concierge</span>
    </span>
  </button>

  <!-- Chat Drawer / Window -->
  <div 
    id="zenkart-ai-window" 
    class="hidden opacity-0 translate-y-6 transition-all duration-300 fixed bottom-20 right-6 w-[92vw] sm:w-[380px] max-h-[580px] h-[78vh] bg-[#0c0c0c]/95 border border-[#262626] rounded-2xl shadow-2xl backdrop-blur-xl flex flex-col overflow-hidden text-xs text-[#eee]">
    
    <!-- Header -->
    <div class="px-5 py-4 border-b border-[#222] bg-black/60 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-white/10 border border-white/20 flex items-center justify-center text-sm">
          ✨
        </div>
        <div>
          <div class="font-serif font-bold text-white text-sm flex items-center gap-1.5">
            Zenkart Concierge
            <span class="text-[9px] bg-emerald-950 border border-emerald-800 text-emerald-400 font-sans font-bold px-1.5 py-0.2 rounded-full">AI ACTIVE</span>
          </div>
          <div class="text-[10px] text-white/50">Instant Answers &amp; Order Assistance</div>
        </div>
      </div>
      <button 
        type="button" 
        onclick="toggleZenkartAiChat()" 
        class="text-white/60 hover:text-white p-1.5 text-base transition">
        ✕
      </button>
    </div>

    <!-- Messages Container -->
    <div id="zenkart-ai-messages" class="flex-1 overflow-y-auto p-4 space-y-3.5 leading-relaxed">
      <!-- AI Welcome Message -->
      <div class="flex items-start gap-2.5">
        <div class="w-6 h-6 rounded-full bg-white/10 text-[11px] flex items-center justify-center flex-shrink-0 mt-0.5">✨</div>
        <div class="bg-[#161616] border border-[#2a2a2a] p-3.5 rounded-2xl rounded-tl-sm max-w-[85%] text-white/90 space-y-2">
          <p>Namaste! I am your <strong>Zenkart AI Concierge</strong>. How can I assist your mindful living and kitchen rituals today?</p>
          <div class="text-[10px] text-white/50 pt-1 border-t border-[#222]">
            Ask me about our Jaap counter, Puri press, Cash on Delivery terms, or express delivery timelines.
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Prompt Pills -->
    <div id="zenkart-ai-quick-pills" class="px-3 py-2 border-t border-[#1c1c1c] bg-black/40 flex gap-1.5 overflow-x-auto no-scrollbar whitespace-nowrap text-[11px]">
      <button onclick="sendQuickPrompt('How does the Jaap counter work?')" class="bg-[#181818] hover:bg-[#222] border border-[#2a2a2a] text-white/80 px-2.5 py-1 rounded-full transition flex-shrink-0">
        📿 Jaap Counter
      </button>
      <button onclick="sendQuickPrompt('Tell me about the Puri Press')" class="bg-[#181818] hover:bg-[#222] border border-[#2a2a2a] text-white/80 px-2.5 py-1 rounded-full transition flex-shrink-0">
        🥟 Puri Press
      </button>
      <button onclick="sendQuickPrompt('What are your COD and shipping terms?')" class="bg-[#181818] hover:bg-[#222] border border-[#2a2a2a] text-white/80 px-2.5 py-1 rounded-full transition flex-shrink-0">
        🚚 Free COD Delivery
      </button>
      <button onclick="sendQuickPrompt('What is the replacement policy?')" class="bg-[#181818] hover:bg-[#222] border border-[#2a2a2a] text-white/80 px-2.5 py-1 rounded-full transition flex-shrink-0">
        🔄 7-Day Guarantee
      </button>
    </div>

    <!-- Chat Input Form -->
    <form id="zenkart-ai-form" onsubmit="handleUserMessage(event)" class="p-3 border-t border-[#222] bg-black flex items-center gap-2">
      <input 
        id="zenkart-ai-input" 
        type="text" 
        autocomplete="off" 
        placeholder="Type a question (e.g. Is COD available?)..." 
        class="flex-1 bg-[#141414] border border-[#2a2a2a] rounded-xl px-3.5 py-2.5 text-xs text-white placeholder:text-white/30 focus:outline-none focus:border-white transition">
      <button 
        type="submit" 
        class="bg-white hover:bg-neutral-200 text-black font-bold px-3.5 py-2.5 rounded-xl transition shadow flex items-center justify-center">
        ➔
      </button>
    </form>

  </div>
</div>

<script>
  (function(){
    const KNOWLEDGE_BASE = [
      {
        keywords: ['tasbih', 'jaap', 'counter', 'mantra', 'bead', 'zikr', 'compass', 'tassel', 'finger', 'scroll', 'wood'],
        reply: "The <strong>Wooden Digital Jaap Counter</strong> (₹499) features an LCD screen supporting 0 to 99,999 chants, a silent tactile roller wheel, a 360° prayer alignment compass, and a sacred red ceremonial silk tassel. Pre-installed long-life button battery included.",
        productCard: {
          title: "Wooden Digital Jaap Counter",
          price: "₹499",
          handle: "wooden-digital-tasbih-counter-handheld-lcd-mantra-jaap-counter-with-compass-1-pc",
          sku: "22223_digital_tasbih_counter_1pc"
        }
      },
      {
        keywords: ['puri', 'press', 'roti', 'chapati', 'khakhra', 'papad', 'steel', 'machine', 'kitchen', 'rolling'],
        reply: "The <strong>Stainless Steel Puri & Khakhra Press Maker</strong> (₹599) is crafted from heavy-gauge food-grade SUS-304 stainless steel with a 6.5-inch mirror-polished plate, silicone non-slip rubber base, and ergonomic leverage handle. Cuts preparation from 25 minutes to under 5 minutes.",
        productCard: {
          title: "Stainless Steel Puri & Khakhra Press",
          price: "₹599",
          handle: "7149a-puri-press-maker-stainless-steel-puri-maker-press-machine-roti-chapati-presser-for-home-papad-khakhra-puri-maker-press-machine-with-handle-manual-puri-maker-medium",
          sku: "7149a_steel_puri_press_medium"
        }
      },
      {
        keywords: ['bundle', 'both', 'deal', 'combo', 'ritual'],
        reply: "You can order the complete <strong>Zenkart Ritual Bundle</strong> (Both the Digital Jaap Counter + Stainless Steel Puri Press) with combined free priority air shipping for ₹1,098.",
        action: 'bundle'
      },
      {
        keywords: ['cod', 'cash', 'delivery', 'pay', 'doorstep'],
        reply: "Yes! <strong>100% Cash on Delivery (COD)</strong> is available across all Indian PIN codes. You pay ₹0 advance right now and hand cash to the courier boy only when the physical box arrives."
      },
      {
        keywords: ['shipping', 'delivery', 'charge', 'cost', 'fee', 'free', 'time', 'days', 'track', 'courier'],
        reply: "All Zenkart orders enjoy <strong>100% Free Express Shipping</strong> pan-India with zero threshold. Orders are dispatched from our central hub within 24–48 hours via BlueDart, Delhivery, or Xpressbees with live SMS tracking (3–5 business days delivery)."
      },
      {
        keywords: ['return', 'refund', 'replace', 'broken', 'damage', 'guarantee', 'warranty'],
        reply: "Every purchase includes a <strong>7-Day Hassle-Free Replacement Guarantee</strong>. If your item arrives damaged or defective in transit, simply share a quick WhatsApp photo and we dispatch an immediate brand-new replacement."
      }
    ];

    window.toggleZenkartAiChat = function() {
      const win = document.getElementById('zenkart-ai-window');
      if(!win) return;
      const isOpen = !win.classList.contains('hidden');
      if (isOpen) {
        win.classList.add('opacity-0', 'translate-y-6');
        setTimeout(() => win.classList.add('hidden'), 300);
      } else {
        win.classList.remove('hidden');
        setTimeout(() => win.classList.remove('opacity-0', 'translate-y-6'), 10);
        setTimeout(() => document.getElementById('zenkart-ai-input')?.focus(), 250);
      }
    };

    window.sendQuickPrompt = function(text) {
      const input = document.getElementById('zenkart-ai-input');
      if(input) {
        input.value = text;
        document.getElementById('zenkart-ai-form')?.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    };

    function appendMessage(sender, html, productCard = null, isBundle = false) {
      const container = document.getElementById('zenkart-ai-messages');
      if (!container) return;

      const msgDiv = document.createElement('div');
      msgDiv.className = sender === 'user' ? 'flex items-start justify-end' : 'flex items-start gap-2.5';

      let cardHtml = '';
      if (productCard) {
        cardHtml = `
          <div class="mt-2.5 p-3 rounded-xl bg-black/60 border border-[#2f2f2f] flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-white text-[11px]">${productCard.title}</span>
              <span class="text-emerald-400 font-bold text-xs">${productCard.price}</span>
            </div>
            <div class="grid grid-cols-2 gap-2 mt-1">
              <button 
                type="button" 
                onclick="window.ZenkartCart.buyNow('${productCard.handle}', 1)" 
                class="bg-white hover:bg-neutral-200 text-black font-bold py-1.5 px-3 rounded-lg text-[10px] text-center transition shadow">
                ⚡ 1-Click Buy
              </button>
              <button 
                type="button" 
                onclick="window.ZenkartCart.add('${productCard.handle}', 1)" 
                class="bg-[#1e1e1e] hover:bg-[#282828] border border-[#333] text-white py-1.5 px-3 rounded-lg text-[10px] text-center transition">
                🛒 Add Basket
              </button>
            </div>
          </div>
        `;
      } else if (isBundle) {
        cardHtml = `
          <div class="mt-2.5 p-3 rounded-xl bg-black/60 border border-[#2f2f2f] flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-white text-[11px]">Zenkart Ritual Bundle (Both)</span>
              <span class="text-emerald-400 font-bold text-xs">₹1,098</span>
            </div>
            <button 
              type="button" 
              onclick="window.ZenkartCart.bundleCheckout()" 
              class="w-full bg-white hover:bg-neutral-200 text-black font-bold py-2 px-3 rounded-lg text-[11px] text-center transition shadow">
              ⚡ Order Complete Bundle (COD)
            </button>
          </div>
        `;
      }

      if (sender === 'user') {
        msgDiv.innerHTML = `
          <div class="bg-white text-black p-3 rounded-2xl rounded-tr-sm max-w-[85%] font-medium text-xs shadow">
            ${html}
          </div>
        `;
      } else {
        msgDiv.innerHTML = `
          <div class="w-6 h-6 rounded-full bg-white/10 text-[11px] flex items-center justify-center flex-shrink-0 mt-0.5">✨</div>
          <div class="bg-[#161616] border border-[#2a2a2a] p-3.5 rounded-2xl rounded-tl-sm max-w-[85%] text-white/90 space-y-1">
            <p>${html}</p>
            ${cardHtml}
          </div>
        `;
      }

      container.appendChild(msgDiv);
      container.scrollTop = container.scrollHeight;
    }

    window.handleUserMessage = function(e) {
      e.preventDefault();
      const input = document.getElementById('zenkart-ai-input');
      const query = input?.value.trim();
      if (!query) return;

      appendMessage('user', query);
      input.value = '';

      const lower = query.toLowerCase();
      let matched = null;

      for (const item of KNOWLEDGE_BASE) {
        if (item.keywords.some(k => lower.includes(k))) {
          matched = item;
          break;
        }
      }

      setTimeout(() => {
        if (matched) {
          appendMessage('ai', matched.reply, matched.productCard || null, matched.action === 'bundle');
        } else {
          appendMessage('ai', "Thank you for asking! Both our <strong>Wooden Digital Jaap Counter</strong> (₹499) and <strong>Stainless Steel Puri Press</strong> (₹599) are in stock with 100% Free Express Shipping and Cash on Delivery. Would you like to review specifications or place a direct order?", null, true);
        }
      }, 400);
    };
  })();
</script>
