<section id="features" class="py-20 px-6 border-b border-border-dim max-w-7xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-16">
    <span class="eyebrow block mb-3">Quality & Performance</span>
    <h2 class="text-3xl sm:text-4xl font-serif font-bold text-bone">What You Will Appreciate</h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-ink-card border border-border-dim p-6 rounded-xl">
      <div class="text-amber text-lg font-bold mb-3">01</div>
      <h3 class="text-lg font-serif font-bold text-bone mb-2">Consistent Circle Thickness</h3>
      <p class="text-xs text-bone-muted leading-relaxed">
        No more lopsided or thick-centered puris. Even downward mechanical distribution gives uniform edge-to-edge thinness.
      </p>
    </div>

    <div class="bg-ink-card border border-border-dim p-6 rounded-xl">
      <div class="text-amber text-lg font-bold mb-3">02</div>
      <h3 class="text-lg font-serif font-bold text-bone mb-2">No Wrist Strain</h3>
      <p class="text-xs text-bone-muted leading-relaxed">
        Eliminates repetitive rolling pin pressure. Useful for cooking large festival batches or daily family meals.
      </p>
    </div>

    <div class="bg-ink-card border border-border-dim p-6 rounded-xl">
      <div class="text-amber text-lg font-bold mb-3">03</div>
      <h3 class="text-lg font-serif font-bold text-bone mb-2">Single-Touch Reset Tally</h3>
      <p class="text-xs text-bone-muted leading-relaxed">
        Complete 108 chants or multiple rounds without losing track. Clear LCD screen resets cleanly with one button press.
      </p>
    </div>

    <div class="bg-ink-card border border-border-dim p-6 rounded-xl">
      <div class="text-amber text-lg font-bold mb-3">04</div>
      <h3 class="text-lg font-serif font-bold text-bone mb-2">Integrated Compass</h3>
      <p class="text-xs text-bone-muted leading-relaxed">
        Built directly into the prayer counter body, making it convenient to check prayer alignment during travel.
      </p>
    </div>
  </div>
</section>

