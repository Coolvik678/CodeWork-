<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="h-full">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Enter Store</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  {{ 'forge-styles.css' | asset_url | stylesheet_tag }}
  {{ 'app.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  
  <style>
    body {
      background-color: #000000;
      color: #f5f5f5;
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 20px;
      box-sizing: border-box;
      background-image: radial-gradient(circle at 50% 30%, rgba(200, 134, 43, 0.12) 0%, transparent 60%);
    }
    .password-card {
      background: #0f0f0f;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      padding: 40px 32px;
      max-width: 440px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    }
    .brand-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 32px;
      letter-spacing: 0.25em;
      margin: 0 0 8px 0;
      color: #ffffff;
      font-weight: 700;
    }
    .brand-sub {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.65);
      margin: 0 0 28px 0;
      letter-spacing: 0.05em;
    }
    .input-field {
      width: 100%;
      padding: 14px 16px;
      background: #181818;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 8px;
      color: #ffffff;
      font-size: 15px;
      box-sizing: border-box;
      margin-bottom: 16px;
      outline: none;
      transition: border-color 0.2s;
    }
    .input-field:focus {
      border-color: #c8862b;
    }
    .submit-btn {
      width: 100%;
      padding: 14px;
      background: #ffffff;
      color: #000000;
      font-weight: 700;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
    }
    .submit-btn:hover {
      background: #e6e6e6;
      transform: translateY(-1px);
    }
    .errors {
      color: #ef4444;
      font-size: 13px;
      margin-bottom: 16px;
    }
    .hint-note {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.45);
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="password-card">
    <h1 class="brand-title">ZENKART</h1>
    <p class="brand-sub">Sacred Kitchen & Devotional Rituals</p>

    {% form 'storefront_password', class: 'password-form' %}
      {%- if form.errors -%}
        <div class="errors">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <input 
        type="password" 
        name="password" 
        id="Password" 
        class="input-field" 
        placeholder="Enter store password (nowbra)" 
        autofocus 
        required>

      <button type="submit" name="commit" class="submit-btn">
        Enter Store
      </button>
    {% endform %}

    <div class="hint-note">
      Store Password: <strong style="color:#ffffff;">nowbra</strong>
    </div>

    <main id="MainContent" style="display:none;">
      {{ content_for_layout }}
    </main>
  </div>
</body>
</html>
