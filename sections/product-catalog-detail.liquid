<!-- Client Runtime Scripts for Catalog Page -->
<script>
  let catalogQuantity = 2; // Default to Most Bought (2 Pcs)
  let activeDetailPrice = {% if is_puri %}999{% else %}899{% endif %};

  // Amazon / Flipkart Touch Swipe Carousel Implementation
  let currentSlideIndex = 0;
  const totalSlides = 5;

  function goToSlide(index) {
    if (index < 0) index = 0;
    if (index >= totalSlides) index = totalSlides - 1;
    currentSlideIndex = index;

    const track = document.getElementById('catalog-gallery-track');
    if (track) {
      track.style.transform = `translateX(-${currentSlideIndex * 100}%)`;
    }

    const counter = document.getElementById('gallery-counter-pill');
    if (counter) {
      counter.textContent = `${currentSlideIndex + 1} / ${totalSlides}`;
    }

    // Sync Thumbnails
    const thumbs = document.querySelectorAll('.catalog-thumb-btn');
    thumbs.forEach((thumb, idx) => {
      if (idx === currentSlideIndex) {
        thumb.className = 'catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border-2 border-white opacity-100 bg-[#111] transition-all scale-105';
        thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      } else {
        thumb.className = 'catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-60 hover:opacity-100 bg-[#111] transition-all';
      }
    });
  }

  function nextCatalogSlide() {
    if (currentSlideIndex < totalSlides - 1) {
      goToSlide(currentSlideIndex + 1);
    } else {
      goToSlide(0);
    }
  }

  function prevCatalogSlide() {
    if (currentSlideIndex > 0) {
      goToSlide(currentSlideIndex - 1);
    } else {
      goToSlide(totalSlides - 1);
    }
  }

  // Hand / Finger Swipe Event Listeners (Amazon / Flipkart Mobile Experience)
  (function initSwipeGallery() {
    const viewport = document.getElementById('catalog-gallery-viewport');
    if (!viewport) return;

    let startX = 0;
    let startY = 0;
    let endX = 0;
    let endY = 0;
    let isTouchActive = false;

    viewport.addEventListener('touchstart', function(e) {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      endX = startX;
      endY = startY;
      isTouchActive = true;
    }, { passive: true });

    viewport.addEventListener('touchmove', function(e) {
      if (!isTouchActive) return;
      endX = e.touches[0].clientX;
      endY = e.touches[0].clientY;
    }, { passive: true });

    viewport.addEventListener('touchend', function() {
      if (!isTouchActive) return;
      isTouchActive = false;

      const diffX = endX - startX;
      const diffY = endY - startY;

      // Only trigger horizontal swipe if horizontal movement exceeds vertical
      if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
        if (diffX < 0) {
          nextCatalogSlide(); // Swiped Left -> Next Image
        } else {
          prevCatalogSlide(); // Swiped Right -> Previous Image
        }
      }
    });

    // Mouse Drag for Desktop
    let isMouseDown = false;
    let mouseStartX = 0;
    let mouseEndX = 0;

    viewport.addEventListener('mousedown', function(e) {
      isMouseDown = true;
      mouseStartX = e.clientX;
      mouseEndX = mouseStartX;
    });

    window.addEventListener('mousemove', function(e) {
      if (!isMouseDown) return;
      mouseEndX = e.clientX;
    });

    window.addEventListener('mouseup', function() {
      if (!isMouseDown) return;
      isMouseDown = false;
      const diffX = mouseEndX - mouseStartX;
      if (Math.abs(diffX) > 45) {
        if (diffX < 0) {
          nextCatalogSlide();
        } else {
          prevCatalogSlide();
        }
      }
    });
  })();

  function selectDetailTier(qty, price) {
    catalogQuantity = qty;
    activeDetailPrice = price;

    for (let i = 1; i <= 3; i++) {
      const card = document.getElementById('detail-tier-' + i);
      const radio = document.getElementById('detail-radio-' + i);
      if (card && radio) {
        if (i === qty) {
          card.classList.add('is-selected');
          radio.checked = true;
        } else {
          card.classList.remove('is-selected');
          radio.checked = false;
        }
      }
    }

    const priceDisplay = document.getElementById('buy-now-price-display');
    if (priceDisplay) priceDisplay.textContent = price;

    document.querySelectorAll('.reviews-cta-price').forEach(el => el.textContent = price);
    document.querySelectorAll('.sticky-price-display').forEach(el => el.textContent = price);
  }

  function switchCatalogTab(tabId, btn) {
    document.querySelectorAll('.catalog-tab-content').forEach(content => {
      content.classList.add('hidden');
    });
    document.querySelectorAll('.catalog-tab-btn').forEach(b => {
      b.classList.remove('text-white', 'border-white');
      b.classList.add('text-white/50', 'border-transparent');
    });

    const activeContent = document.getElementById(tabId);
    if (activeContent) activeContent.classList.remove('hidden');

    if (btn) {
      btn.classList.add('text-white', 'border-white');
      btn.classList.remove('text-white/50', 'border-transparent');
    }
  }

  function addCatalogToBasket(id, title, price) {
    if (window.ZenkartCart && window.ZenkartCart.add) {
      window.ZenkartCart.add('{{ product.handle }}' || id, catalogQuantity);
    }
  }

  function triggerCatalogBuyNow(title, price, img, handle) {
    const targetHandle = '{{ product.handle }}' || handle;
    if (window.openBundleSelectorModal) {
      window.openBundleSelectorModal(targetHandle);
    } else if (window.ZenkartCart && window.ZenkartCart.buyNow) {
      window.ZenkartCart.buyNow(targetHandle, catalogQuantity);
    } else {
      window.location.href = '/checkout';
    }
  }

  function checkPincodeDelivery(inputId, resultId) {
    const input = document.getElementById(inputId);
    const result = document.getElementById(resultId);
    if (!input || !result) return;
    const pin = input.value.trim();
    if (pin.length !== 6 || isNaN(pin)) {
      result.className = 'mt-2.5 text-xs text-rose-400 block';
      result.textContent = '⚠️ Please enter a valid 6-digit Indian PIN code.';
      return;
    }
    result.className = 'mt-2.5 text-xs text-emerald-400 block';
    result.innerHTML = `✓ <strong>Delivery Available to ${pin}:</strong> Express Air Dispatch in 24 Hrs • 100% Free Shipping & Cash on Delivery Available.`;
  }

  // ==========================================
  // DYNAMIC AMAZON-STYLE REVIEWS ENGINE
  // ==========================================
  let loadedReviewCount = 8;
  const currentProductKey = '{% if is_puri %}puri{% else %}jaap{% endif %}';
  let activeRatingFilter = 0; // 0 = all

  function getProductReviews() {
    if (window.ZENKART_REVIEWS && window.ZENKART_REVIEWS[currentProductKey]) {
      return window.ZENKART_REVIEWS[currentProductKey];
    }
    return [];
  }

  function renderReviewCard(rev) {
    const initial = rev.name ? rev.name.charAt(0) : 'V';
    const stars = '★'.repeat(rev.rating) + '☆'.repeat(5 - rev.rating);
    const ratingColor = rev.rating >= 4 ? 'text-amber-400' : (rev.rating === 3 ? 'text-yellow-500' : 'text-orange-400');
    return `
      <div class="bg-[#111217] border border-[#242426] rounded-2xl p-5 sm:p-6 flex flex-col justify-between hover:border-amber-400/40 transition-colors">
        <div>
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-amber-600 to-amber-400 text-black font-bold text-sm flex items-center justify-center">${initial}</div>
              <div>
                <h4 class="font-bold text-white text-sm">${rev.name}</h4>
                <p class="text-[11px] text-gray-400">${rev.city} • Reviewed on ${rev.date}</p>
              </div>
            </div>
            <div class="flex ${ratingColor} text-xs">${stars}</div>
          </div>
          <div class="inline-flex items-center gap-1.5 text-[10px] text-emerald-400 bg-emerald-950/40 border border-emerald-800/40 px-2 py-0.5 rounded-full mb-3">
            <span>✓ Verified Purchase (${rev.bundle || 'Direct Order'})</span>
          </div>
          <p class="text-xs sm:text-[13px] text-gray-300 leading-relaxed">"${rev.text}"</p>
        </div>
        <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-[11px] text-gray-500">
          <span>👍 ${rev.helpful} people found this helpful</span>
          <button type="button" onclick="this.textContent = '✓ Helpful'; this.disabled = true;" class="hover:text-white transition cursor-pointer">Helpful</button>
        </div>
      </div>
    `;
  }

  function updateReviewsDisplay() {
    let list = getProductReviews();
    if (activeRatingFilter > 0) {
      list = list.filter(r => r.rating === activeRatingFilter);
    }
    const grid = document.getElementById('dynamic-reviews-grid');
    if (!grid) return;

    const slice = list.slice(0, loadedReviewCount);
    grid.innerHTML = slice.map(renderReviewCard).join('');

    const statusEl = document.getElementById('reviews-count-status');
    if (statusEl) statusEl.textContent = `Showing ${slice.length} of ${list.length}`;

    const loadMoreBtn = document.getElementById('btn-see-more-reviews');
    if (loadMoreBtn) {
      if (slice.length >= list.length) {
        loadMoreBtn.classList.add('hidden');
      } else {
        loadMoreBtn.classList.remove('hidden');
      }
    }
  }

  function loadMoreCatalogReviews() {
    loadedReviewCount += 12;
    updateReviewsDisplay();
  }

  function showAllCatalogReviews() {
    loadedReviewCount = 999;
    updateReviewsDisplay();
  }

  function filterReviewsByStars(stars, btn) {
    activeRatingFilter = stars;
    loadedReviewCount = 8;
    document.querySelectorAll('.review-filter-btn').forEach(b => {
      b.className = 'review-filter-btn bg-[#161618] hover:bg-[#222] border border-[#2b2b2b] text-gray-300 px-3.5 py-1.5 rounded-lg whitespace-nowrap cursor-pointer text-xs';
    });
    if (btn) {
      btn.className = 'review-filter-btn bg-white text-black font-bold px-3.5 py-1.5 rounded-lg whitespace-nowrap shadow cursor-pointer text-xs';
    }
    updateReviewsDisplay();
  }

  // Auto-init reviews on document ready
  document.addEventListener('DOMContentLoaded', function() {
    // If reviews data is ready, render immediately; otherwise poll briefly
    function tryInitReviews() {
      if (window.ZENKART_REVIEWS && window.ZENKART_REVIEWS[currentProductKey]) {
        updateReviewsDisplay();
      } else {
        setTimeout(tryInitReviews, 150);
      }
    }
    tryInitReviews();
  });
</script>

