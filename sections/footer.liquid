      .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links h3 {
        font-family: var(--font-heading--family, inherit);
        font-size: 18px;
        color: var(--color-foreground-heading);
        font-style: normal;
        font-weight: var(--font-h3--weight, 700);
        margin-bottom: 15px;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links li {
        margin-bottom: 8px;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links a {
        font-family: var(--font-body--family, inherit);
        font-size: 14px;
        color: var(--color-foreground);
        font-style: normal;
        font-weight: var(--font-body--weight, 400);
        text-decoration: none;
        transition: color 0.3s ease;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links a:hover {
        color: var(--color-primary);
      }

      
      .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-header {
        display: none;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-content {
        max-height: none;
        overflow: visible;
      }

      @media (max-width: 768px) {
        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links {
          
          border-bottom: 1px solid var(--color-border);
          padding-bottom: 10px;
          margin-bottom: 10px;
          
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-header {
          display: flex;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-content {
          max-height: 0;
          overflow: hidden;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          cursor: pointer;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-icon {
          position: relative;
          width: 15px;
          height: 15px;
          cursor: pointer;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-icon::before,
        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-icon::after {
          content: "";
          display: block;
          background-color: var(--color-foreground-heading);
          position: absolute;
          top: 50%;
          left: 0;
          transition: 0.35s ease;
          width: 100%;
          height: 2px;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-icon::before {
          transform: translateY(-50%);
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-icon::after {
          transform: translateY(-50%) rotate(90deg);
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-icon.collapsed::before {
          transform: translateY(-50%) rotate(-90deg);
          opacity: 0;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-icon.collapsed::after {
          transform: translateY(-50%) rotate(0);
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-content {
          max-height: 0;
          overflow: hidden;
          transition: max-height 0.3s ease;
          padding-top: 10px;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-content.open {
          max-height: 300px;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links h3:not(.stellar_colophon-mobile-header h3) {
          display: none;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links .stellar_colophon-mobile-header h3 {
          font-size: 16px;
          margin-bottom: 0;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-menu-links-menu_links a {
          font-size: 13px;
        }
      }
    
  
    
  
    
  
    
  

  
  
    
  
    
  
    
  
    
