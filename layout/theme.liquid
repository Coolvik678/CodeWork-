<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} — {{ shop.name }}</title>
  <meta name="description" content="{{ page_description | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{ 'forge-styles.css' | asset_url | stylesheet_tag }}
  {{ 'app.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="bg-black text-[#f5f5f5] font-sans min-h-screen flex flex-col justify-between forge-color-scheme-1">
  <div>
    {% section 'announcement-bar' %}
    {% section 'header' %}
    
    <main id="MainContent" role="main">
      {%- if request.path contains '/offers' or request.path contains '/pages/offers' or template.suffix == 'offers' -%}
        {% section 'offers-page' %}
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>
  </div>

  {% section 'footer' %}
  {% render 'cart-drawer' %}
  {% render 'cod-checkout-modal' %}
  {% render 'bundle-selector-modal' %}
  {% render 'offer-boom-modal' %}
  {% render 'ai-concierge' %}

  <script src="{{ 'product-reviews-data.js' | asset_url }}" defer></script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
