<!-- snippets/cod-checkout-modal.liquid -->
<div id="cod-modal-overlay" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
  <div id="cod-modal-card" class="bg-[#0f0f0f] border border-[#2a2a2a] rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl scale-95 transition-transform duration-300 max-h-[90vh] flex flex-col text-[#f5f5f5]">
    
    <!-- Modal Header -->
    <div class="p-5 border-b border-[#222] flex items-center justify-between bg-black">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
        <h3 class="font-serif font-bold text-white text-lg">Instant Cash on Delivery Order</h3>
      </div>
      <button type="button" onclick="closeQuickCodModal()" class="text-white/60 hover:text-white text-base p-1.5 transition">✕</button>
    </div>

    <!-- Modal Body (Scrollable) -->
    <div class="p-6 overflow-y-auto space-y-5 flex-1 text-xs">
      
      <!-- Order Summary Card -->
      <div class="bg-[#141414] p-3.5 rounded-xl border border-[#262626] flex items-center gap-3">
        <img id="cod-modal-img" src="" alt="Product" class="w-14 h-14 rounded-lg object-cover border border-[#2a2a2a] flex-shrink-0">
        <div class="flex-1 truncate">
          <div id="cod-modal-title" class="font-bold text-white truncate">Product Title</div>
          <div class="text-[11px] text-white/50 mt-0.5">Quantity: <span id="cod-modal-qty" class="text-white font-semibold">1</span> • Free Air Shipping</div>
          <div class="text-white font-bold text-sm mt-0.5">Payable at Doorstep: <span id="cod-modal-price" class="text-emerald-400">₹499</span></div>
        </div>
      </div>

      <!-- Customer Details Form -->
      <form id="cod-checkout-form" onsubmit="handleCodOrderSubmit(event)" class="space-y-4">
        
        <div>
          <label class="block text-[11px] font-semibold text-white/60 uppercase mb-1">Full Name *</label>
          <input 
            type="text" 
            id="cod-name" 
            required 
            placeholder="e.g. Ramesh Kumar" 
            class="w-full bg-black border border-[#2a2a2a] rounded-lg px-3.5 py-2.5 text-xs text-white placeholder:text-white/30 focus:outline-none focus:border-white transition">
        </div>

        <div>
          <label class="block text-[11px] font-semibold text-white/60 uppercase mb-1">10-Digit Mobile Number (For Delivery Call &amp; Tracking) *</label>
          <div class="flex gap-2">
            <span class="bg-black border border-[#2a2a2a] rounded-lg px-3 py-2.5 text-white text-xs font-semibold flex items-center">+91</span>
            <input 
              type="tel" 
              id="cod-phone" 
              required 
              pattern="[0-9]{10}" 
              maxlength="10" 
              placeholder="9876543210" 
              class="flex-1 bg-black border border-[#2a2a2a] rounded-lg px-3.5 py-2.5 text-xs text-white placeholder:text-white/30 focus:outline-none focus:border-white transition">
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-semibold text-white/60 uppercase mb-1">Complete Delivery Address (House/Flat No, Street, Landmark) *</label>
          <textarea 
            id="cod-address" 
            required 
            rows="2" 
            placeholder="e.g. Flat 402, Shanti Heights, Near Main Road" 
            class="w-full bg-black border border-[#2a2a2a] rounded-lg px-3.5 py-2.5 text-xs text-white placeholder:text-white/30 focus:outline-none focus:border-white transition"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[11px] font-semibold text-white/60 uppercase mb-1">PIN Code *</label>
            <input 
              type="text" 
              id="cod-pincode" 
              required 
              maxlength="6" 
              placeholder="e.g. 411038" 
              class="w-full bg-black border border-[#2a2a2a] rounded-lg px-3.5 py-2.5 text-xs text-white placeholder:text-white/30 focus:outline-none focus:border-white transition">
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-white/60 uppercase mb-1">City / Town *</label>
            <input 
              type="text" 
              id="cod-city" 
              required 
              placeholder="e.g. Pune" 
              class="w-full bg-black border border-[#2a2a2a] rounded-lg px-3.5 py-2.5 text-xs text-white placeholder:text-white/30 focus:outline-none focus:border-white transition">
          </div>
        </div>

        <!-- Payment Mode Indicator -->
        <div class="p-3 rounded-xl border border-[#333] bg-[#141414] flex items-center gap-3">
          <input type="radio" checked readonly class="accent-white w-4 h-4">
          <div>
            <div class="font-bold text-white text-xs">Cash on Delivery (COD)</div>
            <div class="text-[10px] text-white/50">Pay ₹0 right now. Hand cash to delivery executive upon physical arrival.</div>
          </div>
        </div>

        <div class="pt-2">
          <button 
            type="submit" 
            id="cod-submit-btn"
            class="w-full bg-white hover:bg-neutral-200 text-black font-bold text-sm py-3.5 px-6 rounded-xl transition duration-200 shadow-xl flex items-center justify-center gap-2">
            <span>Confirm Order with Cash on Delivery ➔</span>
          </button>
        </div>

      </form>

      <!-- Order Confirmation Screen (Hidden until order submitted) -->
      <div id="cod-success-view" class="hidden py-8 text-center space-y-4">
        <div class="w-14 h-14 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-2xl flex items-center justify-center mx-auto">
          ✓
        </div>
        <h4 class="font-serif font-bold text-white text-2xl">Order Confirmed!</h4>
        <p class="text-xs text-white/60 max-w-sm mx-auto leading-relaxed">
          Thank you, <strong id="success-cust-name" class="text-white"></strong>! Your Cash on Delivery order <strong id="success-order-id" class="text-emerald-400"></strong> has been registered with <strong>Zenkart Priority Fulfillment</strong>.
        </p>
        <div class="bg-[#141414] p-3 rounded-xl border border-[#262626] text-[11px] text-white/60 max-w-xs mx-auto">
          <div>Estimated Delivery: <strong>3–4 Business Days</strong></div>
          <div class="text-emerald-400 font-semibold mt-0.5">SMS &amp; WhatsApp Tracking Dispatched</div>
        </div>
        <button 
          type="button" 
          onclick="closeQuickCodModal()" 
          class="bg-[#1c1c1c] hover:bg-[#252525] border border-[#333] text-white font-medium text-xs py-2.5 px-6 rounded-xl transition">
          Continue Browsing
        </button>
      </div>

    </div>

  </div>
</div>

<script>
  let activeCodItem = null;

  window.openQuickCodModal = function(title, price, img, handle, qty = 1) {
    activeCodItem = { title, price, img, handle, qty };
    
    document.getElementById('cod-modal-title').textContent = title;
    document.getElementById('cod-modal-price').textContent = '₹' + price;
    document.getElementById('cod-modal-qty').textContent = qty;
    document.getElementById('cod-modal-img').src = img;

    document.getElementById('cod-checkout-form').classList.remove('hidden');
    document.getElementById('cod-success-view').classList.add('hidden');

    const overlay = document.getElementById('cod-modal-overlay');
    const card = document.getElementById('cod-modal-card');
    
    overlay.classList.remove('hidden');
    setTimeout(() => {
      overlay.classList.remove('opacity-0');
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  };

  window.closeQuickCodModal = function() {
    const overlay = document.getElementById('cod-modal-overlay');
    const card = document.getElementById('cod-modal-card');
    
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    overlay.classList.add('opacity-0');
    setTimeout(() => {
      overlay.classList.add('hidden');
    }, 300);
  };

  window.handleCodOrderSubmit = function(e) {
    e.preventDefault();
    const btn = document.getElementById('cod-submit-btn');
    btn.disabled = true;
    btn.innerHTML = '<span>Redirecting to Secure Shopify Checkout...</span>';

    if (window.ZenkartCart && activeCodItem) {
      window.ZenkartCart.buyNow(activeCodItem.handle, activeCodItem.qty || 1);
    } else {
      window.location.href = '/checkout';
    }
  };
</script>
