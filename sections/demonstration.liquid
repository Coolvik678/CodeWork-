<section id="demonstration" class="py-24 px-6 border-b border-border-dim max-w-7xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-16" data-reveal>
    <span class="eyebrow block mb-3">Practical Demonstrations</span>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-bone">Designed for Actual Daily Use</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="card-glass card-glow p-8 lg:p-10 rounded-2xl flex flex-col justify-between" data-reveal>
      <div>
        <span class="text-xs font-bold text-amber uppercase tracking-wider block mb-3">Item 1: Kitchen Efficiency</span>
        <h3 class="text-2xl font-serif font-bold text-bone mb-4">Effortless Dough Pressing</h3>
        <p class="text-sm text-bone-muted leading-relaxed">
          Place dough slightly toward the hinge, apply firm downward pressure for 2 seconds, and lift. Dough flattens uniformly without tearing, ready for direct frying or roasting.
        </p>
      </div>
    </div>

    <div class="card-glass card-glow p-8 lg:p-10 rounded-2xl flex flex-col justify-between" data-reveal>
      <div>
        <span class="text-xs font-bold text-amber uppercase tracking-wider block mb-3">Item 2: Devotional Focus</span>
        <h3 class="text-2xl font-serif font-bold text-bone mb-4">Silent Devotional Focus</h3>
        <p class="text-sm text-bone-muted leading-relaxed">
          The contoured wooden body sits naturally in the palm. The roller turns silently under thumb pressure, allowing continuous counting without noise or distractions.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Demonstrations",
  "settings": []
}
{% endschema %}
