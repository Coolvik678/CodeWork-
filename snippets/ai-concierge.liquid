          return {
            text: `The <strong>Wooden Digital Jaap Counter</strong> is ₹499 for 1 pc.<br><br>
            💡 <strong>Special Combo:</strong> Buy 2 for <strong>₹899</strong> (Save ₹99) or Buy 3 for <strong>₹1,199</strong> (Save ₹298). Includes Free Express Shipping &amp; Cash on Delivery!`,
