<!-- snippets/offer-boom-modal.liquid -->
<!-- Lightweight, Zero-Lag Confetti Sale Reveal Modal -->
<style>
  #zenkart-confetti-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 9999999;
    pointer-events: none;
  }

  #sale-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: rgba(0, 0, 0, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  #sale-modal-overlay.is-visible {
    opacity: 1;
    visibility: visible;
  }

  #sale-modal-card {
    background: #111111;
    border: 1px solid #333333;
    border-radius: 20px;
    width: 100%;
    max-width: 480px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
    transform: scale(0.95) translateY(10px);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    color: #ffffff;
  }

  #sale-modal-overlay.is-visible #sale-modal-card {
    transform: scale(1) translateY(0);
  }

  .sale-badge {
    background: #f59e0b;
    color: #000000;
    font-size: 11px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>

<!-- High Performance Canvas Confetti -->
<canvas id="zenkart-confetti-canvas"></canvas>

<!-- Sale Offers Modal -->
<div id="sale-modal-overlay" onclick="handleSaleOverlayClick(event)">
  <div id="sale-modal-card">
    
    <!-- Header -->
    <div style="background: linear-gradient(135deg, #1c1c1c 0%, #141414 100%); padding: 18px 20px; border-bottom: 1px solid #262626; display: flex; align-items: center; justify-content: space-between;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 18px;">🎉</span>
        <div>
          <div style="font-size: 10px; font-weight: 700; color: #f59e0b; text-transform: uppercase; letter-spacing: 0.08em;">Limited Time Offer</div>
          <h3 style="margin: 0; font-size: 17px; font-weight: 800; color: #ffffff; font-family: ui-serif, Georgia, serif;">Flat ₹50 OFF On Both Products</h3>
        </div>
      </div>
      <button 
        type="button" 
        onclick="closeSaleOfferModal()" 
        aria-label="Close" 
        style="background: #222; border: 1px solid #333; color: #bbb; border-radius: 50%; width: 28px; height: 28px; display: grid; place-items: center; font-size: 14px; cursor: pointer;">
        ✕
      </button>
    </div>

    <!-- Product Offers List -->
    <div style="padding: 16px 20px; display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
      
      <!-- Product 1: Jaap Counter -->
      <div style="background: #181818; border: 1px solid #282828; border-radius: 14px; padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
          <span style="font-size: 22px;">🕉️</span>
          <div style="min-width: 0;">
            <div style="font-weight: 700; color: #ffffff; font-size: 13px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">Wooden Digital Jaap Counter</div>
            <div style="font-size: 11px; color: #888; margin-top: 2px;">With Compass &amp; Red Tassel (184 Reviews ★★★★★)</div>
          </div>
        </div>
        <div style="text-align: right; flex-shrink: 0;">
          <div style="display: flex; align-items: baseline; gap: 6px; justify-content: flex-end;">
            <span style="font-size: 12px; color: #666; text-decoration: line-through;">₹499</span>
            <span style="font-size: 16px; font-weight: 800; color: #f59e0b;">₹449</span>
          </div>
          <span class="sale-badge" style="display: inline-block; margin-top: 2px;">₹50 OFF</span>
        </div>
      </div>

      <!-- Product 2: Puri Press -->
      <div style="background: #181818; border: 1px solid #282828; border-radius: 14px; padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
          <span style="font-size: 22px;">🥟</span>
          <div style="min-width: 0;">
            <div style="font-weight: 700; color: #ffffff; font-size: 13px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">Stainless Steel Puri Press Maker</div>
            <div style="font-size: 11px; color: #888; margin-top: 2px;">Heavy SUS-304 Food Grade (241 Reviews ★★★★★)</div>
          </div>
        </div>
        <div style="text-align: right; flex-shrink: 0;">
          <div style="display: flex; align-items: baseline; gap: 6px; justify-content: flex-end;">
            <span style="font-size: 12px; color: #666; text-decoration: line-through;">₹599</span>
            <span style="font-size: 16px; font-weight: 800; color: #f59e0b;">₹549</span>
          </div>
          <span class="sale-badge" style="display: inline-block; margin-top: 2px;">₹50 OFF</span>
        </div>
      </div>

      <!-- Combo note -->
      <div style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 10px; padding: 10px 12px; font-size: 11.5px; color: #e5e5e5; display: flex; align-items: center; gap: 8px;">
        <span>🔥</span>
        <div><strong>Combo Deals:</strong> Buy 2 Jaap for <strong>₹899</strong> | Buy 2 Puri for <strong>₹999</strong> with Free COD!</div>
      </div>

    </div>

    <!-- Footer Actions -->
    <div style="padding: 14px 20px 18px; border-top: 1px solid #222; display: flex; flex-direction: column; gap: 8px;">
      <button 
        type="button" 
        onclick="claimSaleOffer()" 
        style="width: 100%; background: #ffffff; color: #000000; font-weight: 800; font-size: 13px; padding: 13px 16px; border-radius: 12px; border: none; cursor: pointer; text-transform: uppercase; letter-spacing: 0.03em;">
        ⚡ Claim Offer &amp; View Combos
      </button>
      <div style="display: flex; justify-content: space-between; font-size: 11px; color: #777; padding: 0 4px;">
        <span>✓ 100% Free Express Shipping</span>
        <span>•</span>
        <span>✓ Cash on Delivery Available</span>
      </div>
    </div>

  </div>
</div>

<script>
  (function(){
    // Lightweight, zero-dependency Canvas Confetti Engine (60fps, no lag)
    function runConfetti() {
      const canvas = document.getElementById('zenkart-confetti-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const colors = ['#f59e0b', '#10b981', '#3b82f6', '#ec4899', '#ffffff', '#fbbf24'];
      const pieces = [];
      const numPieces = 70; // Lightweight count for butter-smooth mobile & PC

      for (let i = 0; i < numPieces; i++) {
        pieces.push({
          x: Math.random() * canvas.width,
          y: Math.random() * (canvas.height * 0.3) - 20, // Start from top
          size: Math.random() * 8 + 5,
          color: colors[Math.floor(Math.random() * colors.length)],
          vx: (Math.random() - 0.5) * 3,
          vy: Math.random() * 3 + 2.5,
          rotation: Math.random() * 360,
          vRot: (Math.random() - 0.5) * 10
        });
      }

      let startTime = null;
      function animate(time) {
        if (!startTime) startTime = time;
        const progress = time - startTime;

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        pieces.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.rotation += p.vRot;

          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rotation * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
          ctx.restore();
        });

        // Run for 3 seconds then stop cleanly to release GPU
        if (progress < 3000) {
          requestAnimationFrame(animate);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }

      requestAnimationFrame(animate);
    }

    // Modal Control
    window.openSaleOfferModal = function() {
      const overlay = document.getElementById('sale-modal-overlay');
      if (overlay) {
        overlay.classList.add('is-visible');
        runConfetti();
      }
    };

    window.closeSaleOfferModal = function() {
      const overlay = document.getElementById('sale-modal-overlay');
      if (overlay) {
        overlay.classList.remove('is-visible');
      }
    };

    window.handleSaleOverlayClick = function(e) {
      if (e.target.id === 'sale-modal-overlay') {
        closeSaleOfferModal();
      }
    };

    window.claimSaleOffer = function() {
      closeSaleOfferModal();
      if (typeof window.openBundleSelectorModal === 'function') {
        window.openBundleSelectorModal();
      } else {
        const catalog = document.getElementById('featured-catalog') || document.getElementById('best-offers-banner');
        if (catalog) catalog.scrollIntoView({ behavior: 'smooth' });
      }
    };

    // Close on Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeSaleOfferModal();
    });

    // Automatically trigger confetti & reveal offers when store is opened!
    window.addEventListener('DOMContentLoaded', function() {
      setTimeout(() => {
        openSaleOfferModal();
      }, 350);
    });
  })();
</script>
