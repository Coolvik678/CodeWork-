<section class="relative py-24 lg:py-32 px-6 border-b border-border-dim overflow-hidden lightpool" data-embers="16">
  <!-- Full-bleed background video container -->
  <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none -z-10">
    <video 
      autoplay 
      loop 
      muted 
      playsinline 
      preload="auto" 
      class="w-full h-full object-cover opacity-60 scale-[1.02]">
      <source src="{{ 'hero-bg.mp4' | asset_url }}" type="video/mp4">
    </video>
    <!-- Ambient gradient overlays so headline & CTAs stay 100% legible -->
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/65 to-ink/40"></div>
    <div class="absolute inset-0 bg-radial-vignette opacity-80"></div>
  </div>

  <div class="max-w-4xl mx-auto text-center relative z-10">
    <span class="eyebrow inline-block mb-4">Everyday Household Craft & Devotional Essentials</span>
    
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-serif font-bold tracking-tight text-bone leading-[1.08] mb-6">
      <span class="hero-word" style="--i: 0">Enduring</span>
      <span class="hero-word" style="--i: 1">Craft.</span><br>
      <span class="text-amber">
        <span class="hero-word" style="--i: 2">Engineered</span>
        <span class="hero-word" style="--i: 3">for</span>
        <span class="hero-word" style="--i: 4">Daily</span>
        <span class="hero-word" style="--i: 5">Life.</span>
      </span>
    </h1>

    <p class="text-base sm:text-lg text-bone-muted max-w-2xl mx-auto leading-relaxed mb-10" data-reveal>
      Heavy-gauge culinary machinery and tactile devotionals. Built with heavy stainless steel and natural wood grain for lifelong Indian domestic use.
    </p>

    <div class="flex flex-wrap justify-center gap-4 mb-14" data-reveal>
      <a href="#puri-press" class="bg-amber hover:bg-amber-lit text-black font-semibold text-sm px-8 py-4 rounded-full shadow-lg transition-all duration-200 hover:-translate-y-0.5">
        Order Puri Press — ₹599
      </a>
      <a href="#jaap-counter" class="card-glass hover:border-amber text-bone font-semibold text-sm px-8 py-4 rounded-full transition-all duration-200 hover:-translate-y-0.5">
        Order Jaap Counter — ₹499
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-xs font-medium text-bone-muted max-w-3xl mx-auto" data-reveal>
      <div class="card-glass card-glow p-3.5 rounded-lg text-center">✓ Dispatched in 24 Hours</div>
      <div class="card-glass card-glow p-3.5 rounded-lg text-center">✓ Cash on Delivery (COD)</div>
      <div class="card-glass card-glow p-3.5 rounded-lg text-center">✓ 7-Day Free Replacement</div>
      <div class="card-glass card-glow p-3.5 rounded-lg text-center">✓ 100% Quality Inspected</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": []
}
{% endschema %}
