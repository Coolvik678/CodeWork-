<section class="py-20 px-6 border-b border-border-dim bg-ink-card/40">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-14" data-reveal>
      <span class="eyebrow block mb-2">Service Standards</span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-bone">Our Customer Commitments</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="card-glass card-glow p-6 rounded-xl" data-reveal>
        <h3 class="text-sm font-bold text-bone mb-2">Free Tracked Express Delivery</h3>
        <p class="text-xs text-bone-muted leading-relaxed">Dispatched within 24 hours. Full SMS tracking to all Indian pincodes.</p>
      </div>

      <div class="card-glass card-glow p-6 rounded-xl" data-reveal>
        <h3 class="text-sm font-bold text-bone mb-2">Cash on Delivery Available</h3>
        <p class="text-xs text-bone-muted leading-relaxed">Pay upon delivery at your door, or use UPI and cards at checkout.</p>
      </div>

      <div class="card-glass card-glow p-6 rounded-xl" data-reveal>
        <h3 class="text-sm font-bold text-bone mb-2">7-Day Direct Replacement</h3>
        <p class="text-xs text-bone-muted leading-relaxed">If anything arrives damaged or not working, we replace it immediately.</p>
      </div>

      <div class="card-glass card-glow p-6 rounded-xl" data-reveal>
        <h3 class="text-sm font-bold text-bone mb-2">100% Quality Inspected</h3>
        <p class="text-xs text-bone-muted leading-relaxed">Every piece is individually tested and securely bubble-packed before dispatch.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantees",
  "settings": []
}
{% endschema %}
