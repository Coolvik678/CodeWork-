{
  "manifest_version": 3,
  "name": "Flowing Images — Google Flow Automation",
  "version": "1.1.0",
  "description": "100% Free Bulk Prompt Generator, Reference Mapper & Auto Downloader for Google Flow.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "action": {
    "default_title": "Toggle Flowing Images In-Page Panel"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/tools/flow/*"
      ],
      "css": [
        "src/content/inpage_overlay.css"
      ],
      "js": [
        "src/utils/auto_tagger.js",
        "src/utils/file_namer.js",
        "src/content/inpage_overlay.js",
        "src/content/google_flow_dom.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
