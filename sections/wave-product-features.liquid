      height: 100%;
      display: block;
      object-fit: var(--media-object-fit, cover);
    }
  
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__media{
      width: 100%;
      height: 100%;
    }
  
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__placeholder{
