<!-- Client Runtime Scripts for Catalog Page -->
<script>
  let catalogQuantity = 1;

  function switchMainImage(src, btn) {
    const mainImg = document.getElementById('main-catalog-image');
    if (mainImg) mainImg.src = src;

    document.querySelectorAll('.catalog-thumb-btn').forEach(b => {
      b.classList.remove('border-white', 'opacity-100');
      b.classList.add('border-[#2a2a2a]', 'opacity-70');
    });

    if (btn) {
      btn.classList.add('border-white', 'opacity-100');
      btn.classList.remove('border-[#2a2a2a]', 'opacity-70');
    }
  }

  function changeQuantity(delta) {
    catalogQuantity = Math.max(1, catalogQuantity + delta);
    const qtyEl = document.getElementById('catalog-qty-val');
    const priceDisplay = document.getElementById('buy-now-price-display');
    const basePrice = {{ current_price_num }};

    if (qtyEl) qtyEl.textContent = catalogQuantity;
    if (priceDisplay) priceDisplay.textContent = (basePrice * catalogQuantity);
  }

  function switchCatalogTab(tabId, btn) {
    document.querySelectorAll('.catalog-tab-content').forEach(content => {
      content.classList.add('hidden');
    });
    document.querySelectorAll('.catalog-tab-btn').forEach(b => {
      b.classList.remove('text-white', 'border-white');
      b.classList.add('text-white/50', 'border-transparent');
    });

    const activeContent = document.getElementById(tabId);
    if (activeContent) activeContent.classList.remove('hidden');

    if (btn) {
      btn.classList.add('text-white', 'border-white');
      btn.classList.remove('text-white/50', 'border-transparent');
    }
  }

  function addCatalogToBasket(id, title, price) {
    if (window.ZenkartCart) {
      for (let i = 0; i < catalogQuantity; i++) {
        window.ZenkartCart.add(id, title, price);
      }
    }
  }

  function triggerCatalogBuyNow(title, price, img, handle) {
    if (typeof openQuickCodModal === 'function') {
      openQuickCodModal(title, price * catalogQuantity, img, handle, catalogQuantity);
    } else if (window.ZenkartCart) {
      addCatalogToBasket(handle, title, price);
      window.location.href = '/checkout';
    }
  }
</script>

