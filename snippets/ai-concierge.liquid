<!-- snippets/ai-concierge.liquid -->
<style>
  #zenkart-ai-wrapper {
    position: fixed !important;
    bottom: 24px !important;
    right: 24px !important;
    z-index: 999999 !important;
    display: block !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  }

  #zenkart-ai-launcher {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    background: #0e0e0e !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    padding: 12px 20px !important;
    border-radius: 9999px !important;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.8), 0 0 20px rgba(255, 255, 255, 0.08) !important;
    cursor: pointer !important;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease !important;
    user-select: none !important;
  }

  #zenkart-ai-launcher:hover {
    transform: translateY(-2px) scale(1.02) !important;
    border-color: rgba(255, 255, 255, 0.7) !important;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.9), 0 0 25px rgba(255, 255, 255, 0.15) !important;
  }

  .zenkart-ai-pulse-dot {
    position: relative !important;
    display: inline-block !important;
    width: 9px !important;
    height: 9px !important;
    border-radius: 50% !important;
    background: #10b981 !important;
  }

  .zenkart-ai-pulse-ring {
    position: absolute !important;
    inset: -3px !important;
    border-radius: 50% !important;
    border: 2px solid #10b981 !important;
    animation: zenkartPing 1.8s cubic-bezier(0, 0, 0.2, 1) infinite !important;
  }

  @keyframes zenkartPing {
    0% { transform: scale(0.8); opacity: 0.9; }
    80%, 100% { transform: scale(2.2); opacity: 0; }
  }

  #zenkart-ai-window {
    position: fixed !important;
    bottom: 84px !important;
    right: 24px !important;
    width: 380px !important;
    max-width: calc(100vw - 32px) !important;
    height: 560px !important;
    max-height: calc(100vh - 110px) !important;
    background: #0c0c0c !important;
    border: 1px solid #282828 !important;
    border-radius: 20px !important;
    box-shadow: 0 25px 60px rgba(0,0,0,0.95), 0 0 30px rgba(0,0,0,0.8) !important;
    z-index: 999999 !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
    transition: opacity 0.25s ease, transform 0.25s ease !important;
  }

  #zenkart-ai-window.is-closed {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(16px) scale(0.96) !important;
  }

  #zenkart-ai-window.is-open {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) scale(1) !important;
  }

  .zenkart-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .zenkart-scrollbar::-webkit-scrollbar-thumb {
    background: #262626;
    border-radius: 4px;
  }
</style>

<div id="zenkart-ai-wrapper">
  <!-- Launcher Button -->
  <button 
    id="zenkart-ai-launcher" 
    type="button" 
    onclick="toggleZenkartAiChat()" 
    aria-label="Open AI Concierge">
    <span class="zenkart-ai-pulse-dot">
      <span class="zenkart-ai-pulse-ring"></span>
    </span>
    <span style="font-size: 13px; font-weight: 600; letter-spacing: 0.02em; display: flex; align-items: center; gap: 6px;">
      <span>✨</span>
      <span>Zen-AI</span>
    </span>
  </button>

  <!-- Chat Window -->
  <div id="zenkart-ai-window" class="is-closed">
    <!-- Header -->
    <div style="padding: 16px 20px; border-bottom: 1px solid #222; background: #000; display: flex; align-items: center; justify-content: space-between;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <div style="width: 32px; height: 32px; border-radius: 50%; background: #1a1a1a; border: 1px solid #333; display: grid; place-items: center; font-size: 15px;">
          ✨
        </div>
        <div>
          <div style="font-weight: 700; color: #fff; font-size: 14px; display: flex; align-items: center; gap: 8px;">
            <span>Zen-AI</span>
            <span style="font-size: 9px; font-weight: 800; background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4); padding: 2px 6px; border-radius: 999px;">ONLINE</span>
          </div>
          <div style="font-size: 11px; color: #888; margin-top: 1px;">Instant Answers &amp; Order Support</div>
        </div>
      </div>
      <button 
        type="button" 
        onclick="toggleZenkartAiChat()" 
        style="background: transparent; border: none; color: #888; font-size: 18px; cursor: pointer; padding: 4px 8px; line-height: 1;">
        ✕
      </button>
    </div>

    <!-- Messages Container -->
    <div id="zenkart-ai-messages" class="zenkart-scrollbar" style="flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 14px; font-size: 12px; line-height: 1.55;">
      <div style="display: flex; align-items: flex-start; gap: 10px;">
        <div style="width: 24px; height: 24px; border-radius: 50%; background: #222; display: grid; place-items: center; font-size: 11px; flex-shrink: 0; margin-top: 2px;">✨</div>
        <div style="background: #151515; border: 1px solid #282828; padding: 12px 14px; border-radius: 14px; border-top-left-radius: 2px; max-width: 86%; color: #e5e5e5;">
          <p style="margin: 0 0 8px;">Namaste! I am <strong>Zen-AI</strong>, your mindful shopping and kitchen ritual assistant. How can I assist you today?</p>
          <div style="font-size: 10px; color: #888; border-top: 1px solid #252525; padding-top: 6px;">
            Ask about our Jaap counter, Puri press, Cash on Delivery (COD), or tracking.
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Prompt Pills -->
    <div style="padding: 8px 12px; border-top: 1px solid #202020; background: #080808; display: flex; gap: 6px; overflow-x: auto; white-space: nowrap; font-size: 11px;">
      <button onclick="sendQuickPrompt('How does the Jaap counter work?')" style="background: #181818; border: 1px solid #2a2a2a; color: #bbb; padding: 4px 10px; border-radius: 999px; cursor: pointer; flex-shrink: 0;">
        📿 Jaap Counter
      </button>
      <button onclick="sendQuickPrompt('Tell me about the Puri Press')" style="background: #181818; border: 1px solid #2a2a2a; color: #bbb; padding: 4px 10px; border-radius: 999px; cursor: pointer; flex-shrink: 0;">
        🥟 Puri Press
      </button>
      <button onclick="sendQuickPrompt('What are your COD and shipping terms?')" style="background: #181818; border: 1px solid #2a2a2a; color: #bbb; padding: 4px 10px; border-radius: 999px; cursor: pointer; flex-shrink: 0;">
        🚚 Free COD Delivery
      </button>
      <button onclick="sendQuickPrompt('What is the replacement policy?')" style="background: #181818; border: 1px solid #2a2a2a; color: #bbb; padding: 4px 10px; border-radius: 999px; cursor: pointer; flex-shrink: 0;">
        🔄 7-Day Guarantee
      </button>
    </div>

    <!-- Chat Input Form -->
    <form id="zenkart-ai-form" onsubmit="handleUserMessage(event)" style="padding: 12px 14px; border-top: 1px solid #222; background: #000; display: flex; align-items: center; gap: 8px; margin: 0;">
      <input 
        id="zenkart-ai-input" 
        type="text" 
        autocomplete="off" 
        placeholder="Type a question (e.g. Is COD available?)..." 
        style="flex: 1; background: #141414; border: 1px solid #2a2a2a; border-radius: 10px; padding: 10px 14px; font-size: 12px; color: #fff; outline: none;">
      <button 
        type="submit" 
        style="background: #fff; color: #000; font-weight: 700; border: none; border-radius: 10px; padding: 10px 14px; font-size: 13px; cursor: pointer;">
        ➔
      </button>
    </form>
  </div>
</div>

<script>
  (function(){
    const KNOWLEDGE_BASE = [
      {
        keywords: ['tasbih', 'jaap', 'counter', 'mantra', 'bead', 'zikr', 'compass', 'tassel', 'finger', 'scroll', 'wood'],
        reply: "The <strong>Wooden Digital Jaap Counter</strong> (₹499) features an LCD screen supporting 0 to 99,999 chants, a silent tactile roller wheel, a 360° prayer alignment compass, and a sacred red ceremonial silk tassel. Pre-installed long-life button battery included.",
        productCard: {
          title: "Wooden Digital Jaap Counter",
          price: "₹499",
          handle: "wooden-digital-tasbih-counter-handheld-lcd-mantra-jaap-counter-with-compass-1-pc"
        }
      },
      {
        keywords: ['puri', 'press', 'roti', 'chapati', 'khakhra', 'papad', 'steel', 'machine', 'kitchen', 'rolling'],
        reply: "The <strong>Stainless Steel Puri & Khakhra Press Maker</strong> (₹599) is crafted from heavy-gauge food-grade SUS-304 stainless steel with a 6.5-inch mirror-polished plate, silicone non-slip rubber base, and ergonomic leverage handle. Cuts preparation from 25 minutes to under 5 minutes.",
        productCard: {
          title: "Stainless Steel Puri & Khakhra Press",
          price: "₹599",
          handle: "7149a-puri-press-maker-stainless-steel-puri-maker-press-machine-roti-chapati-presser-for-home-papad-khakhra-puri-maker-press-machine-with-handle-manual-puri-maker-medium"
        }
      },
      {
        keywords: ['bundle', 'both', 'deal', 'combo', 'ritual'],
        reply: "You can order the complete <strong>Zenkart Ritual Bundle</strong> (Both the Digital Jaap Counter + Stainless Steel Puri Press) with combined free priority air shipping for ₹1,098.",
        action: 'bundle'
      },
      {
        keywords: ['cod', 'cash', 'delivery', 'pay', 'doorstep'],
        reply: "Yes! <strong>100% Cash on Delivery (COD)</strong> is available across all Indian PIN codes. You pay ₹0 advance right now and hand cash to the courier boy only when the physical box arrives."
      },
      {
        keywords: ['shipping', 'delivery', 'charge', 'cost', 'fee', 'free', 'time', 'days', 'track', 'courier'],
        reply: "All Zenkart orders enjoy <strong>100% Free Express Shipping</strong> pan-India with zero threshold. Orders are dispatched from our central hub within 24–48 hours via BlueDart, Delhivery, or Xpressbees with live SMS tracking (3–5 business days delivery)."
      },
      {
        keywords: ['return', 'refund', 'replace', 'broken', 'damage', 'guarantee', 'warranty'],
        reply: "Every purchase includes a <strong>7-Day Hassle-Free Replacement Guarantee</strong>. If your item arrives damaged or defective in transit, simply share a quick WhatsApp photo and we dispatch an immediate brand-new replacement."
      }
    ];

    window.toggleZenkartAiChat = function() {
      const win = document.getElementById('zenkart-ai-window');
      if(!win) return;
      if (win.classList.contains('is-closed')) {
        win.classList.remove('is-closed');
        win.classList.add('is-open');
        setTimeout(() => document.getElementById('zenkart-ai-input')?.focus(), 200);
      } else {
        win.classList.remove('is-open');
        win.classList.add('is-closed');
      }
    };

    window.sendQuickPrompt = function(text) {
      const input = document.getElementById('zenkart-ai-input');
      if(input) {
        input.value = text;
        document.getElementById('zenkart-ai-form')?.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    };

    function appendMessage(sender, html, productCard = null, isBundle = false) {
      const container = document.getElementById('zenkart-ai-messages');
      if (!container) return;

      const msgDiv = document.createElement('div');
      msgDiv.style.display = 'flex';
      msgDiv.style.alignItems = 'flex-start';

      let cardHtml = '';
      if (productCard) {
        cardHtml = `
          <div style="margin-top: 10px; padding: 10px; border-radius: 12px; background: #000; border: 1px solid #333; display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <span style="font-weight: 700; color: #fff; font-size: 11px;">${productCard.title}</span>
              <span style="color: #10b981; font-weight: 700; font-size: 12px;">${productCard.price}</span>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
              <button 
                type="button" 
                onclick="window.ZenkartCart.buyNow('${productCard.handle}', 1)" 
                style="background: #fff; color: #000; font-weight: 700; padding: 6px 10px; border-radius: 8px; font-size: 10px; border: none; cursor: pointer;">
                ⚡ 1-Click Buy
              </button>
              <button 
                type="button" 
                onclick="window.ZenkartCart.add('${productCard.handle}', 1)" 
                style="background: #202020; color: #fff; border: 1px solid #333; padding: 6px 10px; border-radius: 8px; font-size: 10px; cursor: pointer;">
                🛒 Add Basket
              </button>
            </div>
          </div>
        `;
      } else if (isBundle) {
        cardHtml = `
          <div style="margin-top: 10px; padding: 10px; border-radius: 12px; background: #000; border: 1px solid #333; display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <span style="font-weight: 700; color: #fff; font-size: 11px;">Zenkart Ritual Bundle (Both)</span>
              <span style="color: #10b981; font-weight: 700; font-size: 12px;">₹1,098</span>
            </div>
            <button 
              type="button" 
              onclick="window.ZenkartCart.bundleCheckout()" 
              style="width: 100%; background: #fff; color: #000; font-weight: 700; padding: 8px 12px; border-radius: 8px; font-size: 11px; border: none; cursor: pointer;">
              ⚡ Order Complete Bundle (COD)
            </button>
          </div>
        `;
      }

      if (sender === 'user') {
        msgDiv.style.justifyContent = 'flex-end';
        msgDiv.innerHTML = `
          <div style="background: #ffffff; color: #000000; padding: 10px 14px; border-radius: 14px; border-top-right-radius: 2px; max-width: 84%; font-weight: 500;">
            ${html}
          </div>
        `;
      } else {
        msgDiv.style.justifyContent = 'flex-start';
        msgDiv.style.gap = '10px';
        msgDiv.innerHTML = `
          <div style="width: 24px; height: 24px; border-radius: 50%; background: #222; display: grid; place-items: center; font-size: 11px; flex-shrink: 0; margin-top: 2px;">✨</div>
          <div style="background: #151515; border: 1px solid #282828; padding: 12px 14px; border-radius: 14px; border-top-left-radius: 2px; max-width: 86%; color: #e5e5e5;">
            <div style="margin: 0;">${html}</div>
            ${cardHtml}
          </div>
        `;
      }

      container.appendChild(msgDiv);
      container.scrollTop = container.scrollHeight;
    }

    window.handleUserMessage = function(e) {
      e.preventDefault();
      const input = document.getElementById('zenkart-ai-input');
      const query = input?.value.trim();
      if (!query) return;

      appendMessage('user', query);
      input.value = '';

      const lower = query.toLowerCase();
      let matched = null;

      for (const item of KNOWLEDGE_BASE) {
        if (item.keywords.some(k => lower.includes(k))) {
          matched = item;
          break;
        }
      }

      setTimeout(() => {
        if (matched) {
          appendMessage('ai', matched.reply, matched.productCard || null, matched.action === 'bundle');
        } else {
          appendMessage('ai', "Both our <strong>Wooden Digital Jaap Counter</strong> (₹499) and <strong>Stainless Steel Puri Press</strong> (₹599) are in stock with 100% Free Express Shipping and Cash on Delivery. Would you like to review specs or place a direct order?", null, true);
        }
      }, 300);
    };
  })();
</script>
