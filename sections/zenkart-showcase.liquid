<style>
  .zk-theme-container {
    max-width: 1200px;
    margin: 2rem auto 4rem;
    padding: 0 1.5rem;
    font-family: inherit;
  }
  .zk-product-unit {
    background: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    margin-bottom: 3rem;
  }
  @media (max-width: 860px) {
    .zk-product-unit {
      grid-template-columns: 1fr;
      padding: 1.5rem;
      gap: 2rem;
    }
  }
  .zk-unit-gallery {
    background: #FAF8F5;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
  }
  .zk-display-img {
    width: 100%;
    height: 380px;
    object-fit: contain;
  }
  .zk-thumb-cluster {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.25rem;
  }
  .zk-thumb-node {
    width: 60px;
    height: 60px;
    border: 2px solid #E4E4E7;
    border-radius: 6px;
    object-fit: cover;
    background: #FFFFFF;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .zk-thumb-node.active, .zk-thumb-node:hover {
    border-color: #5B21B6;
  }
  .zk-unit-details {
    display: flex;
    flex-direction: column;
  }
  .zk-kicker-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #5B21B6;
    margin-bottom: 0.4rem;
  }
  .zk-product-title {
    font-size: clamp(1.5rem, 2.2vw, 1.95rem);
    font-weight: 800;
    line-height: 1.2;
    color: #18181B;
    margin-bottom: 0.85rem;
  }
  .zk-pricing-line {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 1.25rem;
  }
  .zk-sale-tag {
    font-size: 1.9rem;
    font-weight: 800;
    color: #18181B;
  }
  .zk-cross-tag {
    font-size: 1.15rem;
    color: #A1A1AA;
    text-decoration: line-through;
  }
  .zk-discount-pill {
    font-size: 0.75rem;
    font-weight: 700;
    background: #DCFCE7;
    color: #15803D;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .zk-lead-description {
    color: #52525B;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .zk-specs-list {
    border-top: 1px solid #E4E4E7;
    border-bottom: 1px solid #E4E4E7;
    padding: 1rem 0;
    margin-bottom: 1.75rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .zk-specs-list li {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
  }
  .zk-specs-list li span:first-child { color: #52525B; }
  .zk-specs-list li span:last-child { font-weight: 700; color: #18181B; }
  .zk-solid-cta {
    display: inline-block;
    text-align: center;
    background: #5B21B6;
    color: #FFFFFF;
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
    width: fit-content;
    transition: background 0.15s ease;
  }
  .zk-solid-cta:hover { background: #4C1D95; }
  .zk-green-cta { background: #15803D; }
  .zk-green-cta:hover { background: #166534; }
</style>

<script>
  function zkSwap(mainId, thumbEl) {
    document.getElementById(mainId).src = thumbEl.src;
    const parent = thumbEl.parentElement;
    parent.querySelectorAll('.zk-thumb-node').forEach(b => b.classList.remove('active'));
    thumbEl.classList.add('active');
  }
</script>

