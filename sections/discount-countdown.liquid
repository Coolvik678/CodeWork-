<!-- sections/discount-countdown.liquid -->
<!-- Clean, High-Converting Best Offers & Deals Banner -->
<section id="best-offers-banner" class="relative py-12 sm:py-16 px-4 sm:px-8 lg:px-12 bg-[#0c0d12] text-white border-y border-[#262626] overflow-hidden">
  
  <!-- Subtle Festive Diwali Light Backdrop -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber-500/10 via-black to-black pointer-events-none"></div>

  <div class="relative z-10 max-w-4xl mx-auto text-center cursor-pointer" onclick="openBundleSelectorModal()">
    
    <!-- Eyebrow Pill -->
    <div class="inline-flex items-center gap-2 bg-[#1a1711] border border-amber-500/40 text-amber-400 text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4 shadow-lg shadow-amber-500/5 hover:border-amber-400 transition">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
      <span>💥 BOOM OFFER ACTIVE • FLAT ₹50 OFF ON EVERYTHING</span>
    </div>

    <!-- Main Title -->
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-black text-white tracking-tight mb-3 leading-tight">
      Best Offers &amp; Value Bundles
    </h2>

    <!-- Subtitle -->
    <p class="text-sm sm:text-base text-gray-300 max-w-xl mx-auto mb-8 leading-relaxed font-sans">
      Enjoy instant <strong>Flat ₹50 OFF</strong> on single orders (Jaap @ ₹449, Puri @ ₹549) or unlock maximum savings with our exclusive <strong>Buy 2 &amp; Buy 3 combos</strong>. Free Express Cash on Delivery pan-India!
    </p>

    <!-- Quick Offer Highlights Pill Bar -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-8 text-xs">
      <div class="bg-black/60 border border-white/10 px-4 py-2 rounded-xl flex items-center gap-2">
        <span>🕉️</span>
        <span class="text-gray-300">Jaap Counter:</span>
        <strong class="text-amber-400">₹449</strong>
        <span class="text-[10px] bg-amber-400/20 text-amber-300 px-1.5 py-0.5 rounded font-bold">₹50 OFF</span>
        <span class="text-gray-500">•</span>
        <span class="text-gray-400">Buy 2 @ ₹899</span>
      </div>
      <div class="bg-black/60 border border-white/10 px-4 py-2 rounded-xl flex items-center gap-2">
        <span>🥟</span>
        <span class="text-gray-300">Puri Press:</span>
        <strong class="text-amber-400">₹549</strong>
        <span class="text-[10px] bg-amber-400/20 text-amber-300 px-1.5 py-0.5 rounded font-bold">₹50 OFF</span>
        <span class="text-gray-500">•</span>
        <span class="text-gray-400">Buy 2 @ ₹999</span>
      </div>
    </div>

    <!-- Pulsing Diwali Button -->
    <div class="max-w-md mx-auto">
      <button 
        type="button" 
        onclick="event.stopPropagation(); openBundleSelectorModal()"
        class="w-full btn-diwali-glow py-4 px-8 rounded-xl font-black text-sm uppercase tracking-wider text-black flex items-center justify-center gap-2.5 cursor-pointer shadow-2xl transition hover:scale-105 active:scale-95">
        <span class="text-base">⚡</span>
        <span>VIEW BEST OFFERS &amp; BUNDLE DEALS</span>
        <span class="text-base">→</span>
      </button>
      <div class="flex items-center justify-center gap-3 text-[11px] text-gray-400 mt-3">
        <span>✓ Cash on Delivery</span>
        <span>•</span>
        <span>✓ 100% Free Delivery</span>
        <span>•</span>
        <span>✓ 7-Day Replacement</span>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Best Offers Banner",
  "settings": []
}
{% endschema %}
