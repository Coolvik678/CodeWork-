  .zenkart-typing-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #888;
    margin: 0 2px;
    animation: zenkartTyping 1.4s infinite ease-in-out both;
  }
  .zenkart-typing-dot:nth-child(1) { animation-delay: -0.32s; }
  .zenkart-typing-dot:nth-child(2) { animation-delay: -0.16s; }

  @keyframes zenkartTyping {
