<!-- sections/product-catalog-detail.liquid -->
{%- liquid
  assign is_puri = false
  if product.handle contains 'puri' or product.handle contains 'roti'
    assign is_puri = true
  endif

  if is_puri
    assign current_title = product.title | default: "Stainless Steel Heavy Duty Puri & Khakhra Press Maker"
    assign current_price_num = 549
    assign compare_price_num = 599
    assign discount_pct = "💥 ₹50 OFF"
    assign breadcrumb_cat = "Artisanal Kitchen Tools"
    assign stock_left = 19
    assign review_count = 241
    assign rating_val = "4.8"
  else
    assign current_title = product.title | default: "Wooden Digital Jaap Counter With Compass (1 Pc)"
    assign current_price_num = 449
    assign compare_price_num = 499
    assign discount_pct = "💥 ₹50 OFF"
    assign breadcrumb_cat = "Devotional & Meditation"
    assign stock_left = 14
    assign review_count = 184
    assign rating_val = "4.9"
  endif
-%}

<style>
  @keyframes diwaliPulse {
    0%, 100% {
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.45), 0 0 25px rgba(217, 119, 6, 0.2), 0 4px 12px rgba(0, 0, 0, 0.7);
      border-color: rgba(251, 191, 36, 0.6);
    }
    50% {
      box-shadow: 0 0 28px rgba(245, 158, 11, 0.9), 0 0 50px rgba(251, 191, 36, 0.5), 0 6px 20px rgba(0, 0, 0, 0.9);
      border-color: rgba(254, 243, 199, 1);
    }
  }

  .btn-diwali-glow {
    position: relative !important;
    background: #ffffff !important;
    color: #000000 !important;
    border: 2px solid rgba(251, 191, 36, 0.7) !important;
    animation: diwaliPulse 1.8s ease-in-out infinite !important;
    transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  }
  .btn-diwali-glow:hover {
    transform: scale(1.02) !important;
  }

  .bundle-tier-card {
    cursor: pointer;
    border: 1px solid #2a2a2a;
    background: #141414;
    transition: all 0.2s ease;
  }
  .bundle-tier-card:hover {
    border-color: #444;
    background: #191919;
  }
  .bundle-tier-card.is-selected {
    border-color: #f59e0b !important;
    background: rgba(245, 158, 11, 0.08) !important;
    box-shadow: 0 0 18px rgba(245, 158, 11, 0.25) !important;
  }

  /* Amazon / Flipkart Swipe Slider Track */
  #catalog-gallery-viewport {
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  #catalog-gallery-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.32s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .gallery-slide-item {
    min-width: 100%;
    width: 100%;
    height: 100%;
    flex-shrink: 0;
  }
</style>

<div class="bg-black text-[#f5f5f5] min-h-screen py-10 px-4 sm:px-8 lg:px-12 border-b border-[#222222]">
  <div class="max-w-[1400px] mx-auto">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-white/50 mb-8 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-white transition">Home</a>
      <span>/</span>
      <a href="/#featured-catalog" class="hover:text-white transition">Catalogue</a>
      <span>/</span>
      <span class="text-white/40">{{ breadcrumb_cat }}</span>
      <span>/</span>
      <span class="text-white font-medium truncate max-w-xs">{{ current_title }}</span>
    </nav>

    <!-- Main Product Grid: Gallery (Left) & Purchasing Funnel (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start mb-16">
      
      <!-- LEFT: High-Res Interactive Gallery with Touch Swipe (7 cols on lg) -->
      <div class="lg:col-span-7 space-y-4 lg:sticky lg:top-28">
        
        <!-- Amazon/Flipkart Touch/Hand Sliding Image Carousel -->
        <div 
          id="catalog-gallery-viewport" 
          class="relative w-full aspect-square bg-[#0c0c0c] rounded-2xl overflow-hidden border border-[#222] shadow-2xl cursor-grab active:cursor-grabbing">
          
          <!-- Image Slide Track -->
          <div id="catalog-gallery-track">
            {% if is_puri %}
              <!-- Slide 1 -->
              <div class="gallery-slide-item relative flex items-center justify-center bg-[#090909]">
                <img src="{{ 'forge-puri-maker.jpg' | asset_url }}" alt="Stainless Steel Puri Press Machine Studio View" class="w-full h-full object-cover pointer-events-none" loading="eager">
              </div>
              <!-- Slide 2 -->
              <div class="gallery-slide-item relative flex items-center justify-center bg-[#090909]">
                <img src="{{ 'forge-puri-press.jpg' | asset_url }}" alt="Puri Press Base and Lever View" class="w-full h-full object-cover pointer-events-none" loading="lazy">
              </div>
              <!-- Slide 3 -->
              <div class="gallery-slide-item relative flex items-center justify-center bg-[#090909]">
                <img src="{{ 'puri-action.jpg' | asset_url }}" alt="Fresh Puri Making in Action" class="w-full h-full object-cover pointer-events-none" loading="lazy">
              </div>
              <!-- Slide 4 -->
              <div class="gallery-slide-item relative flex items-center justify-center bg-[#090909]">
                <img src="{{ 'puri-wukusy-1.jpg' | asset_url }}" alt="Heavy Duty Food Grade SUS-304 Steel" class="w-full h-full object-cover pointer-events-none" loading="lazy">
              </div>
              <!-- Slide 5 -->
              <div class="gallery-slide-item relative flex items-center justify-center bg-[#090909]">
                <img src="{{ 'puri-wukusy-3.jpg' | asset_url }}" alt="Anti-Skid Base and Smooth Handle" class="w-full h-full object-cover pointer-events-none" loading="lazy">
              </div>
            {% else %}
              <!-- Slide 1 -->
              <div class="gallery-slide-item relative flex items-center justify-center bg-[#090909]">
                <img src="{{ 'forge-jaap-counter.jpg' | asset_url }}" alt="Wooden Digital Mantra Jaap Counter With Compass" class="w-full h-full object-cover pointer-events-none" loading="eager">
              </div>
              <!-- Slide 2 -->
              <div class="gallery-slide-item relative flex items-center justify-center bg-[#090909]">
                <img src="{{ 'jaap-action.jpg' | asset_url }}" alt="Devotional Jaap in Palm View" class="w-full h-full object-cover pointer-events-none" loading="lazy">
              </div>
              <!-- Slide 3 -->
              <div class="gallery-slide-item relative flex items-center justify-center bg-[#090909]">
                <img src="{{ 'tally-infographic-1.webp' | asset_url }}" alt="5-Digit LCD Display and Scroll Wheel Features" class="w-full h-full object-contain bg-black pointer-events-none" loading="lazy">
              </div>
              <!-- Slide 4 -->
              <div class="gallery-slide-item relative flex items-center justify-center bg-[#090909]">
                <img src="{{ 'tally-infographic-2.webp' | asset_url }}" alt="Adjustable Finger Ring and One Touch Reset Guide" class="w-full h-full object-contain bg-black pointer-events-none" loading="lazy">
              </div>
              <!-- Slide 5 -->
              <div class="gallery-slide-item relative flex items-center justify-center bg-[#090909]">
                <img src="{{ 'tally-counter-main.jpg' | asset_url }}" alt="Packaging and Sacred Silk Tassel" class="w-full h-full object-cover pointer-events-none" loading="lazy">
              </div>
            {% endif %}
          </div>

          <!-- Badges Overlay (Top Left) -->
          <div class="absolute top-4 left-4 flex flex-col gap-2 pointer-events-none z-20">
            <span class="bg-white text-black font-extrabold text-[11px] uppercase tracking-wider px-3 py-1 rounded shadow">
              {{ discount_pct }}
            </span>
            <span class="bg-black/80 backdrop-blur-md border border-[#333] text-white text-[11px] font-medium px-3 py-1 rounded-full flex items-center gap-1.5 shadow">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              In Stock: Only {{ stock_left }} Units Left
            </span>
          </div>

          <!-- Counter Pill (Top Right - Amazon/Flipkart style e.g. 1 / 5) -->
          <div class="absolute top-4 right-4 z-20 pointer-events-none">
            <span id="gallery-counter-pill" class="bg-black/80 backdrop-blur-md border border-white/20 text-white text-xs font-mono font-bold px-3 py-1 rounded-full shadow-lg">
              1 / 5
            </span>
          </div>

          <!-- Left Navigation Arrow Chevron -->
          <button 
            type="button" 
            onclick="prevCatalogSlide()" 
            aria-label="Previous image" 
            class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-black/65 hover:bg-black text-white border border-white/20 flex items-center justify-center backdrop-blur-md shadow-2xl transition-transform active:scale-90 z-20 cursor-pointer">
            <span class="text-xl font-bold">‹</span>
          </button>

          <!-- Right Navigation Arrow Chevron -->
          <button 
            type="button" 
            onclick="nextCatalogSlide()" 
            aria-label="Next image" 
            class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-black/65 hover:bg-black text-white border border-white/20 flex items-center justify-center backdrop-blur-md shadow-2xl transition-transform active:scale-90 z-20 cursor-pointer">
            <span class="text-xl font-bold">›</span>
          </button>

          <!-- Floating Swipe Tip (Bottom Center/Right) -->
          <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 pointer-events-none flex items-center gap-1.5 bg-black/75 backdrop-blur-md border border-white/10 px-3 py-1 rounded-full text-[11px] text-white/80">
            <span>👆 Swipe hand to slide images</span>
          </div>
        </div>

        <!-- Thumbnail Strip With Instant Slide Switch -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-[11px] text-white/50 font-medium tracking-wide">
            <span>ALL PRODUCT ANGLES &amp; SPEC SHEETS:</span>
            <span class="text-amber-400">Click or swipe to switch</span>
          </div>

          <div id="catalog-thumbnail-strip" class="flex items-center gap-2.5 overflow-x-auto pb-2 scrollbar-thin">
            {% if is_puri %}
              <button type="button" onclick="goToSlide(0)" class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border-2 border-white opacity-100 bg-[#111] transition-all">
                <img src="{{ 'forge-puri-maker.jpg' | asset_url }}" alt="Studio Angle" class="w-full h-full object-cover">
              </button>
              <button type="button" onclick="goToSlide(1)" class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-60 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'forge-puri-press.jpg' | asset_url }}" alt="Press Angle" class="w-full h-full object-cover">
              </button>
              <button type="button" onclick="goToSlide(2)" class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-60 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'puri-action.jpg' | asset_url }}" alt="Action Shot" class="w-full h-full object-cover">
              </button>
              <button type="button" onclick="goToSlide(3)" class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-60 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'puri-wukusy-1.jpg' | asset_url }}" alt="Factory Steel" class="w-full h-full object-cover">
              </button>
              <button type="button" onclick="goToSlide(4)" class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-60 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'puri-wukusy-3.jpg' | asset_url }}" alt="Anti-Skid Base" class="w-full h-full object-cover">
              </button>
            {% else %}
              <button type="button" onclick="goToSlide(0)" class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border-2 border-white opacity-100 bg-[#111] transition-all">
                <img src="{{ 'forge-jaap-counter.jpg' | asset_url }}" alt="Devotional Studio" class="w-full h-full object-cover">
              </button>
              <button type="button" onclick="goToSlide(1)" class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-60 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'jaap-action.jpg' | asset_url }}" alt="Hand Chanting" class="w-full h-full object-cover">
              </button>
              <button type="button" onclick="goToSlide(2)" class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-60 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'tally-infographic-1.webp' | asset_url }}" alt="5-Digit Screen" class="w-full h-full object-cover">
              </button>
              <button type="button" onclick="goToSlide(3)" class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-60 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'tally-infographic-2.webp' | asset_url }}" alt="Finger Ring Reset" class="w-full h-full object-cover">
              </button>
              <button type="button" onclick="goToSlide(4)" class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-60 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'tally-counter-main.jpg' | asset_url }}" alt="Sacred Tassel" class="w-full h-full object-cover">
              </button>
            {% endif %}
          </div>
        </div>

      </div>

      <!-- RIGHT: E-Commerce Conversion Box (5 cols on lg) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Priority Dispatch Badge -->
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 bg-[#141414] border border-[#2a2a2a] text-white/90 text-[11px] font-semibold px-3 py-1 rounded-full">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Zenkart Priority Dispatch
          </span>
          <span class="text-white/50 text-xs">Dispatch in 24–48 Hrs</span>
        </div>

        <!-- Title -->
        <div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-white leading-tight">
            {{ current_title }}
          </h1>

          <!-- Rating -->
          <div class="flex items-center gap-2 mt-3 text-xs">
            <div class="flex text-amber-400">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
            <span class="font-bold text-white">{{ rating_val }}</span>
            <span class="text-white/50">({{ review_count }} Verified Indian Deliveries)</span>
          </div>
        </div>

        <!-- Pricing Card -->
        <div class="bg-[#0f0f0f] p-4 rounded-xl border border-[#222]">
          <div class="flex items-baseline gap-3">
            <span class="text-3xl sm:text-4xl font-bold text-white">₹{{ current_price_num }}</span>
            <span class="text-lg line-through text-white/40">₹{{ compare_price_num }}</span>
            <span class="bg-emerald-950/40 border border-emerald-800/40 text-emerald-400 text-xs font-bold px-2.5 py-0.5 rounded">
              {{ discount_pct }}
            </span>
          </div>
          <div class="flex items-center justify-between mt-2 pt-2 border-t border-[#1e1e1e] text-[11px] text-white/50">
            <span>Inclusive of all GST &amp; Taxes</span>
            <span class="text-emerald-400 font-semibold">✓ Free Pan-India Delivery</span>
          </div>
        </div>

        <!-- Special Deal Alert -->
        <div class="bg-[#141414] border border-[#282828] rounded-xl p-3 flex items-center justify-between text-xs text-white">
          <div class="flex items-center gap-2">
            <span class="text-base">🏷️</span>
            <span><strong>Special Offer:</strong> Buy 2, Get Extra 10% Off</span>
          </div>
          <span class="font-mono text-white text-[11px] bg-black px-2 py-0.5 rounded border border-[#333]">ZEN10</span>
        </div>

        <!-- PIN Code Estimator -->
        <div class="bg-[#0f0f0f] p-4 rounded-xl border border-[#222] text-xs">
          <label for="pincode-catalog" class="block text-[11px] font-semibold text-white/60 uppercase tracking-wider mb-2">
            Check Express Delivery Date &amp; COD Availability:
          </label>
          <div class="flex gap-2">
            <input 
              type="text" 
              id="pincode-catalog" 
              maxlength="6" 
              placeholder="Enter 6-Digit Indian PIN code" 
              class="flex-1 bg-black border border-[#2a2a2a] rounded-lg px-3 py-2 text-xs text-white placeholder:text-white/30 focus:outline-none focus:border-white transition">
            <button 
              type="button" 
              onclick="checkPincodeDelivery('pincode-catalog', 'pincode-catalog-res')" 
              class="bg-[#1c1c1c] hover:bg-white hover:text-black border border-[#333] text-white font-medium text-xs px-4 py-2 rounded-lg transition cursor-pointer">
              Check PIN
            </button>
          </div>
          <div id="pincode-catalog-res" class="mt-2.5 text-xs hidden"></div>
        </div>

        <!-- Quantity & Special Bundle Offers -->
        <div class="space-y-3.5 pt-2">
          
          <div class="flex items-center justify-between text-xs">
            <span class="text-white/80 font-bold uppercase tracking-wider text-[11px]">Choose Your Value Bundle:</span>
            <span class="text-emerald-400 font-semibold text-[11px]">Free Air Delivery</span>
          </div>

          <!-- 3-Tier Multi-Pack Selection Cards -->
          <div class="space-y-2.5">
            {% if is_puri %}
              <!-- Puri Maker: Tier 1 (1 pc @ ₹549 - ₹50 OFF) -->
              <div id="detail-tier-1" onclick="selectDetailTier(1, 549)" class="bundle-tier-card p-3 rounded-xl flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <input type="radio" name="detail-bundle-tier" id="detail-radio-1" class="accent-amber-400 w-4 h-4 cursor-pointer">
                  <div>
                    <div class="font-bold text-white text-xs flex items-center gap-1.5">
                      <span>Buy 1 Piece (Standard)</span>
                      <span class="text-[9px] text-amber-400 font-bold bg-amber-400/10 border border-amber-400/30 px-1.5 py-0.2 rounded">💥 ₹50 OFF</span>
                    </div>
                    <div class="text-[10px] text-white/50">Personal kitchen use</div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-white text-sm">₹549</div>
                  <div class="text-[10px] text-white/40 line-through">₹599</div>
                </div>
              </div>

              <!-- Puri Maker: Tier 2 (2 pcs @ ₹999) - PRESELECTED & HIGHLIGHTED -->
              <div id="detail-tier-2" onclick="selectDetailTier(2, 999)" class="bundle-tier-card is-selected p-3 rounded-xl flex items-center justify-between relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-gradient-to-r from-amber-400 to-amber-500 text-black font-extrabold text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-bl-lg shadow">
                  🔥 Most Bought • Best Value
                </div>
                <div class="flex items-center gap-3 mt-1">
                  <input type="radio" name="detail-bundle-tier" id="detail-radio-2" checked class="accent-amber-400 w-4 h-4 cursor-pointer">
                  <div>
                    <div class="font-bold text-white text-xs flex items-center gap-1.5">
                      <span>Buy 2 Pieces</span>
                      <span class="text-[10px] text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-800/60 px-1.5 py-0.2 rounded">Save Extra ₹199</span>
                    </div>
                    <div class="text-[10px] text-amber-300 mt-0.5 font-medium">Recommended for Home &amp; Gifting</div>
                  </div>
                </div>
                <div class="text-right mt-1">
                  <div class="font-bold text-amber-400 text-base">₹999</div>
                  <div class="text-[10px] text-white/40 line-through">₹1,198</div>
                </div>
              </div>

              <!-- Puri Maker: Tier 3 (3 pcs @ ₹1,399) -->
              <div id="detail-tier-3" onclick="selectDetailTier(3, 1399)" class="bundle-tier-card p-3 rounded-xl flex items-center justify-between relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-[#252525] border-b border-l border-[#3a3a3a] text-emerald-400 font-bold text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-bl-lg">
                  Max Savings
                </div>
                <div class="flex items-center gap-3 mt-1">
                  <input type="radio" name="detail-bundle-tier" id="detail-radio-3" class="accent-amber-400 w-4 h-4 cursor-pointer">
                  <div>
                    <div class="font-bold text-white text-xs flex items-center gap-1.5">
                      <span>Buy 3 Pieces</span>
                      <span class="text-[10px] text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-800/60 px-1.5 py-0.2 rounded">Save Extra ₹398</span>
                    </div>
                    <div class="text-[10px] text-white/50 mt-0.5">Joint Family &amp; Festival Prep</div>
                  </div>
                </div>
                <div class="text-right mt-1">
                  <div class="font-bold text-white text-sm">₹1,399</div>
                  <div class="text-[10px] text-white/40 line-through">₹1,797</div>
                </div>
              </div>

            {% else %}
              <!-- Jaap Counter: Tier 1 (1 pc @ ₹449 - ₹50 OFF) -->
              <div id="detail-tier-1" onclick="selectDetailTier(1, 449)" class="bundle-tier-card p-3 rounded-xl flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <input type="radio" name="detail-bundle-tier" id="detail-radio-1" class="accent-amber-400 w-4 h-4 cursor-pointer">
                  <div>
                    <div class="font-bold text-white text-xs flex items-center gap-1.5">
                      <span>Buy 1 Piece (Standard)</span>
                      <span class="text-[9px] text-amber-400 font-bold bg-amber-400/10 border border-amber-400/30 px-1.5 py-0.2 rounded">💥 ₹50 OFF</span>
                    </div>
                    <div class="text-[10px] text-white/50">Personal mantra jaap practice</div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-white text-sm">₹449</div>
                  <div class="text-[10px] text-white/40 line-through">₹499</div>
                </div>
              </div>

              <!-- Jaap Counter: Tier 2 (2 pcs @ ₹899) - PRESELECTED & HIGHLIGHTED -->
              <div id="detail-tier-2" onclick="selectDetailTier(2, 899)" class="bundle-tier-card is-selected p-3 rounded-xl flex items-center justify-between relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-gradient-to-r from-amber-400 to-amber-500 text-black font-extrabold text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-bl-lg shadow">
                  🔥 Most Bought • Best Value
                </div>
                <div class="flex items-center gap-3 mt-1">
                  <input type="radio" name="detail-bundle-tier" id="detail-radio-2" checked class="accent-amber-400 w-4 h-4 cursor-pointer">
                  <div>
                    <div class="font-bold text-white text-xs flex items-center gap-1.5">
                      <span>Buy 2 Pieces</span>
                      <span class="text-[10px] text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-800/60 px-1.5 py-0.2 rounded">Save Extra ₹99</span>
                    </div>
                    <div class="text-[10px] text-amber-300 mt-0.5 font-medium">For You &amp; Devotional Gifting</div>
                  </div>
                </div>
                <div class="text-right mt-1">
                  <div class="font-bold text-amber-400 text-base">₹899</div>
                  <div class="text-[10px] text-white/40 line-through">₹998</div>
                </div>
