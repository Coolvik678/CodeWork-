    <script>
      (function(){
        const root = document.querySelector('#shopify-section-before-after-slider_o0bzrq [data-aba]');
        if(!root) return;

        const compare = root.querySelector('[data-aba-compare]');
        const range = root.querySelector('.aba-range');
        if(!compare) return;

        let isDragging = false;
        let activePointerId = null;

        function updatePosition(clientX) {
          const rect = compare.getBoundingClientRect();
          if(!rect.width) return;
          const offsetX = Math.max(0, Math.min(rect.width, clientX - rect.left));
          const pct = Math.round((offsetX / rect.width) * 1000) / 10;
          compare.style.setProperty('--aba-pos', pct + '%');
          if(range) range.value = pct;
        }

        compare.addEventListener('pointerdown', function(e) {
          isDragging = true;
          activePointerId = e.pointerId;
          compare.classList.add('is-dragging');
          if (compare.setPointerCapture) {
            try { compare.setPointerCapture(e.pointerId); } catch(_) {}
          }
          updatePosition(e.clientX);
          e.preventDefault();
        }, { passive: false });

        compare.addEventListener('pointermove', function(e) {
          if (!isDragging) return;
          updatePosition(e.clientX);
        }, { passive: true });

        function stopDrag(e) {
          if (!isDragging) return;
          isDragging = false;
          compare.classList.remove('is-dragging');
          if (compare.releasePointerCapture && activePointerId !== null) {
            try { compare.releasePointerCapture(activePointerId); } catch(_) {}
          }
          activePointerId = null;
        }

        compare.addEventListener('pointerup', stopDrag, { passive: true });
        compare.addEventListener('pointercancel', stopDrag, { passive: true });

        // Keyboard arrow support
        compare.setAttribute('tabindex', '0');
        compare.addEventListener('keydown', function(e) {
          let cur = parseFloat(compare.style.getPropertyValue('--aba-pos')) || 50;
          if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
            const next = Math.max(0, cur - (e.shiftKey ? 10 : 2));
            compare.style.setProperty('--aba-pos', next + '%');
            if(range) range.value = next;
            e.preventDefault();
          } else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
            const next = Math.min(100, cur + (e.shiftKey ? 10 : 2));
            compare.style.setProperty('--aba-pos', next + '%');
            if(range) range.value = next;
            e.preventDefault();
          }
        });

        // Sync initial state
        compare.style.setProperty('--aba-pos', '50%');
      })();
    </script>
