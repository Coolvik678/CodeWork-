<!-- snippets/offer-boom-modal.liquid -->
<!-- High-Impact BOOM Festive Offer Modal & Animation -->
<style>
  /* Shockwave blast rings */
  @keyframes boomShockwave {
    0% {
      transform: scale(0.1);
      opacity: 0.95;
      box-shadow: 0 0 20px #f59e0b, 0 0 40px #ef4444;
    }
    50% {
      opacity: 0.6;
    }
    100% {
      transform: scale(3.5);
      opacity: 0;
      box-shadow: 0 0 100px #f59e0b, 0 0 160px #ef4444;
    }
  }

  /* Explosive particle sparks */
  @keyframes sparkBurst {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 1;
    }
    100% {
      transform: translate(var(--tx), var(--ty)) scale(0);
      opacity: 0;
    }
  }

  /* Card entrance punch */
  @keyframes boomCardPop {
    0% {
      transform: scale(0.2) rotate(-4deg);
      opacity: 0;
      filter: brightness(2.5);
    }
    60% {
      transform: scale(1.05) rotate(1deg);
      opacity: 1;
      filter: brightness(1.3);
    }
    85% {
      transform: scale(0.97) rotate(0deg);
      filter: brightness(1.1);
    }
    100% {
      transform: scale(1) rotate(0deg);
      opacity: 1;
      filter: brightness(1);
    }
  }

  /* Diwali golden aura */
  @keyframes diwaliAura {
    0%, 100% {
      box-shadow: 0 0 25px rgba(245, 158, 11, 0.35), 0 0 60px rgba(239, 68, 68, 0.2), 0 20px 50px rgba(0, 0, 0, 0.95);
      border-color: rgba(251, 191, 36, 0.6);
    }
    50% {
      box-shadow: 0 0 50px rgba(245, 158, 11, 0.75), 0 0 100px rgba(239, 68, 68, 0.45), 0 25px 60px rgba(0, 0, 0, 1);
      border-color: rgba(254, 243, 199, 1);
    }
  }

  /* Floating trigger pill pulse */
  @keyframes boomFloatingPulse {
    0%, 100% {
      transform: translateY(0) scale(1);
      box-shadow: 0 8px 25px rgba(245, 158, 11, 0.35);
    }
    50% {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 12px 35px rgba(245, 158, 11, 0.65);
    }
  }

  .boom-card-anim {
    animation: boomCardPop 0.65s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  .boom-shockwave-ring {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 3px solid rgba(245, 158, 11, 0.85);
    pointer-events: none;
    animation: boomShockwave 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
  }
  .boom-shockwave-ring:nth-child(2) {
    animation-delay: 0.15s;
    border-color: rgba(239, 68, 68, 0.75);
  }
  .boom-shockwave-ring:nth-child(3) {
    animation-delay: 0.3s;
    border-color: rgba(251, 191, 36, 0.9);
  }

  .boom-particle {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    pointer-events: none;
    animation: sparkBurst 0.9s ease-out forwards;
  }

  #boom-floating-trigger {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 999998;
    background: #0e0e0e;
    color: #fff;
    border: 1px solid rgba(245, 158, 11, 0.7);
    padding: 10px 18px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    user-select: none;
    animation: boomFloatingPulse 2.4s ease-in-out infinite;
    transition: all 0.2s ease;
  }
  #boom-floating-trigger:hover {
    transform: scale(1.06);
    background: #181818;
    border-color: #fbbf24;
  }
</style>

