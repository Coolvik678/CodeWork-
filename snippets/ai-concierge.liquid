<script>
  (function(){
    // Context memory for ongoing conversation
    const CONTEXT = {
      lastTopic: null, // 'jaap', 'puri', 'bundle', 'cod', 'shipping', 'guarantee'
      turnCount: 0
    };

    // Product specifications catalog
    const PRODUCTS = {
      jaap: {
        title: "Wooden Digital Jaap Counter",
        handle: "wooden-digital-tasbih-counter-handheld-lcd-mantra-jaap-counter-with-compass-1-pc",
        priceSingle: "₹499",
        bundle2: "₹899",
        bundle3: "₹1,199",
        badge: "Spiritual Best Seller • 184 Verified Reviews (4.9★)"
      },
      puri: {
        title: "Stainless Steel Puri & Khakhra Press",
        handle: "7149a-puri-press-maker-stainless-steel-puri-maker-press-machine-roti-chapati-presser-for-home-papad-khakhra-puri-maker-press-machine-with-handle-manual-puri-maker-medium",
        priceSingle: "₹599",
        bundle2: "₹999",
        bundle3: "₹1,399",
        badge: "Kitchen Favorite • 241 Verified Reviews (4.8★)"
      }
    };

    // Conversation intents & smart NLP parser
    function generateSmartResponse(rawQuery) {
      const q = rawQuery.toLowerCase().trim();
      const tokens = q.replace(/[^\w\s]/g, ' ').split(/\s+/).filter(Boolean);

      function hasAny(...words) {
        return words.some(w => q.includes(w));
      }
      function hasAll(...words) {
        return words.every(w => q.includes(w));
      }

      // 1. GREETINGS & PLEASANTRIES (Fixes the "hello gives prompted message" issue!)
      if (hasAny('hello', 'hi', 'hey', 'namaste', 'pranam', 'pranaam', 'good morning', 'good afternoon', 'good evening', 'yo', 'wassup', 'hola', 'kem cho', 'salaam', 'ram ram', 'radhe radhe', 'hare krishna')) {
        const hour = new Date().getHours();
        const timeGreeting = hour < 12 ? "Good morning" : (hour < 17 ? "Good afternoon" : "Good evening");
        
        const greetings = [
          `Namaste & ${timeGreeting}! 🙏 Wonderful to have you at Zenkart. How can I help you today? Looking for our <strong>Wooden Jaap Counter</strong>, our <strong>Stainless Steel Puri Press</strong>, or our exclusive combo bundle deals?`,
          `Hello! Welcome to Zenkart. ✨ I'm Zen-AI. Whether you're curious about daily meditation rituals, quick kitchen tools, or want to check Cash on Delivery to your PIN code, I'm here to help. What's on your mind?`,
          `Hey there! Hope you're having a blessed day. 🌸 How may I assist your shopping today? Feel free to ask about product specs, customer reviews, or our Buy 2/Buy 3 special offers!`
        ];
        
        return {
          text: greetings[Math.floor(Math.random() * greetings.length)],
          chips: ['📿 Jaap Counter Specs', '🥟 Puri Press Details', '🎁 View Best Offers', '🚚 COD & Shipping']
        };
      }

      // 2. ASSISTANT IDENTITY / CAPABILITIES
      if (hasAny('who are you', 'what are you', 'your name', 'are you ai', 'are you a bot', 'are you human', 'what can you do', 'what do you do', 'help me')) {
        return {
          text: "I am <strong>Zen-AI</strong>, an intelligent assistant built specifically for Zenkart shoppers! 🤖✨<br><br>Here is what I can do for you:<br>• <strong>Product Guidance:</strong> Explain dimensions, materials, and usage tips for our Jaap Counter and Puri Press.<br>• <strong>Smart Pricing &amp; Bundles:</strong> Show you how to save up to ₹398 with our Buy 2 &amp; Buy 3 combos.<br>• <strong>COD &amp; Pin Code Check:</strong> Confirm zero-advance Cash on Delivery terms.<br>• <strong>Chef &amp; Ritual Pro-Tips:</strong> Provide tips on non-stick puri pressing and silent meditation chanting.<br><br>What would you like to explore first?",
          chips: ['🥟 How to use Puri Press', '📿 Jaap Counter battery', '🎁 Combo savings', '💬 WhatsApp Support']
        };
      }

      // 3. SMALL TALK / MOOD
      if (hasAny('how are you', 'how r u', 'how do you do', 'how is it going', 'whats up', 'what\'s up', 'sup')) {
        return {
          text: "I'm doing fantastic, thank you for asking! 😊 Fully ready to assist your spiritual and kitchen needs. Are you looking to pick up a single item or take advantage of our multi-item combo discounts today?",
          chips: ['🎁 Show Combo Deals', '📿 Jaap Counter ₹499', '🥟 Puri Press ₹599']
        };
      }

      // 4. GRATITUDE / POSITIVE FEEDBACK
      if (hasAny('thank', 'thanks', 'thx', 'dhanyawad', 'shukriya', 'great', 'awesome', 'nice', 'perfect', 'super', 'mast', 'cool', 'good job')) {
        return {
          text: "You're very welcome! Glad I could help. 🙏 Is there anything else you'd like to check—such as our 7-day replacement guarantee or delivery timelines?",
          chips: ['🚚 Delivery time', '🛡️ Replacement guarantee', '🎁 View Best Offers']
        };
      }

      // 5. FAREWELL
      if (hasAny('bye', 'goodbye', 'see you', 'cya', 'tata', 'good night', 'gn')) {
        return {
          text: "Goodbye! Wishing you a peaceful, joyful, and prosperous day ahead. Whenever you need assistance with Zenkart orders, I'll be right here. Take care! 🙏✨",
          chips: ['✨ Reopen Chat', '🎁 View Combos']
