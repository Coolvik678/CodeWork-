      --hp-radius: var(--style-border-radius-cards);
    }

    /* Stars */
    .wave-product-features-wave-product-features_j4oazj .stars-outer {
      position: relative;
      display: inline-block;
    }
    .wave-product-features-wave-product-features_j4oazj .stars-inner {
      position: absolute;
      top: 0;
      left: 0;
      white-space: nowrap;
      overflow: hidden;
      width: 0%;
      transition: width var(--anim-reveal-duration, 750ms) var(--animation-timing-fade-in, ease-out);
    }
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__content.is-visible .stars-inner {
      width: var(--stars-fill-target);
    }
    .wave-product-features-wave-product-features_j4oazj .stars-outer::before,
    .wave-product-features-wave-product-features_j4oazj .stars-inner::before {
      content: "★★★★★";
      font-family: "Arial", sans-serif;
      font-size: 18px;
      line-height: 1;
      letter-spacing: 0;
      font-weight: normal;
      text-rendering: geometricPrecision;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    .wave-product-features-wave-product-features_j4oazj .stars-outer::before { color: rgba(128,128,128,.25); }
    .wave-product-features-wave-product-features_j4oazj .stars-inner::before { color: var(--color-gradient-text); }

    .wave-product-features-wave-product-features_j4oazj .wave-product-features__reviews-text strong {
      color: var(--color-gradient-text) !important;
    }

    
      .wave-product-features-wave-product-features_j4oazj .wave-product-features__heading {
        color: var(--color-gradient-text) !important;
      }
      .wave-product-features-wave-product-features_j4oazj .wave-product-features__subtext {
        color: var(--color-gradient-text) !important;
      }
      .wave-product-features-wave-product-features_j4oazj .wave-product-features__reviews-text {
        color: var(--color-gradient-text);
      }
      .wave-product-features-wave-product-features_j4oazj .wave-product-features__reviews-text strong {
        color: var(--color-gradient-text) !important;
