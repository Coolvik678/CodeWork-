<section id="demonstration" class="py-20 px-6 border-b border-border-dim max-w-7xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-16">
    <span class="eyebrow block mb-3">Practical Demonstrations</span>
    <h2 class="text-3xl sm:text-4xl font-serif font-bold text-bone">Designed for Actual Daily Use</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="bg-ink-card border border-border-dim p-8 rounded-xl">
      <span class="text-xs font-bold text-amber uppercase tracking-wider block mb-2">Item 1: Kitchen Efficiency</span>
      <h3 class="text-2xl font-serif font-bold text-bone mb-4">Effortless Dough Pressing</h3>
      <p class="text-sm text-bone-muted leading-relaxed">
        Place dough slightly toward the hinge, apply firm downward pressure for 2 seconds, and lift. Dough flattens uniformly without tearing, ready for direct frying or roasting.
      </p>
    </div>

    <div class="bg-ink-card border border-border-dim p-8 rounded-xl">
      <span class="text-xs font-bold text-amber uppercase tracking-wider block mb-2">Item 2: Devotional Focus</span>
      <h3 class="text-2xl font-serif font-bold text-bone mb-4">Silent Devotional Focus</h3>
      <p class="text-sm text-bone-muted leading-relaxed">
        The contoured wooden body sits naturally in the palm. The roller turns silently under thumb pressure, allowing continuous counting without noise or distractions.
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Demonstrations",
  "settings": []
}
{% endschema %}
