      font-weight: var(--font-body--weight, 900);
      text-transform: uppercase;
      letter-spacing: 0.06em;
  
      border: 0;
      cursor: pointer;
      text-align: center;
  
      background: var(--hp-btn-bg);
      color: var(--hp-btn-text);
  
      transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
      box-shadow: 0 10px 24px rgba(2, 6, 23, 0.14);
    }
  
    .wave-product-features-wave-product-features_j4oazj .wave-product-features__button:hover{
      transform: translateY(-1px);
      background: var(--hp-btn-bg-hover);
      box-shadow: 0 14px 30px rgba(2, 6, 23, 0.18);
    }
  
    /* =========================================================
       Responsive
       ========================================================= */
    @media screen and (max-width: 989px){
