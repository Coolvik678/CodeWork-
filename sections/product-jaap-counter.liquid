<section id="jaap-counter" class="py-24 px-6 border-b border-border-dim max-w-7xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    
    <!-- Details Column (Left) -->
    <div class="order-2 lg:order-1" data-reveal>
      <div class="flex items-center gap-3 mb-2">
        <span class="eyebrow">Devotional & Meditation</span>
        <span class="inline-flex items-center gap-1.5 bg-amber/10 border border-amber/30 text-amber text-[10px] font-bold px-2.5 py-0.5 rounded-full animate-pulse">
          <span class="w-1.5 h-1.5 rounded-full bg-amber"></span> Batch 04: 9 Units Left
        </span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-bone mb-4">
        Wooden Digital Mantra Jaap Counter With Compass
      </h2>
      
      <div class="flex items-baseline gap-4 mb-6">
        <span class="text-3xl sm:text-4xl font-bold text-bone">₹499</span>
        <span class="text-lg line-through text-bone-muted/50">₹799</span>
        <span class="text-xs font-semibold text-amber bg-amber/10 px-3 py-1 rounded-full border border-amber/20">Save 38% Off</span>
      </div>

      <p class="text-sm text-bone-muted leading-relaxed mb-6">
        Handheld electronic counter with silent scroll wheel and built-in prayer direction compass. Features a high-contrast LCD screen, natural wood-grain contour, and sacred silk tassel.
      </p>

      <!-- Glass Specs Table -->
      <div class="card-glass rounded-xl p-5 mb-6 text-xs divide-y divide-border-dim" data-reveal>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Display</span><span class="font-medium text-bone">5-Digit Digital LCD Screen</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Count Range</span><span class="font-medium text-bone">1 to 99,999 Chants (One-Touch Reset)</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Compass</span><span class="font-medium text-bone">Integrated Direction Alignment</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Finish</span><span class="font-medium text-bone">Natural Wood Grain with Sacred Tassel</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Power</span><span class="font-medium text-bone">Pre-Installed Long-Life Battery</span></div>
      </div>

      <!-- Interactive PIN Code Delivery Checker -->
      <div class="card-glass p-3.5 rounded-xl border border-border-dim mb-6 text-xs">
        <label for="pincode-jaap" class="block text-[11px] font-semibold text-bone-muted uppercase tracking-wider mb-2">Check Delivery Date &amp; COD Availability:</label>
        <div class="flex gap-2">
          <input 
            type="text" 
            id="pincode-jaap" 
            maxlength="6" 
            placeholder="Enter 6-digit Indian PIN code" 
            class="flex-1 bg-ink border border-border-dim rounded-lg px-3 py-2 text-xs text-bone placeholder:text-bone-muted/40 focus:outline-none focus:border-amber transition">
          <button 
            type="button" 
            onclick="checkPincodeDelivery('pincode-jaap', 'pincode-jaap-res')" 
            class="bg-ink-elevated hover:bg-amber hover:text-black border border-border-dim text-bone font-semibold text-xs px-4 py-2 rounded-lg transition">
            Check
          </button>
        </div>
        <div id="pincode-jaap-res" class="mt-2 text-xs hidden"></div>
      </div>

      <button onclick="ZenkartCart.add('jaap-counter', 'Wooden Digital Jaap Counter With Compass', 499)" class="w-full bg-amber hover:bg-amber-lit text-black font-semibold text-sm py-4 rounded-full transition-all duration-200 hover:-translate-y-0.5 shadow-xl flex items-center justify-center gap-2">
        <span>Order Jaap Counter — ₹499</span>
      </button>
      <p class="text-[11px] text-center text-bone-muted mt-3">Free Express Shipping • Cash on Delivery available at checkout</p>
    </div>

    <!-- 3D Gyroscopic Visual Stage (Right) -->
    <div class="order-1 lg:order-2 card-glass card-glow interactive-3d-card rounded-2xl p-8 lg:p-12 text-center relative overflow-hidden flex flex-col justify-between min-h-[560px] preserve-3d" data-reveal>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber/25 via-transparent to-transparent pointer-events-none"></div>
      
      <div class="flex justify-between items-center w-full relative z-10">
        <div class="flex items-center gap-2">
          <span class="text-[11px] uppercase tracking-widest font-semibold text-amber">Devotional Craft</span>
          <span class="text-[10px] bg-ink-elevated border border-border-dim px-2 py-0.5 rounded-full text-bone-muted">3D Inspection Mode</span>
        </div>
        <span class="bg-amber/15 text-amber border border-amber/30 text-[11px] font-bold px-3 py-1 rounded-full uppercase">Save 38%</span>
      </div>
      
      <!-- Interactive Stage with Hotspots -->
      <div class="my-auto py-6 relative z-10 flex flex-col items-center">
        <div class="relative w-full h-80 md:h-96 rounded-xl overflow-hidden border border-border-dim/80 group bg-ink mb-6 shadow-2xl">
          <img 
            src="{{ 'jaap-counter.jpg' | asset_url }}" 
            alt="Wooden Digital Mantra Jaap Counter With Compass" 
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            loading="lazy">
          <div class="absolute inset-0 bg-gradient-to-t from-ink-card via-transparent to-transparent opacity-60"></div>

          <!-- Hotspot 1: LCD Display -->
          <div class="hotspot-node" style="left: 45%; top: 24%;">
            <div class="hotspot-beacon">
              <div class="hotspot-dot"></div>
            </div>
            <div class="hotspot-tooltip card-glass px-3 py-1.5 rounded-lg text-[11px] text-bone border border-amber/30 shadow-xl">
              <strong class="text-amber block font-serif">5-Digit Digital LCD</strong>
              High-contrast sunlight readable display
            </div>
          </div>

          <!-- Hotspot 2: Integrated Compass -->
          <div class="hotspot-node" style="left: 78%; top: 38%;">
            <div class="hotspot-beacon">
              <div class="hotspot-dot"></div>
            </div>
            <div class="hotspot-tooltip card-glass px-3 py-1.5 rounded-lg text-[11px] text-bone border border-amber/30 shadow-xl">
              <strong class="text-amber block font-serif">Precision Compass</strong>
              Integrated prayer direction alignment
            </div>
          </div>

          <!-- Hotspot 3: Silent Roller -->
          <div class="hotspot-node" style="left: 28%; top: 58%;">
            <div class="hotspot-beacon">
              <div class="hotspot-dot"></div>
            </div>
            <div class="hotspot-tooltip card-glass px-3 py-1.5 rounded-lg text-[11px] text-bone border border-amber/30 shadow-xl">
              <strong class="text-amber block font-serif">Silent Scroll Roller</strong>
              Zero-noise tactile micro-bearings
            </div>
          </div>

          <!-- Hotspot 4: Wood Grain & Tassel -->
          <div class="hotspot-node" style="left: 55%; top: 88%;">
            <div class="hotspot-beacon">
              <div class="hotspot-dot"></div>
            </div>
            <div class="hotspot-tooltip card-glass px-3 py-1.5 rounded-lg text-[11px] text-bone border border-amber/30 shadow-xl">
              <strong class="text-amber block font-serif">Rosewood Finish</strong>
              Warm organic feel with sacred silk tassel
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2 text-[11px] text-amber/80 font-medium tracking-wide">
          <span>❖ Hover / Move Cursor to Tilt in 3D Space</span>
        </div>
      </div>

      <div class="flex justify-between items-center text-[11px] text-bone-muted/60 tracking-widest uppercase relative z-10 pt-2 border-t border-border-dim/40">
        <span>Model: ZK-JC-05</span>
        <span>Domestic Certified</span>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product: Jaap Counter",
  "settings": []
}
{% endschema %}
