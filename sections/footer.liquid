      .stellar_colophon-band-stellar_footer .stellar_colophon-social-media-social_media .stellar_colophon-social-icon:hover {
        background-color: var(--color-primary);
        transform: translateY(-2px);
      }
      

      .stellar_colophon-band-stellar_footer .stellar_colophon-social-media-social_media .stellar_colophon-social-icon svg {
        width: 20px;
        height: 20px;
