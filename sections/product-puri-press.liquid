<section id="puri-press" class="py-24 px-6 border-b border-border-dim max-w-7xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    
    <!-- Dramatic Visual Stage -->
    <div class="card-glass card-glow rounded-2xl p-8 lg:p-12 text-center relative overflow-hidden flex flex-col justify-between min-h-[500px]" data-reveal>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber/20 via-transparent to-transparent pointer-events-none"></div>
      
      <div class="flex justify-between items-center w-full relative z-10">
        <span class="text-[11px] uppercase tracking-widest font-semibold text-amber">Kitchen Machinery</span>
        <span class="bg-amber/15 text-amber border border-amber/30 text-[11px] font-bold px-3 py-1 rounded-full uppercase">Save 40%</span>
      </div>
      
      <div class="my-auto py-8 relative z-10 flex flex-col items-center">
        <div class="relative w-full h-72 md:h-96 rounded-xl overflow-hidden border border-border-dim group bg-ink mb-6">
          <img 
            src="{{ 'puri-press.jpg' | asset_url }}" 
            alt="Stainless Steel Puri & Khakhra Press Machine" 
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            loading="lazy">
          <div class="absolute inset-0 bg-gradient-to-t from-ink-card via-transparent to-transparent opacity-60"></div>
        </div>
        <h3 class="text-2xl font-serif font-bold text-bone">Stainless Steel Puri & Khakhra Press</h3>
        <p class="text-xs text-bone-muted mt-2">Food-Grade 304 Steel • Balanced Mechanical Leverage • 834g Solid Base</p>
      </div>

      <div class="text-[11px] text-bone-muted/60 tracking-widest uppercase relative z-10">
        Model: ZK-PP-23 • Domestic Certified
      </div>
    </div>

    <!-- Product Details & Specs -->
    <div data-reveal>
      <span class="eyebrow block mb-2">Uniform Mechanical Flattening</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-bone mb-4">
        Stainless Steel Puri & Khakhra Press Machine
      </h2>
      
      <div class="flex items-baseline gap-4 mb-6">
        <span class="text-3xl sm:text-4xl font-bold text-bone">₹599</span>
        <span class="text-lg line-through text-bone-muted/50">₹999</span>
        <span class="text-xs font-semibold text-amber bg-amber/10 px-3 py-1 rounded-full border border-amber/20">Special Offer</span>
      </div>

      <p class="text-sm text-bone-muted leading-relaxed mb-8">
        A heavy-gauge manual press designed for flattening dough evenly in seconds. The balanced mechanical lever applies uniform pressure across dough balls, saving significant time during morning cooking.
      </p>

      <!-- Glass Specs Table -->
      <div class="card-glass rounded-xl p-5 mb-8 text-xs divide-y divide-border-dim" data-reveal>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Plate Diameter</span><span class="font-medium text-bone">23 cm</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Net Weight</span><span class="font-medium text-bone">834 grams (Heavy Cast Base)</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Material</span><span class="font-medium text-bone">Food-Grade Stainless Steel</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Handle</span><span class="font-medium text-bone">Textured Anti-Slip Grip</span></div>
        <div class="flex justify-between py-2.5"><span class="text-bone-muted">Warranty</span><span class="font-medium text-bone">7-Day Direct Replacement</span></div>
      </div>

      <button onclick="ZenkartCart.add('puri-press', 'Stainless Steel Puri Press Machine', 599)" class="w-full bg-amber hover:bg-amber-lit text-black font-semibold text-sm py-4 rounded-full transition-all duration-200 hover:-translate-y-0.5 shadow-xl flex items-center justify-center gap-2">
        <span>Order Puri Press — ₹599</span>
      </button>
      <p class="text-[11px] text-center text-bone-muted mt-3">Free Express Shipping • Cash on Delivery available at checkout</p>
    </div>

  </div>
</section>

