<div class="section-wrapper"><section id="shopify-section-comparison-waves_odmv1l" class="anchor-product-comparison forge-color-scheme-1">
  <style>
    #shopify-section-comparison-waves_odmv1l{
      
      --apc-grad-1: #888888;
      --apc-grad-2: #555555;
      --apc-grad-3: #222222;
      

      --apc-text: #ffffff;
      --apc-muted: #e6f7ff;

      --apc-x-color: #f44336;

      --apc-wave-height: 120px;

      --apc-btn-bg: #0b1020;
      --apc-btn-bg-hover: #101a33;
      --apc-btn-text: #ffffff;
    }

    /* Kill theme section background if it creates seams */
    #shopify-section-comparison-waves_odmv1l .forge-section-background{ display:none !important; }
    #shopify-section-comparison-waves_odmv1l{ background: transparent !important; }

    /* Full-bleed gradient behind everything */
    #shopify-section-comparison-waves_odmv1l.anchor-product-comparison{
      position: relative;
      overflow: hidden;
      margin-top: 80px;
      margin-bottom: 80px;
    }
    #shopify-section-comparison-waves_odmv1l.anchor-product-comparison::before{
      content:"";
      position:absolute;
      inset:0;
      background: linear-gradient(135deg, var(--apc-grad-1), var(--apc-grad-2) 55%, var(--apc-grad-3));
      z-index: 0;
    }

    /* subtle texture (like hero) */
    #shopify-section-comparison-waves_odmv1l.anchor-product-comparison::after{
      content:"";
      position:absolute;
      inset:0;
      background:
        radial-gradient(1200px 600px at 10% 15%, rgba(255,255,255,.12), transparent 55%),
        radial-gradient(900px 500px at 90% 80%, rgba(255,255,255,.10), transparent 60%);
      opacity: .9;
      pointer-events:none;
      z-index: 0;
    }

    /* WAVES */
    #shopify-section-comparison-waves_odmv1l .apc-waves{
      position: absolute;
      left: 0;
      right: 0;
      height: var(--apc-wave-height);
      pointer-events: none;
      z-index: 1; /* above bg, below content */
      overflow: hidden;
    }

    /* Vertical bob only - no horizontal scroll. A side-to-side scroll needs the
       wave path's left edge (x=0) and right edge (x=1440) to land on the exact
       same y, or the tile boundary shows as a hard diagonal seam. Bobbing up/down
       has no tile boundary to line up, so it can't seam. The svg overshoots the
       container height (and sits bottom:-14px instead of 0) so the bob never
       uncovers a gap at its trailing edge. */
    #shopify-section-comparison-waves_odmv1l .apc-waves svg{
      position: absolute;
      left: 0;
      bottom: -14px;
      width: 100%;
      height: calc(100% + 14px);
      display: block;
      margin: 0;
    }

    #shopify-section-comparison-waves_odmv1l .apc-waves--bottom{
      bottom: -1px;
    }

    /* Flip the whole wrapper, not the svg transform (that one carries the bob animation) */
    #shopify-section-comparison-waves_odmv1l .apc-waves--top{
      top: -1px;
      transform: scaleY(-1);
    }

    #shopify-section-comparison-waves_odmv1l .apc-wave-1{ animation: apc-wave-bob-comparison-waves_odmv1l 7s ease-in-out infinite; }
    #shopify-section-comparison-waves_odmv1l .apc-wave-2{ animation: apc-wave-bob-comparison-waves_odmv1l 5.5s ease-in-out infinite reverse; }
    #shopify-section-comparison-waves_odmv1l .apc-wave-3{ animation: apc-wave-bob-comparison-waves_odmv1l 8.5s ease-in-out infinite; }

    #shopify-section-comparison-waves_odmv1l .apc-wave-1 path{ fill: rgba(255,255,255,.20); }
    #shopify-section-comparison-waves_odmv1l .apc-wave-2 path{ fill: rgba(255,255,255,.45); }
    #shopify-section-comparison-waves_odmv1l .apc-wave-3 path{ fill: #000000; }

    @keyframes apc-wave-bob-comparison-waves_odmv1l {
      0%, 100%{ transform: translateY(0); }
      50%{ transform: translateY(-7px); }
    }

    @media (prefers-reduced-motion: reduce){
      #shopify-section-comparison-waves_odmv1l .apc-wave-1,
      #shopify-section-comparison-waves_odmv1l .apc-wave-2,
      #shopify-section-comparison-waves_odmv1l .apc-wave-3{
        animation: none;
      }
    }

    /* container */
    #shopify-section-comparison-waves_odmv1l .apc-wrap{
      position: relative;
      z-index: 2; /* content above waves */
      width: 100%;
      max-width: 1400px;
      margin: 0 auto;
      box-sizing: border-box;

      padding:
        calc(52px + calc(var(--apc-wave-height) * 0.20))
        20px
        calc(52px + 0px)
        20px;
    }

    /* layout */
    #shopify-section-comparison-waves_odmv1l .apc-grid{
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    /* content */
    #shopify-section-comparison-waves_odmv1l .apc-content{
      max-width: 560px;
      color: var(--apc-text);
    }

    #shopify-section-comparison-waves_odmv1l .apc-title{
      margin: 0 0 14px 0;
      font-weight: var(--font-h2--weight, 800);
      letter-spacing: var(--font-h2--letter-spacing, -0.02em);
      line-height: 1.06;
      font-size: clamp(30px, 3vw, calc(var(--font-h2--size) * 1.45));
      color: var(--apc-text);
    }
    #shopify-section-comparison-waves_odmv1l .apc-title.forge-rte p{ margin:0; }

    #shopify-section-comparison-waves_odmv1l .apc-desc{
      margin: 0 0 22px 0;
      font-size: 16px;
      line-height: 1.6;
      color: var(--apc-text);
      opacity: .95;
      max-width: 56ch;
    }
    #shopify-section-comparison-waves_odmv1l .apc-desc p{ margin:0; color: inherit; }

    #shopify-section-comparison-waves_odmv1l .apc-actions{
      display:flex;
      align-items:center;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    #shopify-section-comparison-waves_odmv1l .apc-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding: 14px 22px;
      border-radius: var(--style-border-radius-buttons-primary, 14px);
      text-decoration:none;
      font-weight: var(--font-body--weight, 800);
      font-size: 15px;
      background: var(--color-primary-button-background);
      color: var(--color-primary-button-text);
      border: 0;
      overflow: hidden;
      transition: transform .12s ease, background .12s ease, box-shadow .12s ease;
      box-shadow: 0 12px 30px rgba(0,0,0,.16);
      cursor: pointer;
      white-space: nowrap;
    }
    #shopify-section-comparison-waves_odmv1l .apc-btn:hover{
      background: var(--color-primary-button-hover-background);
      color: var(--color-primary-button-hover-text);
      transform: translateY(-1px);
    }

    #shopify-section-comparison-waves_odmv1l .apc-secondary{
      font-size: 13px;
      color: var(--apc-muted);
      opacity: .95;
    }

    /* table card */
    #shopify-section-comparison-waves_odmv1l .apc-table-card{
      background: rgba(255,255,255,.14);
      border: 1px solid rgba(255,255,255,.18);
      border-radius: var(--style-border-radius-global, 16px);
      overflow: hidden;
      box-shadow: var(--style-shadow-card, 0 18px 50px rgba(0,0,0,.18));
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    #shopify-section-comparison-waves_odmv1l .apc-table{
      width: 100%;
      border-collapse: collapse;
    }

    #shopify-section-comparison-waves_odmv1l .apc-table thead th{
      background: rgba(255,255,255,.12);
      padding: 1rem;
      text-align: center;
      font-size: 0.80rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255,255,255,.92);
    }

    #shopify-section-comparison-waves_odmv1l .apc-th-empty{
      background: transparent !important;
      width: 50%;
    }

    #shopify-section-comparison-waves_odmv1l .apc-table tbody tr{
      border-bottom: 1px solid rgba(255,255,255,.12);
    }
    #shopify-section-comparison-waves_odmv1l .apc-table tbody tr:last-child{
      border-bottom: none;
    }

    #shopify-section-comparison-waves_odmv1l .apc-table td{
      padding: 1.15rem 1rem;
      color: rgba(255,255,255,.92);
      vertical-align: middle;
    }

    #shopify-section-comparison-waves_odmv1l .apc-feature{
      font-size: 1rem;
      font-weight: 700;
      text-align: left;
      line-height: 1.25;
    }

    #shopify-section-comparison-waves_odmv1l .apc-cell{
      text-align: center;
      width: 25%;
    }

    #shopify-section-comparison-waves_odmv1l .apc-icon-box{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: var(--style-border-radius-global, 10px);
      background: rgba(255,255,255,.14);
      border: 1px solid rgba(255,255,255,.18);
    }

    #shopify-section-comparison-waves_odmv1l .apc-check,
    #shopify-section-comparison-waves_odmv1l .apc-x{
      width: 22px;
      height: 22px;
      display: inline-block;
    }

    #shopify-section-comparison-waves_odmv1l .apc-check{ color: #fff; }

    #shopify-section-comparison-waves_odmv1l .apc-x{
      color: var(--apc-x-color);
      opacity: 0.9;
    }

    /* responsive */
    @media (max-width: 989px){
      #shopify-section-comparison-waves_odmv1l{
        --apc-wave-height: 140px;
      }

      #shopify-section-comparison-waves_odmv1l .apc-grid{
        grid-template-columns: 1fr;
        gap: 2.25rem;
      }

      #shopify-section-comparison-waves_odmv1l .apc-content{
        max-width: 100%;
        text-align: center;
      }

      #shopify-section-comparison-waves_odmv1l .apc-actions{
        justify-content: center;
      }

      #shopify-section-comparison-waves_odmv1l .apc-table thead th{
        padding: 0.75rem 0.5rem;
        font-size: 0.72rem;
      }

      #shopify-section-comparison-waves_odmv1l .apc-table td{
        padding: 1rem 0.6rem;
      }

      #shopify-section-comparison-waves_odmv1l .apc-feature{
        font-size: 0.95rem;
      }
    }

    @media (max-width: 749px){
      #shopify-section-comparison-waves_odmv1l .apc-wrap{
        padding-left: 16px;
        padding-right: 16px;
      }
    }
  </style>

  
