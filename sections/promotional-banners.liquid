<div class="section">

<style>
  .ai-promo-banners-promotional-bannerstpknz5 {
    display: block;
    width: 100%;
    padding: calc(80px * var(--section-spacing-scale, 1)) 20px calc(80px * var(--section-spacing-scale, 1));
  }

  .ai-promo-banners-container-promotional-bannerstpknz5 {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .ai-promo-banner-promotional-bannerstpknz5 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 40px;
    border-radius: var(--style-border-radius-cards);
    text-decoration: none;
    overflow: hidden;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    min-height: 200px;
  }

  .ai-promo-banner-promotional-bannerstpknz5:hover {
    transform: translateY(-2px);
    box-shadow: var(--style-shadow-card);
  }

  .ai-promo-banner-light-promotional-bannerstpknz5 {
    background: var(--color-background);
  }

  .ai-promo-banner-gradient-promotional-bannerstpknz5 {
    
      background: linear-gradient(135deg, #6b4c9a 0%, #6b4c9a 100%);
    
    position: relative;
  }

  .ai-promo-banner-bg-image-promotional-bannerstpknz5 {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
    z-index: 0;
  }

  .ai-promo-banner-content-promotional-bannerstpknz5 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 24px;
    position: relative;
    z-index: 1;
  }

  .ai-promo-banner-image-promotional-bannerstpknz5 {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
  }

  .ai-promo-banner-image-promotional-bannerstpknz5 img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-promo-banner-logo-promotional-bannerstpknz5 {
    flex-shrink: 0;
    width: 100px;
    height: auto;
  }

  .ai-promo-banner-logo-promotional-bannerstpknz5 img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .ai-promo-banner-text-promotional-bannerstpknz5 {
    flex-grow: 1;
    text-align: left;
  }

  .ai-promo-banner-heading-promotional-bannerstpknz5 {
    font-family: var(--font-heading--family);
    font-size: calc(var(--font-h2--size) * 0.8888888888888888);
    text-transform: var(--font-h2--case, uppercase);
    letter-spacing: 1px;
    line-height: 1.2;
    margin: 0 0 8px 0;
  }

  .ai-promo-banner-light-promotional-bannerstpknz5 .ai-promo-banner-heading-promotional-bannerstpknz5 {
    color: var(--color-foreground);
  }

  .ai-promo-banner-gradient-promotional-bannerstpknz5 .ai-promo-banner-heading-promotional-bannerstpknz5 {
    color: var(--color-foreground);
  }

  .ai-promo-banner-heading-accent-promotional-bannerstpknz5 {
    color: var(--color-gradient-1);
  }

  
  .ai-promo-banner-heading-accent-promotional-bannerstpknz5 {
    background: var(--color-card-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  

  .ai-promo-banner-subheading-promotional-bannerstpknz5 {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.4;
    margin: 0;
    color: var(--color-foreground);
  }

  @media screen and (max-width: 989px) {
    .ai-promo-banners-container-promotional-bannerstpknz5 {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .ai-promo-banner-promotional-bannerstpknz5 {
      min-height: 180px;
      padding: 24px;
    }

    .ai-promo-banner-heading-promotional-bannerstpknz5 {
      font-size: calc(var(--font-h2--size) * 0.6666666666666666);
    }

    .ai-promo-banner-subheading-promotional-bannerstpknz5 {
      font-size: 12px;
    }

    .ai-promo-banner-image-promotional-bannerstpknz5 {
      width: 80px;
      height: 80px;
    }

    .ai-promo-banner-logo-promotional-bannerstpknz5 {
      width: 70px;
    }

    .ai-promo-banner-content-promotional-bannerstpknz5 {
      gap: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-promo-banner-content-promotional-bannerstpknz5 {
      
    }

    .ai-promo-banner-text-promotional-bannerstpknz5 {
      
    }
  }
</style>

<forge-promotional-banners class="ai-promo-banners-promotional-bannerstpknz5 forge-color-scheme-1" data-section-id="promotional-banners_tpknz5">
  <div class="ai-promo-banners-container-promotional-bannerstpknz5" data-animate-group="">
    <a href="#bundle" class="ai-promo-banner-promotional-bannerstpknz5 ai-promo-banner-light-promotional-bannerstpknz5" data-animate="fade-up" style="--anim-child-index: 0;">
      <div class="ai-promo-banner-content-promotional-bannerstpknz5">
        <div data-forge-slot-id="banner1_image" data-forge-slot-thumbnail="{{ 'forge-bundle-banner.jpg' | asset_url }}" style="display:contents">
          
            <div class="ai-promo-banner-image-promotional-bannerstpknz5">
              
              <img src="{{ 'forge-bundle-banner.jpg' | asset_url }}" srcset="{{ 'forge-bundle-banner.jpg' | asset_url }}" alt="" loading="eager" width="120" height="120">
            </div>
          
        </div>

        <div class="ai-promo-banner-text-promotional-bannerstpknz5">
          
            <h2 class="ai-promo-banner-heading-promotional-bannerstpknz5">
              
                
                PERFECT <span class="ai-promo-banner-heading-accent-promotional-bannerstpknz5">PRESSING</span>
              
            </h2>
          

          
            <p class="ai-promo-banner-subheading-promotional-bannerstpknz5">
              The 7149a Stainless Steel Puri Press for faster, mindful meals.
            </p>
          
        </div>
      </div>
    </a>

    <a href="#bundle" class="ai-promo-banner-promotional-bannerstpknz5 ai-promo-banner-gradient-promotional-bannerstpknz5" data-animate="fade-up" style="--anim-child-index: 1;">
      <div data-forge-slot-id="banner2_bg_image" data-forge-slot-thumbnail="{{ 'forge-jaap-counter.jpg' | asset_url }}" style="display:contents">
        
          
          <img src="{{ 'forge-jaap-counter.jpg' | asset_url }}" srcset="{{ 'forge-jaap-counter.jpg' | asset_url }}" sizes="(min-width: 750px) 50vw, 100vw" alt="" class="ai-promo-banner-bg-image-promotional-bannerstpknz5" loading="eager" width="1200" height="800">
        
      </div>

      <div class="ai-promo-banner-content-promotional-bannerstpknz5">
        

        <div class="ai-promo-banner-text-promotional-bannerstpknz5">
          
            <h2 class="ai-promo-banner-heading-promotional-bannerstpknz5">
              MINDFUL MANTRA
            </h2>
          
        </div>
      </div>
    </a>
  </div>
</forge-promotional-banners>

<script>
  (function() {
    if (customElements.get('forge-promotional-banners')) return;

    class PromotionalBanners extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.banners = this.querySelectorAll('a[class*="ai-promo-banner-"]');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.banners.forEach((banner) => {
          if (banner.getAttribute('aria-disabled') === 'true') {
            banner.style.cursor = 'default';
            banner.addEventListener('click', (e) => {
              e.preventDefault();
            });
          }
        });
      }
    }

    customElements.define('forge-promotional-banners', PromotionalBanners);
  })();
</script>


</div>

