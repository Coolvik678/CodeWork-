<header class="sticky top-0 z-40 bg-black/95 backdrop-blur-md border-b border-[#2a2a2a] px-6 py-4 text-[#f5f5f5]">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    
    <!-- Left: Search Icon Button -->
    <div class="flex items-center gap-4">
      <button 
        type="button" 
        class="text-neutral-400 hover:text-white transition p-1.5 rounded-full hover:bg-neutral-900"
        aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" class="w-5 h-5">
          <circle cx="9" cy="9" r="4.75" stroke="currentColor" stroke-width="1.6"></circle>
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="m12.5 12.5 3.25 3.25"></path>
        </svg>
      </button>
    </div>

    <!-- Center: Authentic Clean ZENKART Wordmark -->
    <div class="flex items-center justify-center">
      <a href="/" class="text-xl sm:text-2xl font-serif font-bold tracking-[0.28em] text-white hover:opacity-80 transition uppercase">
        ZENKART
      </a>
    </div>

    <!-- Right: Currency / Region Selector + Shopping Bag Cart Drawer Trigger -->
    <div class="flex items-center gap-4">
      <!-- Region Selector -->
      <div class="hidden sm:flex items-center gap-1.5 text-xs text-neutral-400 hover:text-white cursor-pointer transition py-1 px-2 rounded hover:bg-neutral-900">
        <span class="text-xs">INR ₹</span>
        <span class="opacity-40">/</span>
        <svg class="w-3.5 h-3.5 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </div>

      <!-- Cart Icon with Live Count Bubble -->
      <button 
        id="cart-toggle-btn" 
        class="relative p-1.5 text-neutral-300 hover:text-white transition rounded-full hover:bg-neutral-900"
        aria-label="Shopping Cart">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" class="w-5 h-5">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3.392 6.875h13.216v8.016c0 .567-.224 1.112-.624 1.513-.4.402-.941.627-1.506.627H5.522a2.13 2.13 0 0 1-1.506-.627 2.15 2.15 0 0 1-.624-1.513zM8.818 2.969h2.333c.618 0 1.211.247 1.649.686a2.35 2.35 0 0 1 .683 1.658v1.562H6.486V5.313c0-.622.246-1.218.683-1.658a2.33 2.33 0 0 1 1.65-.686"></path>
        </svg>
        <span 
          id="cart-count-badge" 
          class="absolute -top-1 -right-1 bg-white text-black text-[10px] font-bold rounded-full h-4 w-4 flex items-center justify-center leading-none">
          {{ cart.item_count }}
        </span>
      </button>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
