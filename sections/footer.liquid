<div class="stellar_band"><style>
  
  #shopify-section-stellar_footer {
    display: flow-root;
    padding-top: calc(50px * var(--section-spacing-scale, 1));
  }

  .stellar_scope-block--stellar_footer {
    background-color: var(--color-background);
  }

  .stellar_colophon-band-stellar_footer div:empty {
    display: unset !important;
  }

  
  .stellar_colophon-band-stellar_footer :is(strong, b),
  .stellar_colophon-band-stellar_footer :is(strong, b) * {
    font-weight: bold !important;
    font-family: inherit;
    color: inherit;
    font-style: inherit;
  }

  .stellar_colophon-band-stellar_footer :is(em, i),
  .stellar_colophon-band-stellar_footer :is(em, i) * {
    font-style: italic !important;
    font-family: inherit;
    color: inherit;
    font-weight: inherit;
  }

  .stellar_colophon-band-stellar_footer span {
    font-size: inherit;
    font-family: inherit;
    color: inherit;
    font-style: inherit;
    font-weight: inherit;
  }
  

  .stellar_colophon-band-stellar_footer {
    width: 100%;
    
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .stellar_colophon-shell-stellar_footer {
    display: flex;
    
    background: var(--color-background);
    justify-content: center;
    height: 100%;
    
    overflow: hidden;
  }

  .stellar_colophon-wrapper-stellar_footer {
    
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: 45px;
    
    padding: 40px 40px 20px 40px;
  }

  .stellar_colophon-newsletter-container-stellar_footer {
    width: 100%;
    margin-bottom: 40px;
  }

  .stellar_colophon-main-content-stellar_footer {
    display: grid;
    grid-template-columns: none;
    grid-auto-flow: column;
    gap: 40px;
    margin-bottom: 40px;
  }

  .stellar_colophon-bottom-stellar_footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  @media (max-width: 1000px) {

    .stellar_colophon-band-stellar_footer {
        padding-inline: 0px;
    }

    .stellar_colophon-shell-stellar_footer {
        max-width: 100%;
        border-radius: 0px;
    }
  }

  
  
    
      @font-face {
  font-family: Inter;
  font-weight: 700;
  font-style: normal;
  font-display: swap;
  src: url(//jbn7jn-pj.myshopify.com/cdn/fonts/inter/inter_n7.woff2) format("woff2"),
       url(//jbn7jn-pj.myshopify.com/cdn/fonts/inter/inter_n7.woff) format("woff");
}
      @font-face {
  font-family: Inter;
  font-weight: 400;
  font-style: normal;
  font-display: swap;
  src: url(//jbn7jn-pj.myshopify.com/cdn/fonts/inter/inter_n4.woff2) format("woff2"),
       url(//jbn7jn-pj.myshopify.com/cdn/fonts/inter/inter_n4.woff) format("woff");
}

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 40px;
        
        border-bottom: 1px solid var(--color-border);
        
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-text-content {
        display: flex;
        flex-direction: column;
        text-align: left;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-form-container {
        display: flex;
        justify-content: flex-start;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-title {
        font-family: var(--font-heading--family, inherit);
        font-size: 28px;
        color: var(--color-foreground-heading);
        font-style: normal;
        font-weight: var(--font-h3--weight, 700);
        margin-bottom: 15px;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-description {
        font-family: var(--font-body--family, inherit);
        font-size: 15px;
        color: var(--color-foreground-muted);
        font-style: normal;
        font-weight: var(--font-body--weight, 400);
        margin-bottom: 20px;
        line-height: 1.5;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-form {
        display: flex;
        gap: 15px;
        align-items: stretch;
        width: 100%;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-input {
        padding: 12px 16px;
        border: 1px solid var(--color-input-border);
        border-radius: var(--style-border-radius-inputs, 0px);
        background-color: var(--color-input-background);
        color: var(--color-input-text);
        font-size: 14px;
        flex: 1 0 0px;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-input:focus {
        outline: none;
        outline-offset: 0 !important;
        outline-width: 0 !important;
        box-shadow: none;
        border: 2px solid var(--color-input-border) !important;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-input:focus-visible {
        outline: none;
        box-shadow: none;
        outline-offset: 0 !important;
        outline-width: 0 !important;
        border: 2px solid var(--color-input-border) !important;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-input::placeholder {
        color: var(--color-foreground-muted);
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-button {
        min-width: fit-content;
        padding: 12px 24px;
        background: var(--color-primary-button-background);
        color: var(--color-primary-button-text);
        border: 1px solid var(--color-primary-button-border);
        border-radius: var(--style-border-radius-buttons-primary, 0px);

        font-family: var(--font-body--family, inherit);
        font-size: 14px;
        font-weight: var(--button-font-weight-primary, var(--font-body--weight, 600));
        cursor: pointer;
        box-shadow: none;
        
      }

      

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-error {
        color: var(--color-foreground);
        margin-bottom: 15px;
        font-size: 14px;
        padding: 10px;
        background: var(--color-background-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--style-border-radius-global, 4px);
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-success {
        display: flex;
        flex-direction: column;
        gap: 5px;
        align-items: center;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-success-title {
        font-family: var(--font-heading--family, inherit);
        font-size: 28px;
        color: var(--color-foreground-heading);
        font-style: normal;
        font-weight: var(--font-h3--weight, 700);
        text-align: center;
      }

      .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-success-subtitle {
        font-family: var(--font-body--family, inherit);
        font-size: 15px;
        color: var(--color-foreground-muted);
        font-style: normal;
        font-weight: var(--font-body--weight, 400);
        line-height: 1.5;
        margin-bottom: 20px !important;
        text-align: center;
      }

      @media (max-width: 768px) {
        .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter {
          flex-direction: column;
          gap: 20px;
          align-items: flex-start;
          text-align: left;
          
          padding-bottom: 40px;
          
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-text-content {
          text-align: left;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-form-container {
          min-width: unset;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-success {
          margin: 0 auto;
        }

        .stellar_colophon-band-stellar_footer .contact-form {
            width: 100%;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-title {
          font-size: 22px;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-description {
          font-size: 13px;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-form {
          flex-direction: column;
        }

        .stellar_colophon-band-stellar_footer .stellar_colophon-newsletter-newsletter .stellar_colophon-newsletter-input {
          min-width: unset;
        }
      }
    
  
    
  
    
  
    
  
    
  
    
  

  
  
    
  
    
      
