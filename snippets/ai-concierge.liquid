        if (hasAny('stick', 'sticking', 'how to use', 'use', 'technique', 'tips', 'oil', 'paper', 'plastic')) {
          return {
            text: `👨‍🍳 <strong>Chef Pro-Tip for 100% Non-Stick, Round Puris:</strong><br><br>
            1. <strong>Light Grease:</strong> Dab just 1 tiny drop of cooking oil onto both steel plates (or place a small sheet of plastic wrap / butter paper).<br>
