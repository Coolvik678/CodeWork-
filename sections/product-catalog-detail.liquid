<!-- sections/product-catalog-detail.liquid -->
{%- liquid
  assign is_puri = false
  if product.handle contains 'puri' or product.handle contains 'roti'
    assign is_puri = true
  endif

  if is_puri
    assign current_title = product.title | default: "Stainless Steel Heavy Duty Puri & Khakhra Press Maker"
    assign current_price_num = 599
    assign compare_price_num = 1499
    assign discount_pct = "60% OFF"
    assign breadcrumb_cat = "Artisanal Kitchen Tools"
    assign stock_left = 19
    assign review_count = 241
    assign rating_val = "4.8"
    if product.featured_image
      assign main_img = product.featured_image | image_url: width: 1200
    else
      assign main_img = 'forge-puri-maker.jpg' | asset_url
    endif
  else
    assign current_title = product.title | default: "Wooden Digital Jaap Counter With Compass (1 Pc)"
    assign current_price_num = 499
    assign compare_price_num = 1299
    assign discount_pct = "62% OFF"
    assign breadcrumb_cat = "Devotional & Meditation"
    assign stock_left = 14
    assign review_count = 184
    assign rating_val = "4.9"
    if product.featured_image
      assign main_img = product.featured_image | image_url: width: 1200
    else
      assign main_img = 'forge-jaap-counter.jpg' | asset_url
    endif
  endif
-%}

<style>
  @keyframes diwaliPulse {
    0%, 100% {
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.45), 0 0 25px rgba(217, 119, 6, 0.2), 0 4px 12px rgba(0, 0, 0, 0.7);
      border-color: rgba(251, 191, 36, 0.6);
    }
    50% {
      box-shadow: 0 0 28px rgba(245, 158, 11, 0.9), 0 0 50px rgba(251, 191, 36, 0.5), 0 6px 20px rgba(0, 0, 0, 0.9);
      border-color: rgba(254, 243, 199, 1);
    }
  }

  .btn-diwali-glow {
    position: relative !important;
    background: #ffffff !important;
    color: #000000 !important;
    border: 2px solid rgba(251, 191, 36, 0.7) !important;
    animation: diwaliPulse 1.8s ease-in-out infinite !important;
    transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  }
  .btn-diwali-glow:hover {
    transform: scale(1.02) !important;
  }

  .bundle-tier-card {
    cursor: pointer;
    border: 1px solid #2a2a2a;
    background: #141414;
    transition: all 0.2s ease;
  }
  .bundle-tier-card:hover {
    border-color: #444;
    background: #191919;
  }
  .bundle-tier-card.is-selected {
    border-color: #f59e0b !important;
    background: rgba(245, 158, 11, 0.08) !important;
    box-shadow: 0 0 18px rgba(245, 158, 11, 0.25) !important;
  }
</style>

<div class="bg-black text-[#f5f5f5] min-h-screen py-10 px-4 sm:px-8 lg:px-12 border-b border-[#222222]">
  <div class="max-w-[1400px] mx-auto">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-white/50 mb-8 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-white transition">Home</a>
      <span>/</span>
      <a href="/#featured-catalog" class="hover:text-white transition">Catalogue</a>
      <span>/</span>
      <span class="text-white/40">{{ breadcrumb_cat }}</span>
      <span>/</span>
      <span class="text-white font-medium truncate max-w-xs">{{ current_title }}</span>
    </nav>

    <!-- Main Product Grid: Gallery (Left) & Purchasing Funnel (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start mb-20">
      
      <!-- LEFT: High-Res Interactive Gallery with ALL Available Images (7 cols on lg) -->
      <div class="lg:col-span-7 space-y-4 lg:sticky lg:top-28">
        
        <!-- Main Preview Box -->
        <div class="relative w-full aspect-square bg-[#0c0c0c] rounded-2xl overflow-hidden border border-[#222] group shadow-2xl">
          <img 
            id="main-catalog-image" 
            src="{{ main_img }}" 
            alt="{{ current_title }}" 
            class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 cursor-zoom-in"
            loading="eager">

          <!-- Badges Overlay -->
          <div class="absolute top-4 left-4 flex flex-col gap-2 pointer-events-none">
            <span class="bg-white text-black font-bold text-[11px] uppercase tracking-wider px-3 py-1 rounded shadow">
              {{ discount_pct }}
            </span>
            <span class="bg-black/80 backdrop-blur-md border border-[#333] text-white text-[11px] font-medium px-3 py-1 rounded-full flex items-center gap-1.5 shadow">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              In Stock: Only {{ stock_left }} Units Left
            </span>
          </div>

          <div class="absolute bottom-4 right-4 bg-black/80 backdrop-blur-md border border-[#333] text-[11px] text-white/60 px-3 py-1 rounded-full flex items-center gap-2 pointer-events-none">
            <span>🔍 Click thumbnail below to switch photo</span>
          </div>
        </div>

        <!-- Thumbnail Strip With ALL Available Images -->
        <div class="space-y-2">
          <div class="text-[11px] text-white/50 font-medium tracking-wide">
            AVAILABLE PRODUCT IMAGES &amp; ANGLES:
          </div>

          <div class="flex items-center gap-2.5 overflow-x-auto pb-3 scrollbar-thin">
            {% if product.images.size > 0 %}
              {% for p_image in product.images %}
                <button 
                  type="button" 
                  onclick="switchMainImage('{{ p_image | image_url: width: 1200 }}', this)" 
                  class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border {% if forloop.first %}border-white opacity-100{% else %}border-[#2a2a2a] opacity-70 hover:opacity-100{% endif %} bg-[#111] transition-all">
                  <img src="{{ p_image | image_url: width: 240 }}" alt="Angle {{ forloop.index }}" class="w-full h-full object-cover">
                </button>
              {% endfor %}
            {% endif %}

            {% if is_puri %}
              <button 
                type="button" 
                onclick="switchMainImage('{{ 'forge-puri-maker.jpg' | asset_url }}', this)" 
                class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-70 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'forge-puri-maker.jpg' | asset_url }}" alt="Kitchen Studio View" class="w-full h-full object-cover">
              </button>
              <button 
                type="button" 
                onclick="switchMainImage('{{ 'forge-puri-press.jpg' | asset_url }}', this)" 
                class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-70 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'forge-puri-press.jpg' | asset_url }}" alt="Press Angle View" class="w-full h-full object-cover">
              </button>
              <button 
                type="button" 
                onclick="switchMainImage('{{ 'puri-action.jpg' | asset_url }}', this)" 
                class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-70 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'puri-action.jpg' | asset_url }}" alt="Action View" class="w-full h-full object-cover">
              </button>
            {% else %}
              <button 
                type="button" 
                onclick="switchMainImage('{{ 'forge-jaap-counter.jpg' | asset_url }}', this)" 
                class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-70 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'forge-jaap-counter.jpg' | asset_url }}" alt="Devotional Studio View" class="w-full h-full object-cover">
              </button>
              <button 
                type="button" 
                onclick="switchMainImage('{{ 'jaap-action.jpg' | asset_url }}', this)" 
                class="catalog-thumb-btn flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border border-[#2a2a2a] opacity-70 hover:opacity-100 bg-[#111] transition-all">
                <img src="{{ 'jaap-action.jpg' | asset_url }}" alt="Jaap Action View" class="w-full h-full object-cover">
              </button>
            {% endif %}
          </div>
        </div>

      </div>

      <!-- RIGHT: E-Commerce Conversion Box (5 cols on lg) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Priority Dispatch Badge -->
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 bg-[#141414] border border-[#2a2a2a] text-white/90 text-[11px] font-semibold px-3 py-1 rounded-full">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Zenkart Priority Dispatch
          </span>
          <span class="text-white/50 text-xs">Dispatch in 24–48 Hrs</span>
        </div>

        <!-- Title -->
        <div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-white leading-tight">
            {{ current_title }}
          </h1>

          <!-- Rating -->
          <div class="flex items-center gap-2 mt-3 text-xs">
            <div class="flex text-white">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
            <span class="font-bold text-white">{{ rating_val }}</span>
            <span class="text-white/50">({{ review_count }} Verified Customer Deliveries)</span>
          </div>
        </div>

        <!-- Pricing Card -->
        <div class="bg-[#0f0f0f] p-4 rounded-xl border border-[#222]">
          <div class="flex items-baseline gap-3">
            <span class="text-3xl sm:text-4xl font-bold text-white">₹{{ current_price_num }}</span>
            <span class="text-lg line-through text-white/40">₹{{ compare_price_num }}</span>
            <span class="bg-emerald-950/40 border border-emerald-800/40 text-emerald-400 text-xs font-bold px-2.5 py-0.5 rounded">
              {{ discount_pct }}
            </span>
          </div>
          <div class="flex items-center justify-between mt-2 pt-2 border-t border-[#1e1e1e] text-[11px] text-white/50">
            <span>Inclusive of all GST &amp; Taxes</span>
            <span class="text-emerald-400 font-semibold">✓ Free Pan-India Delivery</span>
          </div>
        </div>

        <!-- Special Deal Alert -->
        <div class="bg-[#141414] border border-[#282828] rounded-xl p-3 flex items-center justify-between text-xs text-white">
          <div class="flex items-center gap-2">
            <span class="text-base">🏷️</span>
            <span><strong>Special Offer:</strong> Buy 2, Get Extra 10% Off</span>
          </div>
          <span class="font-mono text-white text-[11px] bg-black px-2 py-0.5 rounded border border-[#333]">ZEN10</span>
        </div>

        <!-- PIN Code Estimator -->
        <div class="bg-[#0f0f0f] p-4 rounded-xl border border-[#222] text-xs">
          <label for="pincode-catalog" class="block text-[11px] font-semibold text-white/60 uppercase tracking-wider mb-2">
            Check Express Delivery Date &amp; COD Availability:
          </label>
          <div class="flex gap-2">
            <input 
              type="text" 
              id="pincode-catalog" 
              maxlength="6" 
              placeholder="Enter 6-Digit Indian PIN code" 
              class="flex-1 bg-black border border-[#2a2a2a] rounded-lg px-3 py-2 text-xs text-white placeholder:text-white/30 focus:outline-none focus:border-white transition">
            <button 
              type="button" 
              onclick="checkPincodeDelivery('pincode-catalog', 'pincode-catalog-res')" 
              class="bg-[#1c1c1c] hover:bg-white hover:text-black border border-[#333] text-white font-medium text-xs px-4 py-2 rounded-lg transition">
              Check PIN
            </button>
          </div>
          <div id="pincode-catalog-res" class="mt-2.5 text-xs hidden"></div>
        </div>

        <!-- Quantity & Special Bundle Offers -->
        <div class="space-y-3.5 pt-2">
          
          <div class="flex items-center justify-between text-xs">
            <span class="text-white/80 font-bold uppercase tracking-wider text-[11px]">Choose Your Value Bundle:</span>
            <span class="text-emerald-400 font-semibold text-[11px]">Free Air Delivery</span>
          </div>

          <!-- 3-Tier Multi-Pack Selection Cards -->
          <div class="space-y-2.5">
            {% if product.handle contains 'puri' %}
              <!-- Puri Maker: Tier 1 (1 pc @ ₹599) -->
              <div id="detail-tier-1" onclick="selectDetailTier(1, 599)" class="bundle-tier-card p-3 rounded-xl flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <input type="radio" name="detail-bundle-tier" id="detail-radio-1" class="accent-amber w-4 h-4">
                  <div>
                    <div class="font-bold text-white text-xs">Buy 1 Piece (Standard)</div>
                    <div class="text-[10px] text-white/50">Personal kitchen use</div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-white text-sm">₹599</div>
                  <div class="text-[10px] text-white/40">Free Express Delivery</div>
                </div>
              </div>

              <!-- Puri Maker: Tier 2 (2 pcs @ ₹999) - PRESELECTED & HIGHLIGHTED -->
              <div id="detail-tier-2" onclick="selectDetailTier(2, 999)" class="bundle-tier-card is-selected p-3 rounded-xl flex items-center justify-between relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-gradient-to-r from-amber to-amber-lit text-black font-extrabold text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-bl-lg shadow">
                  🔥 Most Bought • Best Value
                </div>
                <div class="flex items-center gap-3 mt-1">
                  <input type="radio" name="detail-bundle-tier" id="detail-radio-2" checked class="accent-amber w-4 h-4">
                  <div>
                    <div class="font-bold text-white text-xs flex items-center gap-1.5">
                      <span>Buy 2 Pieces</span>
                      <span class="text-[10px] text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-800/60 px-1.5 py-0.2 rounded">Save Extra ₹199</span>
                    </div>
                    <div class="text-[10px] text-amber mt-0.5 font-medium">Recommended for Home &amp; Gifting</div>
                  </div>
                </div>
                <div class="text-right mt-1">
                  <div class="font-bold text-amber text-base">₹999</div>
                  <div class="text-[10px] text-white/40 line-through">₹1,198</div>
                </div>
              </div>

              <!-- Puri Maker: Tier 3 (3 pcs @ ₹1,399) -->
              <div id="detail-tier-3" onclick="selectDetailTier(3, 1399)" class="bundle-tier-card p-3 rounded-xl flex items-center justify-between relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-[#252525] border-b border-l border-[#3a3a3a] text-emerald-400 font-bold text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-bl-lg">
                  Max Savings
                </div>
                <div class="flex items-center gap-3 mt-1">
                  <input type="radio" name="detail-bundle-tier" id="detail-radio-3" class="accent-amber w-4 h-4">
                  <div>
                    <div class="font-bold text-white text-xs flex items-center gap-1.5">
                      <span>Buy 3 Pieces</span>
                      <span class="text-[10px] text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-800/60 px-1.5 py-0.2 rounded">Save Extra ₹398</span>
                    </div>
                    <div class="text-[10px] text-white/50 mt-0.5">Joint Family &amp; Festival Prep</div>
                  </div>
                </div>
                <div class="text-right mt-1">
                  <div class="font-bold text-white text-sm">₹1,399</div>
                  <div class="text-[10px] text-white/40 line-through">₹1,797</div>
                </div>
              </div>

            {% else %}
              <!-- Jaap Counter: Tier 1 (1 pc @ ₹499) -->
              <div id="detail-tier-1" onclick="selectDetailTier(1, 499)" class="bundle-tier-card p-3 rounded-xl flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <input type="radio" name="detail-bundle-tier" id="detail-radio-1" class="accent-amber w-4 h-4">
                  <div>
                    <div class="font-bold text-white text-xs">Buy 1 Piece (Standard)</div>
                    <div class="text-[10px] text-white/50">Personal mantra jaap practice</div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-white text-sm">₹499</div>
                  <div class="text-[10px] text-white/40">Free Express Delivery</div>
                </div>
              </div>

              <!-- Jaap Counter: Tier 2 (2 pcs @ ₹899) - PRESELECTED & HIGHLIGHTED -->
              <div id="detail-tier-2" onclick="selectDetailTier(2, 899)" class="bundle-tier-card is-selected p-3 rounded-xl flex items-center justify-between relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-gradient-to-r from-amber to-amber-lit text-black font-extrabold text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-bl-lg shadow">
                  🔥 Most Bought • Best Value
                </div>
                <div class="flex items-center gap-3 mt-1">
                  <input type="radio" name="detail-bundle-tier" id="detail-radio-2" checked class="accent-amber w-4 h-4">
                  <div>
                    <div class="font-bold text-white text-xs flex items-center gap-1.5">
                      <span>Buy 2 Pieces</span>
                      <span class="text-[10px] text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-800/60 px-1.5 py-0.2 rounded">Save Extra ₹99</span>
                    </div>
                    <div class="text-[10px] text-amber mt-0.5 font-medium">For You &amp; Devotional Gifting</div>
                  </div>
                </div>
                <div class="text-right mt-1">
                  <div class="font-bold text-amber text-base">₹899</div>
                  <div class="text-[10px] text-white/40 line-through">₹998</div>
                </div>
              </div>

              <!-- Jaap Counter: Tier 3 (3 pcs @ ₹1,199) -->
              <div id="detail-tier-3" onclick="selectDetailTier(3, 1199)" class="bundle-tier-card p-3 rounded-xl flex items-center justify-between relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-[#252525] border-b border-l border-[#3a3a3a] text-emerald-400 font-bold text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-bl-lg">
                  Max Savings
                </div>
                <div class="flex items-center gap-3 mt-1">
                  <input type="radio" name="detail-bundle-tier" id="detail-radio-3" class="accent-amber w-4 h-4">
                  <div>
                    <div class="font-bold text-white text-xs flex items-center gap-1.5">
                      <span>Buy 3 Pieces</span>
                      <span class="text-[10px] text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-800/60 px-1.5 py-0.2 rounded">Save Extra ₹298</span>
                    </div>
                    <div class="text-[10px] text-white/50 mt-0.5">Family &amp; Temple Sacred Set</div>
                  </div>
                </div>
                <div class="text-right mt-1">
                  <div class="font-bold text-white text-sm">₹1,199</div>
                  <div class="text-[10px] text-white/40 line-through">₹1,497</div>
                </div>
              </div>
            {% endif %}
          </div>

          <!-- PRIMARY ACTION 1: Buy Now Cash on Delivery (Flashing Diwali Glow CTA) -->
          <button 
            type="button" 
            onclick="triggerCatalogBuyNow('{{ current_title }}', activeDetailPrice, '{{ main_img }}', '{{ product.handle }}')"
            class="w-full btn-diwali-glow font-bold text-sm py-4 px-6 rounded-xl transition duration-200 shadow-2xl flex items-center justify-center gap-2 cursor-pointer">
            <span>⚡ BUY NOW — CASH ON DELIVERY (₹<span id="buy-now-price-display">{% if product.handle contains 'puri' %}999{% else %}899{% endif %}</span>)</span>
          </button>

          <!-- SECONDARY ACTION 2: Add to Basket -->
          <button 
            type="button" 
            onclick="addCatalogToBasket('{{ product.id | default: 'catalog-item' }}', '{{ current_title }}', {{ current_price_num }})"
            class="w-full bg-[#161616] hover:bg-[#202020] border border-[#2e2e2e] text-white font-medium text-xs py-3.5 px-6 rounded-xl transition flex items-center justify-center gap-2">
            <span>🛒 Add to Cart</span>
          </button>

          <p class="text-[11px] text-center text-white/40">
            🔒 256-Bit SSL Secured • Zero Advance Payment Required for COD
          </p>
        </div>

        <!-- Trust Badges 4-Grid -->
        <div class="grid grid-cols-2 gap-3 pt-4 border-t border-[#222] text-xs">
          <div class="bg-[#0f0f0f] p-3 rounded-xl border border-[#222] flex items-center gap-2.5">
            <span class="text-white text-base">🚚</span>
            <div>
              <div class="font-semibold text-white text-[11px]">Free Shipping</div>
              <div class="text-[10px] text-white/50">Pan-India express delivery</div>
            </div>
          </div>
          <div class="bg-[#0f0f0f] p-3 rounded-xl border border-[#222] flex items-center gap-2.5">
            <span class="text-white text-base">💵</span>
            <div>
              <div class="font-semibold text-white text-[11px]">Cash on Delivery</div>
              <div class="text-[10px] text-white/50">Pay at your doorstep</div>
            </div>
          </div>
          <div class="bg-[#0f0f0f] p-3 rounded-xl border border-[#222] flex items-center gap-2.5">
            <span class="text-white text-base">🔄</span>
            <div>
              <div class="font-semibold text-white text-[11px]">7 Days Return</div>
              <div class="text-[10px] text-white/50">Hassle-free replacement</div>
            </div>
          </div>
          <div class="bg-[#0f0f0f] p-3 rounded-xl border border-[#222] flex items-center gap-2.5">
            <span class="text-white text-base">🛡️</span>
            <div>
              <div class="font-semibold text-white text-[11px]">Zenkart Certified</div>
              <div class="text-[10px] text-white/50">100% Quality checked</div>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- TABS SECTION -->
    <div class="border-t border-[#222] pt-12">
      <!-- Tabs Navigation -->
      <div class="flex items-center gap-4 sm:gap-8 border-b border-[#222] overflow-x-auto pb-4 mb-8">
        <button 
          type="button" 
          onclick="switchCatalogTab('tab-overview', this)" 
          class="catalog-tab-btn text-sm font-semibold text-white border-b-2 border-white pb-2 transition whitespace-nowrap">
          Detailed Description &amp; Features
        </button>
        <button 
          type="button" 
          onclick="switchCatalogTab('tab-specs', this)" 
          class="catalog-tab-btn text-sm font-semibold text-white/50 hover:text-white border-b-2 border-transparent pb-2 transition whitespace-nowrap">
          Technical Specifications
        </button>
        <button 
          type="button" 
          onclick="switchCatalogTab('tab-reviews', this)" 
          class="catalog-tab-btn text-sm font-semibold text-white/50 hover:text-white border-b-2 border-transparent pb-2 transition whitespace-nowrap">
          Verified Reviews ({{ review_count }})
        </button>
        <button 
          type="button" 
          onclick="switchCatalogTab('tab-shipping', this)" 
          class="catalog-tab-btn text-sm font-semibold text-white/50 hover:text-white border-b-2 border-transparent pb-2 transition whitespace-nowrap">
          Zenkart Shipping &amp; Delivery Policy
        </button>
      </div>

      <!-- TAB 1: Product Overview -->
      <div id="tab-overview" class="catalog-tab-content space-y-10">
        
        {% if is_puri %}
          <div class="max-w-4xl mx-auto space-y-6 text-sm text-white/70 leading-relaxed">
            <h3 class="text-2xl font-serif font-bold text-white">
              Heavy Duty Food-Grade Stainless Steel Manual Press Machine
            </h3>
            <p>
