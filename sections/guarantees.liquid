<section class="py-16 px-6 border-b border-border-dim bg-ink-card/50">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <span class="eyebrow block mb-2">Service Standards</span>
      <h2 class="text-2xl sm:text-3xl font-serif font-bold text-bone">Our Customer Commitments</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="p-4 border border-border-dim rounded-lg bg-ink">
        <h3 class="text-sm font-bold text-bone mb-1">Free Tracked Express Delivery</h3>
        <p class="text-xs text-bone-muted">Dispatched within 24 hours. Full SMS tracking to all Indian pincodes.</p>
      </div>

      <div class="p-4 border border-border-dim rounded-lg bg-ink">
        <h3 class="text-sm font-bold text-bone mb-1">Cash on Delivery Available</h3>
        <p class="text-xs text-bone-muted">Pay upon delivery at your door, or use UPI and cards at checkout.</p>
      </div>

      <div class="p-4 border border-border-dim rounded-lg bg-ink">
        <h3 class="text-sm font-bold text-bone mb-1">7-Day Direct Replacement</h3>
        <p class="text-xs text-bone-muted">If anything arrives damaged or not working, we replace it immediately.</p>
      </div>

      <div class="p-4 border border-border-dim rounded-lg bg-ink">
        <h3 class="text-sm font-bold text-bone mb-1">100% Quality Inspected</h3>
        <p class="text-xs text-bone-muted">Every piece is individually tested and securely bubble-packed before dispatch.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantees",
  "settings": []
}
{% endschema %}
