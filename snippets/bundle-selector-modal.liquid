<!-- snippets/bundle-selector-modal.liquid -->
<style>
  @keyframes diwaliPulse {
    0%, 100% {
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.45), 0 0 25px rgba(217, 119, 6, 0.2), 0 4px 12px rgba(0, 0, 0, 0.7);
      border-color: rgba(251, 191, 36, 0.6);
    }
    50% {
      box-shadow: 0 0 28px rgba(245, 158, 11, 0.9), 0 0 50px rgba(251, 191, 36, 0.5), 0 6px 20px rgba(0, 0, 0, 0.9);
      border-color: rgba(254, 243, 199, 1);
    }
  }

  .btn-diwali-glow {
    position: relative !important;
    background: #ffffff !important;
    color: #000000 !important;
    border: 2px solid rgba(251, 191, 36, 0.7) !important;
    animation: diwaliPulse 1.8s ease-in-out infinite !important;
    transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  }
  .btn-diwali-glow:hover {
    transform: scale(1.02) !important;
  }

  .bundle-tier-card {
    cursor: pointer;
    border: 1px solid #2a2a2a;
    background: #141414;
    transition: all 0.2s ease;
  }
  .bundle-tier-card:hover {
    border-color: #444;
    background: #191919;
  }
  .bundle-tier-card.is-selected {
    border-color: #f59e0b !important;
    background: rgba(245, 158, 11, 0.08) !important;
    box-shadow: 0 0 18px rgba(245, 158, 11, 0.25) !important;
  }
</style>

<!-- Bundle Selector Modal Overlay -->
<div id="bundle-modal-overlay" class="fixed inset-0 z-[999999] bg-black/85 backdrop-blur-md hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
  <div id="bundle-modal-card" class="bg-[#0f0f0f] border border-[#2a2a2a] rounded-2xl w-full max-w-md overflow-hidden shadow-2xl scale-95 transition-transform duration-300 flex flex-col text-[#f5f5f5] max-h-[92vh]">
    
    <!-- Modal Header -->
    <div class="p-4 sm:p-5 border-b border-[#222] flex items-center justify-between bg-black">
      <div class="flex items-center gap-2.5">
        <span class="text-amber-400 text-lg">🎁</span>
        <div>
          <div class="text-[10px] font-bold uppercase tracking-wider text-amber-400">Exclusive Best Offers</div>
          <h3 id="modal-product-title" class="font-serif font-bold text-white text-base">Select Your Value Bundle</h3>
        </div>
      </div>
      <button type="button" onclick="closeBundleModal()" class="text-white/60 hover:text-white text-xl p-1.5 transition leading-none">✕</button>
    </div>

    <!-- Product Switcher Tabs (For Banner clicks or direct comparison) -->
    <div class="bg-[#141414] p-2 border-b border-[#222] flex gap-1.5">
      <button 
        type="button" 
        id="modal-tab-jaap" 
        onclick="switchModalProduct('wooden-digital-tasbih-counter-handheld-lcd-mantra-jaap-counter-with-compass-1-pc')"
        class="flex-1 py-2 px-2.5 text-center text-xs font-semibold rounded-lg transition-all border border-amber-400/80 bg-amber-400/10 text-white">
        🕉️ Jaap Counter
      </button>
      <button 
        type="button" 
        id="modal-tab-puri" 
        onclick="switchModalProduct('7149a-puri-press-maker-stainless-steel-puri-maker-press-machine-roti-chapati-presser-for-home-papad-khakhra-puri-maker-press-machine-with-handle-manual-puri-maker-medium')"
        class="flex-1 py-2 px-2.5 text-center text-xs font-medium rounded-lg transition-all border border-transparent text-white/50 hover:text-white">
        🥟 Puri Press Maker
      </button>
    </div>

    <!-- Modal Body: Tiers -->
    <div class="p-4 sm:p-5 overflow-y-auto space-y-3.5 flex-1 text-xs">
      
      <!-- Tier 1: 1 Pc (Flat ₹50 OFF) -->
      <div id="modal-tier-1" onclick="selectModalTier(1)" class="bundle-tier-card p-3.5 rounded-xl flex items-center justify-between">
        <div class="flex items-center gap-3">
          <input type="radio" name="modal-bundle-opt" id="modal-radio-1" class="accent-amber-400 w-4 h-4 cursor-pointer">
          <div>
            <div class="font-bold text-white text-xs flex items-center gap-1.5">
              <span>Buy 1 Piece</span>
              <span class="text-[9px] text-amber-400 font-bold bg-amber-400/10 border border-amber-400/30 px-1.5 py-0.2 rounded">💥 ₹50 OFF</span>
            </div>
            <div class="text-[10px] text-white/50 mt-0.5">Regular single unit order</div>
          </div>
        </div>
        <div class="text-right">
          <div id="modal-price-1" class="font-bold text-white text-sm">₹449</div>
          <div id="modal-retail-1" class="text-[10px] text-white/40 line-through">₹499</div>
        </div>
      </div>

      <!-- Tier 2: 2 Pcs (Pre-selected & Highlighted as Most Popular / Best Value) -->
      <div id="modal-tier-2" onclick="selectModalTier(2)" class="bundle-tier-card is-selected p-3.5 rounded-xl flex items-center justify-between relative overflow-hidden">
        <div class="absolute top-0 right-0 bg-gradient-to-r from-amber-400 to-amber-500 text-black font-extrabold text-[9px] uppercase tracking-wider px-2.5 py-0.5 rounded-bl-lg shadow">
          🔥 Most Bought • Best Value
        </div>
        <div class="flex items-center gap-3 mt-1">
          <input type="radio" name="modal-bundle-opt" id="modal-radio-2" checked class="accent-amber-400 w-4 h-4 cursor-pointer">
          <div>
            <div class="font-bold text-white text-xs flex items-center gap-1.5">
              <span>Buy 2 Pieces</span>
              <span id="modal-save-badge-2" class="text-[10px] text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-800/60 px-1.5 py-0.5 rounded">Save Extra ₹99</span>
            </div>
            <div class="text-[10px] text-amber-300 mt-0.5 font-medium">Recommended for Family &amp; Gifting</div>
          </div>
        </div>
        <div class="text-right mt-1">
          <div id="modal-price-2" class="font-bold text-amber-400 text-base">₹899</div>
          <div id="modal-retail-2" class="text-[10px] text-white/40 line-through">₹998</div>
        </div>
      </div>

      <!-- Tier 3: 3 Pcs (Max Savings) -->
      <div id="modal-tier-3" onclick="selectModalTier(3)" class="bundle-tier-card p-3.5 rounded-xl flex items-center justify-between relative overflow-hidden">
        <div class="absolute top-0 right-0 bg-[#252525] border-b border-l border-[#3a3a3a] text-emerald-400 font-bold text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-bl-lg">
          Max Savings
        </div>
        <div class="flex items-center gap-3 mt-1">
          <input type="radio" name="modal-bundle-opt" id="modal-radio-3" class="accent-amber-400 w-4 h-4 cursor-pointer">
          <div>
            <div class="font-bold text-white text-xs flex items-center gap-1.5">
              <span>Buy 3 Pieces</span>
              <span id="modal-save-badge-3" class="text-[10px] text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-800/60 px-1.5 py-0.5 rounded">Save Extra ₹298</span>
            </div>
            <div class="text-[10px] text-white/50 mt-0.5">Household &amp; Temple Sacred Set</div>
          </div>
        </div>
        <div class="text-right mt-1">
          <div id="modal-price-3" class="font-bold text-white text-sm">₹1,199</div>
          <div id="modal-retail-3" class="text-[10px] text-white/40 line-through">₹1,497</div>
        </div>
      </div>

    </div>

    <!-- Modal Footer with Diwali Glowing CTA -->
    <div class="p-4 sm:p-5 border-t border-[#222] bg-black flex flex-col gap-3">
      <div class="flex items-center justify-between text-xs px-1">
        <span class="text-white/60">Selected Deal:</span>
        <span id="modal-summary-text" class="font-bold text-white">2 Pieces (₹899 Total)</span>
      </div>

      <button 
        type="button" 
        id="modal-confirm-buy-btn"
        onclick="confirmBundleCheckout()"
        class="w-full btn-diwali-glow font-bold text-xs sm:text-sm py-4 px-6 rounded-xl flex items-center justify-center gap-2 shadow-2xl cursor-pointer">
        <span class="text-base">⚡</span>
        <span id="modal-btn-label">Confirm Order with Cash on Delivery (₹899)</span>
      </button>

      <p class="text-[10px] text-center text-white/40">
        🛡️ 100% Free Express Shipping • Cash on Delivery &amp; UPI at Doorstep
      </p>
    </div>

  </div>
</div>

<script>
  (function(){
    let currentModalHandle = 'wooden-digital-tasbih-counter-handheld-lcd-mantra-jaap-counter-with-compass-1-pc';
    let currentModalQty = 2; // Default to Most Bought (2 Pcs)

    const PRODUCT_BUNDLES = {
      'wooden-digital-tasbih-counter-handheld-lcd-mantra-jaap-counter-with-compass-1-pc': {
        name: 'Wooden Digital Jaap Counter',
        tier1: { price: 449, retail: 499, save: 50 },
        tier2: { price: 899, retail: 998, save: 99 },
        tier3: { price: 1199, retail: 1497, save: 298 }
      },
      '7149a-puri-press-maker-stainless-steel-puri-maker-press-machine-roti-chapati-presser-for-home-papad-khakhra-puri-maker-press-machine-with-handle-manual-puri-maker-medium': {
        name: 'Stainless Steel Puri Press Maker',
        tier1: { price: 549, retail: 599, save: 50 },
        tier2: { price: 999, retail: 1198, save: 199 },
        tier3: { price: 1399, retail: 1797, save: 398 }
      }
    };

    window.switchModalProduct = function(handle) {
      currentModalHandle = handle;
      const isJaap = handle.indexOf('puri') === -1 && handle.indexOf('roti') === -1;
      const tabJaap = document.getElementById('modal-tab-jaap');
      const tabPuri = document.getElementById('modal-tab-puri');
      
      if (tabJaap && tabPuri) {
        if (isJaap) {
          tabJaap.className = 'flex-1 py-2 px-2.5 text-center text-xs font-semibold rounded-lg transition-all border border-amber-400/80 bg-amber-400/10 text-white';
          tabPuri.className = 'flex-1 py-2 px-2.5 text-center text-xs font-medium rounded-lg transition-all border border-transparent text-white/50 hover:text-white';
        } else {
          tabPuri.className = 'flex-1 py-2 px-2.5 text-center text-xs font-semibold rounded-lg transition-all border border-amber-400/80 bg-amber-400/10 text-white';
          tabJaap.className = 'flex-1 py-2 px-2.5 text-center text-xs font-medium rounded-lg transition-all border border-transparent text-white/50 hover:text-white';
        }
      }

      const data = PRODUCT_BUNDLES[handle] || (isJaap ? PRODUCT_BUNDLES['wooden-digital-tasbih-counter-handheld-lcd-mantra-jaap-counter-with-compass-1-pc'] : PRODUCT_BUNDLES['7149a-puri-press-maker-stainless-steel-puri-maker-press-machine-roti-chapati-presser-for-home-papad-khakhra-puri-maker-press-machine-with-handle-manual-puri-maker-medium']);

      const titleEl = document.getElementById('modal-product-title');
      if (titleEl) titleEl.textContent = data.name;

      // Populate Tier 1
      document.getElementById('modal-price-1').textContent = '₹' + data.tier1.price;
      const retail1 = document.getElementById('modal-retail-1');
      if (retail1) retail1.textContent = '₹' + data.tier1.retail;

      // Populate Tier 2 (Most Bought)
      document.getElementById('modal-price-2').textContent = '₹' + data.tier2.price;
      document.getElementById('modal-retail-2').textContent = '₹' + data.tier2.retail;
      document.getElementById('modal-save-badge-2').textContent = 'Save Extra ₹' + data.tier2.save;

      // Populate Tier 3
      document.getElementById('modal-price-3').textContent = '₹' + data.tier3.price;
      document.getElementById('modal-retail-3').textContent = '₹' + data.tier3.retail;
      document.getElementById('modal-save-badge-3').textContent = 'Save Extra ₹' + data.tier3.save;

      // Keep current quantity or default to Tier 2
      selectModalTier(currentModalQty || 2);
    };

    window.openBundleSelectorModal = function(handle) {
      if (!handle) {
        handle = 'wooden-digital-tasbih-counter-handheld-lcd-mantra-jaap-counter-with-compass-1-pc';
      }
      switchModalProduct(handle);

      const overlay = document.getElementById('bundle-modal-overlay');
      const card = document.getElementById('bundle-modal-card');
      if (overlay && card) {
        overlay.classList.remove('hidden');
        setTimeout(() => {
          overlay.classList.remove('opacity-0');
          card.classList.remove('scale-95');
          card.classList.add('scale-100');
        }, 10);
      }
    };

    window.closeBundleModal = function() {
      const overlay = document.getElementById('bundle-modal-overlay');
      const card = document.getElementById('bundle-modal-card');
      if (overlay && card) {
        card.classList.remove('scale-100');
        card.classList.add('scale-95');
        overlay.classList.add('opacity-0');
        setTimeout(() => {
          overlay.classList.add('hidden');
        }, 250);
      }
    };

    window.selectModalTier = function(tierNum) {
      currentModalQty = tierNum;
      const data = PRODUCT_BUNDLES[currentModalHandle] || PRODUCT_BUNDLES['wooden-digital-tasbih-counter-handheld-lcd-mantra-jaap-counter-with-compass-1-pc'];
      const tierData = data['tier' + tierNum];

      // Update active classes
      for(let i = 1; i <= 3; i++) {
        const card = document.getElementById('modal-tier-' + i);
        const radio = document.getElementById('modal-radio-' + i);
        if (card && radio) {
          if (i === tierNum) {
            card.classList.add('is-selected');
            radio.checked = true;
          } else {
            card.classList.remove('is-selected');
            radio.checked = false;
          }
        }
      }

      // Update CTA
      const summaryText = document.getElementById('modal-summary-text');
      const btnLabel = document.getElementById('modal-btn-label');
      if (summaryText) summaryText.textContent = `${tierNum} Piece${tierNum > 1 ? 's' : ''} (₹${tierData.price} Total)`;
      if (btnLabel) btnLabel.textContent = `Confirm Order with Cash on Delivery (₹${tierData.price})`;
    };

    window.confirmBundleCheckout = function() {
      const btn = document.getElementById('modal-confirm-buy-btn');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span>⚡ Opening Secure Checkout...</span>';
      }

      if (window.ZenkartCart && window.ZenkartCart.buyNow) {
        window.ZenkartCart.buyNow(currentModalHandle, currentModalQty);
      } else {
        window.location.href = '/checkout';
      }
    };
  })();
</script>
