      // 10. CASH ON DELIVERY (COD) & PAYMENT
      if (hasAny('cod', 'cash on delivery', 'pay on delivery', 'advance', 'payment', 'upi', 'gpay', 'paytm', 'card', 'how to pay')) {
        CONTEXT.lastTopic = 'cod';
        return {
