<header class="sticky top-0 z-40 bg-ink/90 backdrop-blur-md border-b border-border-dim px-6 py-4">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <a href="/" class="text-2xl font-serif font-bold tracking-[0.25em] text-bone hover:text-amber transition">
      ZENKART
    </a>

    <nav class="hidden lg:flex items-center gap-8 text-xs font-semibold uppercase tracking-widest text-bone-muted">
      <a href="#puri-press" class="hover:text-amber transition">Puri Press</a>
      <a href="#jaap-counter" class="hover:text-amber transition">Jaap Counter</a>
      <a href="#demonstration" class="hover:text-amber transition">Demonstration</a>
      <a href="#features" class="hover:text-amber transition">Features</a>
      <a href="#reviews" class="hover:text-amber transition">Customer Reviews</a>
    </nav>

    <div class="flex items-center gap-4">
      <a href="#puri-press" class="hidden sm:inline-block border border-border-dim hover:border-amber text-xs font-semibold px-4 py-2 rounded-full uppercase tracking-wider transition">
        View Catalog
      </a>
      <button id="cart-toggle-btn" class="flex items-center gap-2 bg-ink-card border border-border-dim px-4 py-2 rounded-full text-xs font-semibold hover:border-amber transition">
        <span>Cart</span>
        <span id="cart-count-badge" class="bg-amber text-black px-1.5 py-0.5 rounded-full text-[10px] font-bold">
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
