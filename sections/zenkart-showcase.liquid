<style>
  .zk-showcase-container {
    max-width: 1240px;
    margin: 3.5rem auto;
    padding: 0 1.25rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .zk-product-slide {
    display: none;
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 16px 36px -12px rgba(15, 23, 42, 0.08);
    overflow: hidden;
    animation: zkFadeIn 0.5s ease-out;
  }
  .zk-product-slide.active {
    display: block;
  }
  @keyframes zkFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .zk-slide-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding: 3rem;
    align-items: center;
  }
  @media (max-width: 860px) {
    .zk-slide-grid {
      grid-template-columns: 1fr;
      padding: 1.5rem;
      gap: 2rem;
    }
  }
  .zk-media-box {
    position: relative;
    background: #F8FAFC;
    border-radius: 16px;
    padding: 1.5rem;
    text-align: center;
    border: 1px solid #EEF2F6;
  }
  .zk-flag-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: #EF4444;
    color: #FFF;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .zk-badge-gold {
    background: #D97706;
  }
  .zk-img-primary {
    max-width: 100%;
    height: 380px;
    object-fit: contain;
    transition: transform 0.4s ease;
  }
  .zk-media-box:hover .zk-img-primary {
    transform: scale(1.04);
  }
  .zk-thumb-row {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .zk-mini-thumb {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #E2E8F0;
    background: #FFF;
  }
  .zk-kicker {
    font-size: 0.825rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6366F1;
  }
  .zk-heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: #0F172A;
    margin: 0.5rem 0 1rem;
  }
  .zk-price-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .zk-current-price {
    font-size: 1.85rem;
    font-weight: 800;
    color: #0F172A;
  }
  .zk-old-price {
    font-size: 1.15rem;
    color: #94A3B8;
    text-decoration: line-through;
  }
  .zk-discount-pill {
    background: #DCFCE7;
    color: #15803D;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
  }
  .zk-lead-copy {
    color: #475569;
    font-size: 0.975rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .zk-feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    color: #334155;
    font-size: 0.925rem;
  }
  .zk-feature-list li {
    padding: 0.35rem 0;
    display: flex;
    align-items: center;
  }
  .zk-feature-list li::before {
    content: "✓";
    color: #10B981;
    font-weight: 900;
    margin-right: 0.6rem;
  }
  .zk-buy-btn {
    display: inline-block;
    background: linear-gradient(135deg, #4F46E5 0%, #4338CA 100%);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 1rem;
    padding: 14px 28px;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(79, 70, 229, 0.35);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .zk-buy-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(79, 70, 229, 0.45);
  }
  .zk-btn-emerald {
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    box-shadow: 0 6px 20px rgba(5, 150, 105, 0.35);
  }
  .zk-btn-emerald:hover {
    box-shadow: 0 10px 24px rgba(5, 150, 105, 0.45);
  }
  .zk-slide-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .zk-arrow {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid #CBD5E1;
    background: #FFF;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .zk-arrow:hover {
    background: #0F172A;
    color: #FFF;
  }
  .zk-dots {
    display: flex;
    gap: 8px;
  }
  .zk-dot-indicator {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: #CBD5E1;
    cursor: pointer;
    transition: all 0.3s;
  }
  .zk-dot-indicator.active {
    width: 32px;
    background: #4F46E5;
  }
</style>

<script>
  let zkIndex = 0;
  const zkTotal = 2;

  function zkRender(n) {
    document.querySelectorAll('.zk-product-slide').forEach((s, i) => {
      s.classList.toggle('active', i === n);
    });
    document.querySelectorAll('.zk-dot-indicator').forEach((d, i) => {
      d.classList.toggle('active', i === n);
    });
    zkIndex = n;
  }

  function zkNext() { zkRender((zkIndex + 1) % zkTotal); }
  function zkPrev() { zkRender((zkIndex - 1 + zkTotal) % zkTotal); }
  function zkJump(n) { zkRender(n); }
</script>

