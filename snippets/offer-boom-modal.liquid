  </div>
</div>

<!-- Floating Re-Trigger Pill (Always accessible on bottom-left) -->
<button 
  id="boom-floating-trigger" 
  type="button" 
  onclick="openBoomOfferModal(true)" 
  aria-label="View ₹50 OFF Boom Offers">
  <span class="animate-bounce">💥</span>
  <span>Flat ₹50 OFF Offer</span>
  <span class="bg-amber-400 text-black text-[10px] px-1.5 py-0.2 rounded font-extrabold ml-0.5">ACTIVE</span>
</button>

<script>
  (function(){
    // Sound synth for celebratory subtle boom pop (silent if blocked by autoplay)
    function playSubtleBoomSound() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();
        if (ctx.state === 'suspended') {
          // Autoplay policy: do not force
          return;
        }
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(140, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(40, ctx.currentTime + 0.35);
        gain.gain.setValueAtTime(0.2, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.35);
      } catch(e){}
    }

    // Spawn explosive particles & shockwaves
    function spawnBoomParticles() {
      const layer = document.getElementById('boom-shockwave-layer');
      if (!layer) return;
      layer.innerHTML = '';

      // 3 expanding concentric shockwave rings
      for (let i = 0; i < 3; i++) {
        const ring = document.createElement('div');
        ring.className = 'boom-shockwave-ring';
        layer.appendChild(ring);
      }

      // 16 radial spark particles
      const colors = ['#f59e0b', '#fbbf24', '#ef4444', '#ffffff', '#10b981'];
      for (let i = 0; i < 16; i++) {
        const p = document.createElement('div');
        p.className = 'boom-particle';
        const angle = (i / 16) * 2 * Math.PI;
        const dist = 140 + Math.random() * 120;
        const tx = Math.cos(angle) * dist + 'px';
        const ty = Math.sin(angle) * dist + 'px';
        p.style.setProperty('--tx', tx);
        p.style.setProperty('--ty', ty);
        p.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
        p.style.animationDelay = (Math.random() * 0.1) + 's';
        layer.appendChild(p);
      }
    }

    // Open BOOM Modal
    window.openBoomOfferModal = function(forceSound = false) {
      const overlay = document.getElementById('boom-modal-overlay');
      const card = document.getElementById('boom-modal-card');
      if (!overlay || !card) return;

      spawnBoomParticles();
      if (forceSound) playSubtleBoomSound();

      overlay.classList.remove('hidden');
      setTimeout(() => {
        overlay.classList.remove('opacity-0');
        card.classList.remove('scale-90');
        card.classList.add('scale-100', 'boom-card-anim');
      }, 20);
    };

    // Close BOOM Modal
    window.closeBoomOfferModal = function() {
      const overlay = document.getElementById('boom-modal-overlay');
      const card = document.getElementById('boom-modal-card');
      if (!overlay || !card) return;

      card.classList.remove('scale-100', 'boom-card-anim');
      card.classList.add('scale-90');
      overlay.classList.add('opacity-0');
      setTimeout(() => {
        overlay.classList.add('hidden');
      }, 300);
    };

    // 1-Click Buy from Boom Modal
    window.triggerBoomBuy = function(handle, qty) {
      closeBoomOfferModal();
      if (typeof window.openBundleSelectorModal === 'function') {
        window.openBundleSelectorModal(handle);
      } else if (window.ZenkartCart && window.ZenkartCart.buyNow) {
        window.ZenkartCart.buyNow(handle, qty || 1);
      }
    };

    // Open Combo Bundle Modal from Boom Modal
    window.triggerBoomBundle = function(handle) {
      closeBoomOfferModal();
      if (typeof window.openBundleSelectorModal === 'function') {
        window.openBundleSelectorModal(handle);
      } else {
        const catalog = document.getElementById('featured-catalog') || document.getElementById('best-offers-banner');
        if (catalog) catalog.scrollIntoView({ behavior: 'smooth' });
      }
    };

    // Close on backdrop click
    document.getElementById('boom-modal-overlay')?.addEventListener('click', function(e) {
      if (e.target.id === 'boom-modal-overlay') {
        closeBoomOfferModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeBoomOfferModal();
    });

    // Automatically trigger BOOM animation when store is opened!
    window.addEventListener('DOMContentLoaded', function() {
      // Small 450ms delay for crisp first paint, then BOOM!
      setTimeout(() => {
        openBoomOfferModal(false);
      }, 450);
    });
  })();
</script>
