<script>
  function switchImage(targetId, thumbEl) {
    document.getElementById(targetId).src = thumbEl.src;
    const parent = thumbEl.parentElement;
    parent.querySelectorAll('.zk-thumb-btn').forEach(b => b.classList.remove('active'));
    thumbEl.classList.add('active');
  }
</script>

